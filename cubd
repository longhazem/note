-- ============================================================
--  FLY BYPASS (BodyVelocity — không jump CFrame)
-- ============================================================

local flyObjects = {}
local flyConn

local function destroyFlyObjects()
    for _, obj in pairs(flyObjects) do
        if obj and obj.Parent then obj:Destroy() end
    end
    flyObjects = {}
end

local function createFlyObjects(root)
    destroyFlyObjects()
    local bv     = Instance.new("BodyVelocity")
    bv.Velocity  = Vector3.zero
    bv.MaxForce  = Vector3.new(1e5, 1e5, 1e5)
    bv.P         = 9000
    bv.Parent    = root
    local bg     = Instance.new("BodyGyro")
    bg.MaxTorque = Vector3.new(1e5, 1e5, 1e5)
    bg.P         = 1e5
    bg.D         = 500
    bg.CFrame    = root.CFrame
    bg.Parent    = root
    flyObjects.bv = bv
    flyObjects.bg = bg
end

local function enableFly()
    local root = getRoot()
    local hum  = getHum()
    if not root or not hum then return end
    hum.PlatformStand = true
    createFlyObjects(root)
    flyConn = RunService.RenderStepped:Connect(function(dt)
        local r  = getRoot()
        local bv = flyObjects.bv
        local bg = flyObjects.bg
        if not r or not bv or not bg then return end
        local camCF  = camera.CFrame
        local fwd    = camCF.LookVector
        local rgt    = camCF.RightVector
        local up     = Vector3.new(0, 1, 0)
        local dir    = Vector3.zero
        if UserInputService:IsKeyDown(Enum.KeyCode.W)          then dir += fwd end
        if UserInputService:IsKeyDown(Enum.KeyCode.S)          then dir -= fwd end
        if UserInputService:IsKeyDown(Enum.KeyCode.A)          then dir -= rgt end
        if UserInputService:IsKeyDown(Enum.KeyCode.D)          then dir += rgt end
        if UserInputService:IsKeyDown(Enum.KeyCode.Space)      then dir += up  end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift)  then dir -= up  end
        local targetVel = dir.Magnitude > 0.01
            and dir.Unit * State.flySpeed
            or  bv.Velocity * 0.85
        bv.Velocity = bv.Velocity:Lerp(targetVel, math.min(1, 180 * dt / State.flySpeed))
        bg.CFrame   = CFrame.new(r.Position, r.Position + camCF.LookVector)
    end)
end

local function disableFly()
    if flyConn then flyConn:Disconnect(); flyConn = nil end
    destroyFlyObjects()
    local hum  = getHum()
    local root = getRoot()
    if hum  then hum.PlatformStand = false end
    if root then root.Velocity = Vector3.zero end
end

-- ============================================================
--  NOCLIP BYPASS (CollisionGroup swap — engine-level)
-- ============================================================

local NOCLIP_GROUP  = "MTC_NC_" .. HttpService:GenerateGUID(false):sub(1, 6)
local noclipConn

local function ensureNoclipGroup()
    pcall(function()
        PhysicsService:RegisterCollisionGroup(NOCLIP_GROUP)
        PhysicsService:CollisionGroupSetCollidable(NOCLIP_GROUP, NOCLIP_GROUP, false)
        PhysicsService:CollisionGroupSetCollidable(NOCLIP_GROUP, "Default", false)
    end)
end

local function applyNoclipGroup(char)
    ensureNoclipGroup()
    for _, p in ipairs(char:GetDescendants()) do
        if p:IsA("BasePart") then p.CollisionGroup = NOCLIP_GROUP end
    end
end

local function removeNoclipGroup(char)
    for _, p in ipairs(char:GetDescendants()) do
        if p:IsA("BasePart") then p.CollisionGroup = "Default" end
    end
end

local function enableNoclip()
    local char = getChar()
    if not char then return end
    applyNoclipGroup(char)
    noclipConn = char.DescendantAdded:Connect(function(d)
        if d:IsA("BasePart") then d.CollisionGroup = NOCLIP_GROUP end
    end)
end

local function disableNoclip()
    if noclipConn then noclipConn:Disconnect(); noclipConn = nil end
    local char = getChar()
    if char then removeNoclipGroup(char) end
end

-- ============================================================
--  HITBOX EXPANDER
-- ============================================================

local expandedHitboxes = {}

local function getTargets()
    local t = {}
    for _, pl in ipairs(Players:GetPlayers()) do
        if pl ~= lp and pl.Character then table.insert(t, pl.Character) end
    end
    for _, folder in ipairs({"Entities","TemporaryEntities","HardStructures"}) do
        local f = workspace:FindFirstChild(folder)
        if f then
            for _, e in ipairs(f:GetDescendants()) do
                if e:IsA("Model") and e:FindFirstChildOfClass("Humanoid") then
                    table.insert(t, e)
                end
            end
        end
    end
    return t
end

local hitboxConn

local function enableHitbox()
    hitboxConn = RunService.Heartbeat:Connect(function()
        for _, char in ipairs(getTargets()) do
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if hrp and not expandedHitboxes[hrp] then
                expandedHitboxes[hrp] = hrp.Size
                hrp.Size = State.hitboxSize
                hrp.LocalTransparencyModifier = 1
            end
        end
        for hrp in pairs(expandedHitboxes) do
            if not hrp or not hrp.Parent then
                expandedHitboxes[hrp] = nil
            end
        end
    end)
end

local function disableHitbox()
    if hitboxConn then hitboxConn:Disconnect(); hitboxConn = nil end
    for hrp, orig in pairs(expandedHitboxes) do
        if hrp and hrp.Parent then hrp.Size = orig end
    end
    expandedHitboxes = {}
end

-- ============================================================
--  RESPAWN HANDLER
-- ============================================================

lp.CharacterAdded:Connect(function(char)
    char:WaitForChild("HumanoidRootPart", 10)
    char:WaitForChild("Humanoid", 10)
    task.wait(0.5)
    if State.fly    then enableFly()    end
    if State.noclip then enableNoclip() end
end)

