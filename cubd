-- ============================================================
--  HOOK LAYER
--  __newindex: chặn forced CFrame/Position/CanCollide/PlatformStand
--  __namecall: chặn :MoveTo() :TeleportToPos() từ game scripts
-- ============================================================

local hookNewindex
local hookNamecall

-- Track CFrame chúng ta đang set để không tự block mình
local ourCFrameSets = {}

local function isOurCode()
    -- Executor closures không có debug.info level thấp
    -- Game scripts thì có — đây là cách phân biệt
    local info = debug.info(3, "s")
    return info == nil or info == "[C]"
end

local function setupHooks()
    if State.hookActive then return end

    -- ── __newindex hook ──────────────────────────────────────
    hookNewindex = hookmetamethod(game, "__newindex", newcclosure(function(self, key, value)

        local char = getChar()
        local root = getRoot()
        local hum  = getHum()

        -- 1. Block forced CFrame/Position/Velocity set trên HRP
        --    khi fly active — đây là BanishmentTP rubber-band
        if State.fly and root and self == root then
            if key == "CFrame" or key == "Position" then
                -- Chỉ cho qua nếu là code của chúng ta (executor)
                if not ourCFrameSets[self] then
                    return  -- drop, không gọi original
                end
            end
        end

        -- 2. Block CanCollide = true trên character parts khi noclip
        --    EntityCollisionHandler cố reset về true mỗi frame
        if State.noclip and key == "CanCollide" and value == true then
            if char and self:IsDescendantOf(char) then
                return  -- drop
            end
        end

        -- 3. Block PlatformStand = true từ game scripts
        --    CharacterClient dùng cái này để ragdoll/kill
        if hum and self == hum and key == "PlatformStand" and value == true then
            if not isOurCode() then
                return  -- drop
            end
        end

        -- 4. Block WalkSpeed/JumpPower bị reset về default bởi AC
        if hum and self == hum then
            if key == "WalkSpeed" and value == 16 and not isOurCode() then
                return  -- drop nếu game cố reset
            end
        end

        return hookNewindex(self, key, value)
    end))

    -- ── __namecall hook ──────────────────────────────────────
    hookNamecall = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
        local method = getnamecallmethod()
        local char   = getChar()
        local root   = getRoot()
        local hum    = getHum()

        -- 5. Block :MoveTo() từ game scripts trên character
        --    BanishmentStatic dùng MoveTo hoặc CFrame set để rubber-band
        if State.fly and method == "MoveTo" then
            if char and self:IsDescendantOf(char) then
                if not isOurCode() then return end
            end
        end

        -- 6. Block :ChangeState() calls từ game — giữ Physics state
        if State.fly and hum and self == hum and method == "ChangeState" then
            local args = {...}
            local targetState = args[1]
            -- Allow: Physics (3), FallingDown (5) — chúng ta set cái này
            -- Block: GettingUp (4), Running (8), Landed (14) nếu từ game
            if targetState ~= Enum.HumanoidStateType.Physics then
                if not isOurCode() then
                    return  -- giữ nguyên Physics state
                end
            end
        end

        -- 7. Block :FireServer() trên BanishmentTP events
        --    Nếu game client cố report position về server
        if method == "FireServer" and not isOurCode() then
            local name = pcall(function() return self.Name end) and self.Name or ""
            if name:find("Banish") or name:find("Position") or name:find("AC") then
                return  -- drop server report
            end
        end

        return hookNamecall(self, ...)
    end))

    State.hookActive = true
    print("[MTC] Hooks installed — __newindex + __namecall active")
end

local function removeHooks()
    -- Hooks không uninstall được cleanly — disable bằng cách reset state
    -- Actual hook removal cần executor support (replaceclosure với original)
    if hookNewindex then
        pcall(function()
            hookmetamethod(game, "__newindex", hookNewindex)  -- restore original
        end)
    end
    if hookNamecall then
        pcall(function()
            hookmetamethod(game, "__namecall", hookNamecall)  -- restore original
        end)
    end
    State.hookActive = false
    print("[MTC] Hooks removed")
end

-- ============================================================
--  BANISHMENTTP CONNECTION KILLER
--  Tìm tất cả RemoteEvent/BindableEvent trong BanishmentTP folder
--  Disconnect connections không phải của executor
-- ============================================================

local killedConnections = {}

local function killBanishmentConnections()
    local bt = game:GetService("ReplicatedStorage"):FindFirstChild("BanishmentTP")
    if not bt then
        warn("[MTC] BanishmentTP folder not found")
        return
    end

    local function killEvent(event)
        -- getconnections = executor API (Synapse X / KRNL / Fluxus)
        local ok, conns = pcall(getconnections, event)
        if not ok or not conns then return end
        for _, conn in ipairs(conns) do
            local isExec = pcall(isexecutorclosure, conn.Function)
                and isexecutorclosure(conn.Function)
            if not isExec then
                pcall(function() conn:Disable() end)
                table.insert(killedConnections, conn)
                print("[MTC] Killed BanishmentTP connection:", event.Name)
            end
        end
    end

    -- Scan tất cả descendants
    for _, obj in ipairs(bt:GetDescendants()) do
        if obj:IsA("RemoteEvent") or obj:IsA("BindableEvent") then
            killEvent(obj)
        end
    end

    -- BanishmentStatic có thể là ModuleScript được require bởi CharacterClient
    -- Cũng kill events trong ReplicatedStorage/Events/FireEvent
    local fireEvent = game:GetService("ReplicatedStorage")
        :FindFirstChild("Events")
        and game:GetService("ReplicatedStorage").Events:FindFirstChild("FireEvent")
    if fireEvent then
        for _, obj in ipairs(fireEvent:GetDescendants()) do
            if obj:IsA("RemoteEvent") or obj:IsA("BindableEvent") then
                killEvent(obj)
            end
        end
    end
end

local function restoreBanishmentConnections()
    for _, conn in ipairs(killedConnections) do
        pcall(function() conn:Enable() end)
    end
    killedConnections = {}
end

-- ============================================================
--  FLY v3 — Hook-backed
--  __newindex block kết hợp với BodyVelocity
--  CFrame sets của chúng ta đi qua ourCFrameSets flag
-- ============================================================

local flyObjects = {}
local flyConn

local function destroyFlyObjects()
    for _, obj in pairs(flyObjects) do
        pcall(function() if obj and obj.Parent then obj:Destroy() end end)
    end
    flyObjects = {}
end

local function setCFrameSafe(root, cf)
    -- Flag để hook biết đây là set của chúng ta
    ourCFrameSets[root] = true
    root.CFrame = cf
    ourCFrameSets[root] = nil
end

local function createFlyObjects(root)
    destroyFlyObjects()
    local bv     = Instance.new("BodyVelocity")
    bv.Velocity  = Vector3.zero
    bv.MaxForce  = Vector3.new(1e5, 1e5, 1e5)
    bv.P         = 9000
    bv.Parent    = root
    local bg     = Instance.new("BodyGyro")
    bg.MaxTorque = Vector3.new(1e5, 1e5, 1e5)
    bg.P         = 1e5
    bg.D         = 500
    bg.CFrame    = root.CFrame
    bg.Parent    = root
    flyObjects.bv = bv
    flyObjects.bg = bg
end

local function enableFly()
    local root = getRoot()
    local hum  = getHum()
    if not root or not hum then return end
    hum:ChangeState(Enum.HumanoidStateType.Physics)
    createFlyObjects(root)
    flyConn = RunService.RenderStepped:Connect(function(dt)
        local r  = getRoot()
        local bv = flyObjects.bv
        local bg = flyObjects.bg
        if not r or not bv or not bg then return end
        local h = getHum()
        if h and h:GetState() ~= Enum.HumanoidStateType.Physics then
            h:ChangeState(Enum.HumanoidStateType.Physics)
        end
        local camCF = camera.CFrame
        local fwd   = camCF.LookVector
        local rgt   = camCF.RightVector
        local up    = Vector3.new(0, 1, 0)
        local dir   = Vector3.zero
        if UserInputService:IsKeyDown(Enum.KeyCode.W)         then dir += fwd end
        if UserInputService:IsKeyDown(Enum.KeyCode.S)         then dir -= fwd end
        if UserInputService:IsKeyDown(Enum.KeyCode.A)         then dir -= rgt end
        if UserInputService:IsKeyDown(Enum.KeyCode.D)         then dir += rgt end
        if UserInputService:IsKeyDown(Enum.KeyCode.Space)     then dir += up  end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then dir -= up  end
        local targetVel = dir.Magnitude > 0.01
            and dir.Unit * State.flySpeed
            or  bv.Velocity * 0.82
        bv.Velocity = bv.Velocity:Lerp(
            targetVel,
            math.min(1, 160 * dt / math.max(State.flySpeed, 1))
        )
        bg.CFrame = CFrame.new(r.Position, r.Position + camCF.LookVector)
    end)
end

local function disableFly()
    if flyConn then flyConn:Disconnect(); flyConn = nil end
    destroyFlyObjects()
    local hum  = getHum()
    local root = getRoot()
    if hum  then hum:ChangeState(Enum.HumanoidStateType.GettingUp) end
    if root then root.Velocity = Vector3.zero end
end

-- ============================================================
--  NOCLIP v3 — Hook-backed
--  __newindex block CanCollide = true từ game scripts
--  Heartbeat loop là backup nếu hook miss
-- ============================================================

local noclipConn
local noclipAddedConn

local function enableNoclip()
    local char = getChar()
    if not char then return end
    for _, p in ipairs(char:GetDescendants()) do
        if p:IsA("BasePart") then p.CanCollide = false end
    end
    -- Backup heartbeat — hook lẽ ra đã chặn hết rồi
    -- Giữ lại phòng khi hook miss một số edge case
    noclipConn = RunService.Heartbeat:Connect(function()
        local c = getChar()
        if not c then return end
        for _, p in ipairs(c:GetDescendants()) do
            if p:IsA("BasePart") and p.CanCollide then
                p.CanCollide = false
            end
        end
    end)
    noclipAddedConn = char.DescendantAdded:Connect(function(d)
        if d:IsA("BasePart") then d.CanCollide = false end
    end)
end

local function disableNoclip()
    if noclipConn      then noclipConn:Disconnect();      noclipConn      = nil end
    if noclipAddedConn then noclipAddedConn:Disconnect(); noclipAddedConn = nil end
    local char = getChar()
    if not char then return end
    for _, p in ipairs(char:GetDescendants()) do
        if p:IsA("BasePart") then p.CanCollide = true end
    end
end

-- ============================================================
--  HITBOX EXPANDER v3
-- ============================================================

local expandedHitboxes = {}
local hitboxConn

local function getTargets()
    local t = {}
    for _, pl in ipairs(Players:GetPlayers()) do
        if pl ~= lp and pl.Character then table.insert(t, pl.Character) end
    end
    for _, folder in ipairs({"Entities","TemporaryEntities","HardStructures"}) do
        local f = workspace:FindFirstChild(folder)
        if f then
            for _, e in ipairs(f:GetDescendants()) do
                if e:IsA("Model") and e:FindFirstChildOfClass("Humanoid") then
                    table.insert(t, e)
                end
            end
        end
    end
    return t
end

local function expandHitbox(char)
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp or expandedHitboxes[hrp] then return end
    expandedHitboxes[hrp] = {
        size     = hrp.Size,
        color    = hrp.BrickColor,
        material = hrp.Material,
        transpar = hrp.Transparency,
    }
    hrp.Size = State.hitboxSize
    if State.hitboxDebug then
        hrp.BrickColor   = BrickColor.new("Bright red")
        hrp.Material     = Enum.Material.Neon
        hrp.Transparency = 0.5
    else
        hrp.Transparency = 1
    end
end

local function restoreHitbox(hrp)
    local d = expandedHitboxes[hrp]
    if not d then return end
    if hrp and hrp.Parent then
        hrp.Size         = d.size
        hrp.BrickColor   = d.color
        hrp.Material     = d.material
        hrp.Transparency = d.transpar
    end
    expandedHitboxes[hrp] = nil
end

local function enableHitbox()
    hitboxConn = RunService.Heartbeat:Connect(function()
        for _, char in ipairs(getTargets()) do expandHitbox(char) end
        for hrp in pairs(expandedHitboxes) do
            if not hrp or not hrp.Parent then expandedHitboxes[hrp] = nil end
        end
    end)
end

local function disableHitbox()
    if hitboxConn then hitboxConn:Disconnect(); hitboxConn = nil end
    for hrp in pairs(expandedHitboxes) do restoreHitbox(hrp) end
    expandedHitboxes = {}
end

-- ============================================================
--  RESPAWN
-- ============================================================

lp.CharacterAdded:Connect(function(char)
    char:WaitForChild("HumanoidRootPart", 10)
    char:WaitForChild("Humanoid", 10)
    task.wait(0.6)
    if State.fly    then enableFly()    end
    if State.noclip then enableNoclip() end
    -- Re-kill BanishmentTP connections trên character mới
    if State.hookActive then
        task.wait(1)
        killBanishmentConnections()
    end
end)

