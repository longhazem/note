local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local CoreGui = game:GetService("CoreGui")
local Workspace = game:GetService("Workspace")

local ESPFolder = CoreGui:FindFirstChild("ESPHolder")
if ESPFolder then 
    ESPFolder:Destroy() 
end

ESPFolder = Instance.new("Folder")
ESPFolder.Name = "ESPHolder"
ESPFolder.Parent = CoreGui

local function ApplyHighlight(target, color)
    if not target or not target:IsA("Model") then return end
    
    local highlight = ESPFolder:FindFirstChild(target.Name .. "_" .. tostring(target:GetDebugId()))
    
    if not highlight then
        highlight = Instance.new("Highlight")
        highlight.Name = target.Name .. "_" .. tostring(target:GetDebugId())
        highlight.Parent = ESPFolder
        highlight.Adornee = target
        highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        highlight.FillTransparency = 0.5
        highlight.OutlineTransparency = 0
    end
    
    highlight.FillColor = color
    highlight.OutlineColor = color
end

local function UpdateESP()
    for _, player in pairs(Players:GetPlayers()) do
        if player.Character then
            ApplyHighlight(player.Character, Color3.fromRGB(0, 0, 255))
        end
    end

    for _, obj in pairs(Workspace:GetDescendants()) do
        if obj:IsA("Model") and obj.Name == "Insurgent" then
            if not Players:GetPlayerFromCharacter(obj) then
                ApplyHighlight(obj, Color3.fromRGB(255, 0, 0))
            end
        end
    end
    
    for _, highlight in pairs(ESPFolder:GetChildren()) do
        if highlight:IsA("Highlight") and (not highlight.Adornee or not highlight.Adornee.Parent) then
            highlight:Destroy()
        end
    end
end

RunService.RenderStepped:Connect(UpdateESP)
