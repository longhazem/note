local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local CoreGui = game:GetService("CoreGui")
local Workspace = game:GetService("Workspace")
local Camera = Workspace.CurrentCamera

local localPlayer = Players.LocalPlayer
local character = localPlayer.Character or localPlayer.CharacterAdded:Wait()

-- 1. KHỞI TẠO THƯ MỤC ESP
local ESPFolder = CoreGui:FindFirstChild("ESPHolder")
if ESPFolder then ESPFolder:Destroy() end
ESPFolder = Instance.new("Folder")
ESPFolder.Name = "ESPHolder"
ESPFolder.Parent = CoreGui

local function ApplyHighlight(target, color)
    if not target or not target:IsA("Model") then return end
    local highlight = ESPFolder:FindFirstChild(target.Name .. "_" .. tostring(target:GetDebugId()))
    if not highlight then
        highlight = Instance.new("Highlight")
        highlight.Name = target.Name .. "_" .. tostring(target:GetDebugId())
        highlight.Parent = ESPFolder
        highlight.Adornee = target
        highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        highlight.FillTransparency = 0.5
        highlight.OutlineTransparency = 0
    end
    highlight.FillColor = color
    highlight.OutlineColor = color
end

-- 2. VÒNG TRÒN FOV 60 CHO AIMBOT
local fovCircle = Drawing.new("Circle")
fovCircle.Visible = true
fovCircle.Thickness = 1.5
fovCircle.Color = Color3.fromRGB(255, 255, 255)
fovCircle.Filled = false
fovCircle.Radius = 60

-- 3. HÀM TÌM NPC GẦN NHẤT
local function getTargetNPC()
    local closest = nil
    local maxDistance = math.huge
    local char = localPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return nil end
    local pRoot = char.HumanoidRootPart

    for _, obj in pairs(Workspace:GetDescendants()) do
        if obj:IsA("Model") and obj.Name == "Insurgent" then
            local tRoot = obj:FindFirstChild("HumanoidRootPart")
            local tHumanoid = obj:FindFirstChildOfClass("Humanoid")
            if tRoot and tHumanoid and tHumanoid.Health > 0 then
                local distance = (pRoot.Position - tRoot.Position).Magnitude
                if distance < maxDistance then
                    maxDistance = distance
                    closest = obj
                end
            end
        end
    end
    return closest
end

-- 4. PHÓNG TO HITBOX ĐẦU NPC
local function ExpandHitbox()
    for _, obj in pairs(Workspace:GetDescendants()) do
        if obj:IsA("Model") and obj.Name == "Insurgent" then
            local head = obj:FindFirstChild("Head")
            local humanoid = obj:FindFirstChildOfClass("Humanoid")
            if head and humanoid and humanoid.Health > 0 then
                head.Size = Vector3.new(8, 8, 8)
                head.Transparency = 0.6
                head.CanCollide = false
                if not head.Massless then head.Massless = true end
            end
        end
    end
end

-- 5. VÒNG LẶP RENDER STEPPED (ESP & AIMBOT)
RunService.RenderStepped:Connect(function()
    for _, p in pairs(Players:GetPlayers()) do
        if p.Character then ApplyHighlight(p.Character, Color3.fromRGB(0, 0, 255)) end
    end
    for _, obj in pairs(Workspace:GetDescendants()) do
        if obj:IsA("Model") and obj.Name == "Insurgent" and not Players:GetPlayerFromCharacter(obj) then
            ApplyHighlight(obj, Color3.fromRGB(255, 0, 0))
        end
    end
    for _, hl in pairs(ESPFolder:GetChildren()) do
        if hl:IsA("Highlight") and (not hl.Adornee or not hl.Adornee.Parent) then hl:Destroy() end
    end

    local viewportSize = Camera.ViewportSize
    fovCircle.Position = Vector2.new(viewportSize.X / 2, viewportSize.Y / 2)
    local target = getTargetNPC()
    if target then
        local aimPart = target:FindFirstChild("Head") or target:FindFirstChild("HumanoidRootPart")
        if aimPart then
            local screenPoint, onScreen = Camera:WorldToViewportPoint(aimPart.Position)
            if onScreen and (Vector2.new(screenPoint.X, screenPoint.Y) - fovCircle.Position).Magnitude <= fovCircle.Radius then
                Camera.CFrame = CFrame.new(Camera.CFrame.Position, aimPart.Position)
                fovCircle.Color = Color3.fromRGB(255, 0, 0)
            end
        end
    else
        fovCircle.Color = Color3.fromRGB(255, 255, 255)
    end
end)

-- 6. KHU VỰC CẤP CAO: TELEPORT + SPIN + PRONE + KILL AURA DIỆN RỘNG
local spinAngle = 0
local AURA_RANGE = 20 -- Bán kính vòng quét sát thương Kill Aura

RunService.Heartbeat:Connect(function()
    local char = localPlayer.Character
    if not char then return end
    local pRoot = char:FindFirstChild("HumanoidRootPart")
    local pHumanoid = char:FindFirstChildOfClass("Humanoid")
    if not pRoot or not pHumanoid or pHumanoid.Health <= 0 then return end

    -- Tự động kiểm tra và trang bị vũ khí cận chiến
    local backpack = localPlayer:FindFirstChild("Backpack")
    if backpack then
        local tool = backpack:FindFirstChildOfClass("Tool")
        if tool then pHumanoid:EquipTool(tool) end
    end

    local currentTool = char:FindFirstChildOfClass("Tool")
    
    -- TÍNH NĂNG KILL AURA: Quét và gây sát thương diện rộng lên toàn bộ NPC trong tầm
    for _, obj in pairs(Workspace:GetDescendants()) do
        if obj:IsA("Model") and obj.Name == "Insurgent" then
            local npcRoot = obj:FindFirstChild("HumanoidRootPart")
            local npcHumanoid = obj:FindFirstChildOfClass("Humanoid")
            
            if npcRoot and npcHumanoid and npcHumanoid.Health > 0 then
                local distance = (pRoot.Position - npcRoot.Position).Magnitude
                -- Nếu NPC nằm trong vùng Aura, kích hoạt đòn đánh liên tục
                if distance <= AURA_RANGE and currentTool then
                    currentTool:Activate()
                end
            end
        end
    end

    -- ĐIỀU KHIỂN CHUYỂN ĐỘNG AUTO FARM (TELEPORT + SPIN BOT + NẰM)
    local targetNPC = getTargetNPC()
    if targetNPC then
        local npcRoot = targetNPC:FindFirstChild("HumanoidRootPart")
        if npcRoot then
            spinAngle = (spinAngle + 45) % 360
            -- Dịch chuyển lên đầu NPC, xoay vòng tròn góc nằm ngang để tránh đạn
            pRoot.CFrame = CFrame.new(npcRoot.Position + Vector3.new(0, 1.5, 0)) 
                           * CFrame.Angles(math.rad(-90), math.rad(spinAngle), 0)
            pRoot.Velocity = Vector3.new(0, 0, 0)
        end
    end
end)

-- Vòng lặp quét làm to Hitbox liên tục
task.spawn(function()
    while task.wait(0.3) do
        ExpandHitbox()
    end
end)
