local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local localPlayer = Players.LocalPlayer

-- ĐƯỜNG DẪN REMOTE (Nếu vẫn không chạy, hãy kiểm tra F9 xem có báo "nil" không)
local remoteEvent = ReplicatedStorage:FindFirstChild("RemoteEvent")

-- HÀM EQUIP BẰNG CÁCH GỬI REMOTE NHƯ BẠN CUNG CẤP
local function EquipWeapon()
    local args = { { { "\n", "Knife_Equip", {speed = 1.5, priority = Enum.AnimationPriority.Action2}, "Equip", true } } }
    pcall(function() remoteEvent:FireServer(unpack(args)) end)
end

-- HÀM TẤN CÔNG (GỘP CẢ 2 REMOTE ĐỂ ĐẢM BẢO HIT)
local function AttackNPC(targetPart)
    -- Remote 1: Gây sát thương
    local args1 = { { { " ", targetPart, {Time = 0.23, CFrame = targetPart.CFrame, Debug = true, Size = Vector3.new(1.5, 1.5, 2.5) } }, { " ", Instance.new("Part"), {Time = 0.23, CFrame = targetPart.CFrame, Debug = true, Size = Vector3.new(1.5, 1.5, 2.5) } } } }
    -- Remote 2: Animation chém
    local args2 = { { {"\v", "Knife_Slice1"}, {"\n", "Knife_Slice2", {priority = Enum.AnimationPriority.Action2, looped = false}}, {"\023", "Move1", false}, {"\023", "Swing", false} } }
    
    pcall(function() 
        remoteEvent:FireServer(unpack(args1)) 
        remoteEvent:FireServer(unpack(args2))
    end)
end

RunService.Heartbeat:Connect(function()
    local char = localPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    
    -- 1. Equip liên tục để đảm bảo server xác nhận
    if math.random(1, 20) == 1 then EquipWeapon() end
    
    -- 2. Quét NPC
    for _, obj in pairs(Workspace:GetDescendants()) do
        if obj:IsA("Model") and string.find(obj.Name, "Insurgent") then
            local root = obj:FindFirstChild("HumanoidRootPart")
            local head = obj:FindFirstChild("Head")
            if root and head and obj:FindFirstChild("Humanoid") and obj.Humanoid.Health > 0 then
                local dist = (char.HumanoidRootPart.Position - root.Position).Magnitude
                
                -- Teleport phía sau lưng
                if dist < 30 then
                    char.HumanoidRootPart.CFrame = root.CFrame * CFrame.new(0, 0, 4)
                    -- Spam chém
                    AttackNPC(head)
                end
            end
        end
    end
end)
