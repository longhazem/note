local function RequireModule(name)
    for _, instance in ipairs(getmodules()) do
        if instance.Name == name then
            return require(instance)
        end
    end
end

local function HookFunction(moduleName, funcName, hook)
    local module = nil
    while task.wait() do
        module = RequireModule(moduleName)
        if module and module[funcName] then
            local old = module[funcName]
            module[funcName] = function(...)
                return hook(old, ...)
            end
            break
        end
    end
end

local function HookSignal(signal, index, hook)
    local conn = getconnections(signal)[index]
    if not conn then return end
    local old = conn.Function
    if not old then return end
    conn:Disable()
    signal:Connect(function(...)
        return hook(old, ...)
    end)
end

local WallCheckParams = RaycastParams.new()
WallCheckParams.FilterType = Enum.RaycastFilterType.Blacklist
WallCheckParams.IgnoreWater = true

local function Raycast(origin, direction, filter)
    WallCheckParams.FilterDescendantsInstances = filter
    return Workspace:Raycast(origin, direction, WallCheckParams)
end

local function GetTeam(player)
    for _, teamData in pairs(RoundInterface.Teams) do
        for userId, _ in pairs(teamData.Players) do
            if tonumber(userId) == player.UserId then
                return teamData
            end
        end
    end
end

local function InEnemyTeam(enabled, player)
    if not enabled then return true end
    return not player.Neutral and LocalPlayer.Team ~= player.Team
end

local function IsDistanceLimited(enabled, distance, limit)
    if not enabled then return false end
    return distance >= limit
end

local function IsVisible(enabled, origin, position, character)
    if not enabled then return true end
    return not Raycast(origin, position - origin, {character, RaycastFolder, LocalPlayer.Character})
end

local function SolveTrajectory(origin, velocity, time, gravity)
    return origin + velocity * time + gravity * time * time / GravityCorrection
end

local function GetClosest(enabled, teamCheck, visCheck, distCheck, distLimit, fov, priority, bodyParts, prediction, npcMode)
    if not enabled then return end
    local camPos = Camera.CFrame.Position
    local closest = nil
    local closestDist = math.huge
    
    for _, actor in pairs(Actors) do
        local player = actor.Player
        if player == LocalPlayer then continue end
        
        local char = actor.Character
        local humanoid = actor.Humanoid
        local rootPart = actor.RootPart
        
        if humanoid.Health <= 0 then continue end
        
        if npcMode then
            if actor._isPlayer then continue end
            local rootRig = rootPart:FindFirstChild("RootRigAttachment")
            if not rootRig then continue end
            if not rootPart:FindFirstChild("AlignOrientation") then continue end
            if rootRig:FindFirstChildOfClass("ProximityPrompt") then continue end
        else
            if not actor._isPlayer then continue end
            if not InEnemyTeam(teamCheck, player) then continue end
        end
        
        -- Xác định body parts cần check
        local partsToCheck = {}
        if priority == "Closest" then
            for _, partName in ipairs(bodyParts) do
                local part = char:FindFirstChild(partName)
                if part then table.insert(partsToCheck, part) end
            end
        else
            local part = char:FindFirstChild(priority)
            if part then table.insert(partsToCheck, part) end
        end
        
        if #partsToCheck == 0 then continue end
        
        for _, part in ipairs(partsToCheck) do
            local pos = part.Position
            local dist = (pos - camPos).Magnitude
            if IsDistanceLimited(distCheck, dist, distLimit) then continue end
            if not IsVisible(visCheck, camPos, pos, char) then continue end
            
            if prediction then
                pos = SolveTrajectory(pos, part.AssemblyLinearVelocity, dist / ProjectileSpeed, ProjectileGravity)
            end
            
            local screenPos, onScreen = Camera:WorldToViewportPoint(pos)
            if not onScreen then continue end
            
            local mousePos = UserInputService:GetMouseLocation()
            local mag = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
            if mag >= fov then continue end
            
            if mag < closestDist then
                closestDist = mag
                closest = {player, char, part, screenPos}
            end
        end
    end
    
    return closest
end

local function AimAt(hitbox, sensitivity)
    if not hitbox then return end
    local mousePos = UserInputService:GetMouseLocation()
    mousemoverel(
        (hitbox[4].X - mousePos.X) * sensitivity,
        (hitbox[4].Y - mousePos.Y) * sensitivity
    )
end

