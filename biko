-- === HÀM XỬ LÝ CHÍNH ===
local WallCheckParams = RaycastParams.new()
WallCheckParams.FilterType = Enum.RaycastFilterType.Blacklist
WallCheckParams.IgnoreWater = true

local function Raycast(origin, direction, filter)
    WallCheckParams.FilterDescendantsInstances = filter
    return Workspace:Raycast(origin, direction, WallCheckParams)
end

local function GetTeam(player)
    if not RoundInterface or not RoundInterface.Teams then return nil end
    for _, teamData in pairs(RoundInterface.Teams) do
        for userId, _ in pairs(teamData.Players) do
            if tonumber(userId) == player.UserId then
                return teamData
            end
        end
    end
    return nil
end

local function IsEnemy(actor, teamCheck)
    if not actor or not actor.Player then return false end
    if actor.Player == LocalPlayer then return false end
    if not teamCheck then return true end
    if actor.Player.Neutral then return true end -- NPC mặc định là enemy
    local localTeam = LocalPlayer.Team
    local targetTeam = actor.Player.Team
    if localTeam and targetTeam then
        return localTeam ~= targetTeam
    end
    -- Fallback dùng squad
    return true
end

local function GetClosestTarget(cfg)
    if not Actors then return nil end
    local camPos = Camera.CFrame.Position
    local mousePos = UserInputService:GetMouseLocation()
    local bestTarget = nil
    local bestScore = math.huge

    for _, actor in pairs(Actors) do
        if actor.Player == LocalPlayer then continue end
        if not actor.Character or not actor.Humanoid or actor.Humanoid.Health <= 0 then continue end
        if not IsEnemy(actor, cfg.TeamCheck) then continue end

        local root = actor.Character:FindFirstChild("HumanoidRootPart") or actor.Character:FindFirstChild("UpperTorso")
        if not root then continue end

        local pos = root.Position
        local dist = (pos - camPos).Magnitude
        if cfg.DistCheck and dist > cfg.DistLimit then continue end
        if cfg.VisCheck and Raycast(camPos, pos - camPos, {actor.Character, LocalPlayer.Character, RaycastFolder}) then continue end

        -- Prediction
        if cfg.Prediction then
            local vel = root.AssemblyLinearVelocity
            local time = dist / ProjectileSpeed
            pos = pos + vel * time + Vector3.new(0, -Workspace.Gravity * time * time / GravityCorrection, 0)
        end

        local screenPos, onScreen = Camera:WorldToViewportPoint(pos)
        if not onScreen then continue end

        local mag = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
        if mag > cfg.FOV then continue end

        -- Ưu tiên: Closest (theo khoảng cách màn hình) hoặc theo body part cụ thể
        local score = mag
        if cfg.Priority ~= "Closest" and cfg.Priority ~= "Random" then
            local part = actor.Character:FindFirstChild(cfg.Priority)
            if part then
                local pPos = part.Position
                if cfg.Prediction then
                    local vel = part.AssemblyLinearVelocity
                    local t = (pPos - camPos).Magnitude / ProjectileSpeed
                    pPos = pPos + vel * t + Vector3.new(0, -Workspace.Gravity * t * t / GravityCorrection, 0)
                end
                local sp, on = Camera:WorldToViewportPoint(pPos)
                if on then
                    score = (Vector2.new(sp.X, sp.Y) - mousePos).Magnitude
                else
                    score = mag -- fallback
                end
            end
        elseif cfg.Priority == "Random" then
            score = math.random() * 1000 -- random ưu tiên
        end

        if score < bestScore then
            bestScore = score
            bestTarget = { actor = actor, part = root, pos = pos, screen = screenPos }
        end
    end
    return bestTarget
end

local function AimAt(target, sensitivity)
    if not target then return end
    local mousePos = UserInputService:GetMouseLocation()
    local dx = (target.screen.X - mousePos.X) * sensitivity
    local dy = (target.screen.Y - mousePos.Y) * sensitivity
    mousemoverel(dx, dy)
end

-- === VÒNG LẶP CHÍNH ===
task.spawn(function()
    while task.wait() do
        -- Aimbot
        if Settings.Aimbot.Enabled and (AimbotActive or Settings.Aimbot.Always) then
            local target = GetClosestTarget(Settings.Aimbot)
            AimAt(target, Settings.Aimbot.Sensitivity / 100)
        end

        -- Silent Aim (cập nhật target)
        if Settings.SilentAim.Enabled then
            SilentAimTarget = GetClosestTarget(Settings.SilentAim)
        end
    end
end)

-- Trigger
task.spawn(function()
    while task.wait() do
        if not (TriggerActive or Settings.Trigger.Always) then
            task.wait(0.1)
        else
            if not isrbxactive() then
                task.wait(0.1)
            else
                local target = GetClosestTarget(Settings.Trigger)
                if target then
                    task.wait(Settings.Trigger.Delay)
                    mouse1press()
                    if Settings.Trigger.HoldMouse then
                        while task.wait() do
                            local newTarget = GetClosestTarget(Settings.Trigger)
                            if not newTarget or not TriggerActive then break end
                        end
                    end
                    mouse1release()
                end
            end
        end
    end
end)

-- Hook Silent Aim vào BulletService (nếu có)
-- (giả lập bằng cách hook __namecall)
local oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
    if getnamecallmethod() == "Raycast" and SilentAimTarget then
        if math.random(100) <= Settings.SilentAim.HitChance then
            local args = {...}
            -- Tìm muzzle position từ args[1] (thường là vị trí nòng)
            if args[1] and typeof(args[1]) == "Vector3" then
                local newDir = (SilentAimTarget.pos - args[1]).Unit
                args[2] = newDir * args[2].Magnitude -- giữ nguyên độ dài
                return oldNamecall(self, unpack(args))
            end
        end
    end
    return oldNamecall(self, ...)
end)

-- === HOOK CÁC CHỨC NĂNG KHÁC (đơn giản) ===

-- Speedhack & NoClip
local noClipConn = nil
local speedConn = nil

RunService.Heartbeat:Connect(function()
    -- NoClip
    if Settings.Misc.NoClip then
        if not noClipConn then
            noClipConn = RunService.Stepped:Connect(function()
                if LocalPlayer.Character then
                    for _, part in pairs(LocalPlayer.Character:GetDescendants()) do
                        if part:IsA("BasePart") then
                            part.CanCollide = false
                        end
                    end
                end
            end)
        end
    else
        if noClipConn then
            noClipConn:Disconnect()
            noClipConn = nil
            -- Khôi phục Collide
            if LocalPlayer.Character then
                for _, part in pairs(LocalPlayer.Character:GetDescendants()) do
                    if part:IsA("BasePart") then
                        part.CanCollide = true
                    end
                end
            end
        end
    end

    -- Speedhack
    if Settings.Misc.Speedhack then
        if not speedConn then
            speedConn = RunService.Heartbeat:Connect(function()
                if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
                    local hum = LocalPlayer.Character.Humanoid
                    hum.WalkSpeed = Settings.Misc.Speed
                end
            end)
        end
    else
        if speedConn then
            speedConn:Disconnect()
            speedConn = nil
            if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
                LocalPlayer.Character.Humanoid.WalkSpeed = 16
            end
        end
    end
end)

