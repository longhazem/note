-- === HÀM HỖ TRỢ ===
local function RequireModule(name)
    for _, obj in pairs(getgc(true)) do
        if type(obj) == "table" and rawget(obj, "Name") == name and rawget(obj, "Parent") == ReplicatedStorage:FindFirstChild("Packages") then
            local success, result = pcall(require, obj)
            if success then return result end
        end
    end
    return nil
end

