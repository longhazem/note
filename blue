-- Script mở khóa POV (góc nhìn thứ 3) cho toàn bộ game, ghi đè mọi ràng buộc chế độ PvP.
-- Chạy dưới dạng LocalScript trong StarterPlayerScripts hoặc StarterCharacterScripts.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Camera = workspace.CurrentCamera

-- 1. Vô hiệu hóa cơ chế khóa góc nhìn từ các script khác (thường dùng CameraMode)
local function ForceThirdPerson()
    -- Đặt chế độ camera sang Classic (cho phép xoay tự do, góc thứ 3)
    if Camera.CameraMode ~= Enum.CameraMode.Classic then
        Camera.CameraMode = Enum.CameraMode.Classic
    end
    
    -- Ép khoảng cách camera (zoom ra) nếu bị giới hạn
    if Camera.CameraSubject and Camera.CameraSubject:IsA("Humanoid") then
        local humanoid = Camera.CameraSubject
        -- Nếu game có script tự động kéo camera vào sát (first person) khi PvP, ta ghi đè mỗi frame
        humanoid.AutoRotate = true -- giữ tự do xoay
    end
    
    -- Tắt chế độ LockFirstPerson (nếu có)
    if UserInputService.MouseBehavior ~= Enum.MouseBehavior.Default then
        UserInputService.MouseBehavior = Enum.MouseBehavior.Default
    end
    if UserInputService.MouseIconEnabled == false then
        UserInputService.MouseIconEnabled = true
    end
end

-- 2. Can thiệp vào bảng dữ liệu từ file bạn đưa (giả định là bảng GroupedColors lưu trạng thái chế độ)
-- Dựa trên cấu trúc: có cột "Active" và "AbsolutePosition", "GroupedColors"... 
-- Ta sẽ tìm và sửa giá trị khóa PvP (thường là số 1 hoặc 0) thành 0 để luôn cho phép góc thứ 3.

local function PatchDataTable()
    -- Giả sử dữ liệu file được lưu trong một biến toàn cục tên _G.PlayerData hoặc game:GetService("ReplicatedStorage")
    -- Ta dò tìm bất kỳ bảng nào có trường "GroupedColors" và "Active"
    local function ScanAndFix(tbl, path)
        if type(tbl) ~= "table" then return end
        for k, v in pairs(tbl) do
            if type(v) == "table" then
                -- Nếu tìm thấy cấu trúc giống file: có key số 0..155 và giá trị là các mảng con
                if type(k) == "number" and k >= 0 and k <= 155 and type(v) == "table" then
                    -- Trong mỗi dòng, các giá trị 0/1 tương ứng với quyền góc nhìn
                    -- Ta ép tất cả giá trị (trừ vị trí) thành 0 để mở khóa
                    for subKey, subVal in pairs(v) do
                        if subKey ~= "AbsolutePosition" and subKey ~= "AbsoluteRotation" and subKey ~= "AbsoluteSize" then
                            if type(subVal) == "number" and subVal == 1 then
                                v[subKey] = 0 -- gỡ khóa
                            end
                        end
                    end
                else
                    ScanAndFix(v, path .. "." .. tostring(k))
                end
            elseif type(v) == "number" and tostring(k):find("Active") then
                -- Nếu có key "Active" và giá trị 1, set về 0
                if v == 1 then
                    tbl[k] = 0
                end
            end
        end
    end

    -- Quét toàn bộ môi trường game để tìm dữ liệu đó
    local targets = {game, _G, shared, getfenv(0)}
    for _, env in ipairs(targets) do
        if type(env) == "table" then
            ScanAndFix(env, tostring(env))
        end
    end
    
    -- Đặc biệt kiểm tra ReplicatedStorage và PlayerData
    local replicated = game:GetService("ReplicatedStorage")
    if replicated then
        for _, child in ipairs(replicated:GetChildren()) do
            if child:IsA("Folder") or child:IsA("ModuleScript") then
                local data = child:FindFirstChild("PlayerData") or child:FindFirstChild("Config")
                if data and type(data.Value) == "table" then
                    ScanAndFix(data.Value, "ReplicatedStorage")
                end
            end
        end
    end
end

-- 3. Chặn các sự kiện thay đổi CameraMode từ server hoặc script khác
local oldSetCameraMode
if Camera.GetPropertyChangedSignal then
    Camera:GetPropertyChangedSignal("CameraMode"):Connect(function()
        if Camera.CameraMode == Enum.CameraMode.LockFirstPerson or Camera.CameraMode == Enum.CameraMode.FirstPerson then
            Camera.CameraMode = Enum.CameraMode.Classic
        end
    end)
end

-- 4. Hook vào hàm SetCameraMode của Player (nếu có)
local player = Players.LocalPlayer
if player and player.PlayerGui then
    -- Tìm các Frame/Button điều khiển PvP và vô hiệu hóa sự kiện khóa
    for _, gui in ipairs(player.PlayerGui:GetDescendants()) do
        if gui:IsA("TextButton") or gui:IsA("ImageButton") then
            if gui.Name:lower():find("pvp") or gui.Name:lower():find("lock") or gui.Name:lower():find("first") then
                -- Xóa hoặc ghi đè hàm click
                gui.MouseButton1Click:Connect(function()
                    -- Không làm gì, hoặc chuyển sang Classic
                    ForceThirdPerson()
                end)
                -- Tạm thời ẩn nút khóa nếu cần
                -- gui.Visible = false
            end
        end
    end
end

-- 5. Vô hiệu hóa kiểm tra vũ khí (nếu có script kiểm tra PvP để khóa góc nhìn)
local function DisableWeaponLock()
    local backpack = player and player.Backpack
    if backpack then
        for _, tool in ipairs(backpack:GetChildren()) do
            if tool:IsA("Tool") then
                -- Tìm script trong tool có chức năng khóa camera
                for _, script in ipairs(tool:GetDescendants()) do
                    if script:IsA("Script") or script:IsA("LocalScript") then
                        if script.Name:lower():find("camera") or script.Name:lower():find("pov") or script.Name:lower():find("aim") then
                            script.Disabled = true -- vô hiệu hóa
                        end
                    end
                end
            end
        end
    end
end

-- 6. Chạy liên tục mỗi frame để đảm bảo không bị ghi đè
RunService.Heartbeat:Connect(function()
    ForceThirdPerson()
    PatchDataTable() -- quét lại mỗi 0.5s để bắt kịp thay đổi
    DisableWeaponLock()
end)

-- 7. Xử lý khi người chơi đổi nhân vật hoặc respawn
player.CharacterAdded:Connect(function(character)
    task.wait(0.5)
    ForceThirdPerson()
    -- Tìm Humanoid và gắn sự kiện chặn
    local humanoid = character:WaitForChild("Humanoid")
    if humanoid then
        -- Một số game dùng CameraOffset để giới hạn
        humanoid:GetPropertyChangedSignal("CameraOffset"):Connect(function()
            if humanoid.CameraOffset.Z < 2 then -- nếu bị đẩy vào
                humanoid.CameraOffset = Vector3.new(0, 0, 5) -- kéo ra xa
            end
        end)
    end
end)

-- 8. Ghi đè hàm toàn cục nếu game có gọi hàm LockPOV()
if _G.LockPOV then
    local oldLock = _G.LockPOV
    _G.LockPOV = function(...)
        -- Bỏ qua lệnh khóa, chỉ trả về false
        return false
    end
end
if _G.UnlockPOV then
    _G.UnlockPOV = function(...)
        ForceThirdPerson()
        return true
    end
end

-- Khởi chạy lần đầu
ForceThirdPerson()
PatchDataTable()
DisableWeaponLock()
print("Đã mở khóa POV (góc nhìn thứ 3) thành công cho mọi chế độ, bao gồm PvP.")
