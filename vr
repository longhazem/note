--[[
  SCRIPT ROBLOX HOÀN CHỈNH - BÀN PHÍM ẢO KÉO + TOGGLE Q/E + R, +, -
  Bao gồm: GUI, LocalScript (xử lý kéo & nút), ServerScript (nhận lệnh điều khiển)
--]]

-- ========== 1. TẠO REMOTEEVENT (Đặt trong ReplicatedStorage) ==========
-- Tạo thủ công: Insert Object -> RemoteEvent -> đặt tên "InputRemote"

-- ========== 2. SCRIPT SERVER (Đặt trong ServerScriptService) ==========
local Remote = game:GetService("ReplicatedStorage"):WaitForChild("InputRemote")

Remote.OnServerEvent:Connect(function(player, action, value)
    local char = player.Character
    if not char or not char.Parent then return end
    local humanoid = char:FindFirstChild("Humanoid")
    if not humanoid then return end

    if action == "move" then
        -- value là Vector2 (x, y) chuẩn hóa từ joystick
        local direction = Vector3.new(value.X, 0, value.Y)
        if direction.Magnitude > 0.1 then
            humanoid:MoveTo(char.PrimaryPart.Position + direction.Unit * 50)
            -- Hoặc dùng MoveDirection (chỉ client nhưng server vẫn có thể set)
            -- humanoid.MoveDirection = direction.Unit  -- (chỉ đọc, không set được)
            -- Dùng cách di chuyển bằng MoveTo liên tục
        end
    elseif action == "toggle_Q" then
        -- value = true (giữ) / false (thả)
        print(player.Name .. " Q toggle: " .. tostring(value))
        -- Gắn hiệu ứng hoặc hành động giữ phím Q
    elseif action == "toggle_E" then
        print(player.Name .. " E toggle: " .. tostring(value))
    elseif action == "press_R" then
        print(player.Name .. " bấm R")
    elseif action == "press_Plus" then
        print(player.Name .. " bấm +")
    elseif action == "press_Minus" then
        print(player.Name .. " bấm -")
    end
end)

