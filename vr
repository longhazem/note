-- === JOYSTICK (nút kéo) ===
local joyBg = Instance.new("Frame")
joyBg.Size = UDim2.new(0, 140, 0, 140)
joyBg.Position = UDim2.new(0.5, -70, 0.35, 0)
joyBg.BackgroundColor3 = Color3.fromRGB(70, 70, 90)
joyBg.BorderSizePixel = 2
joyBg.BorderColor3 = Color3.new(0.7, 0.7, 0.7)
joyBg.Parent = frame
local corner1 = Instance.new("UICorner")
corner1.CornerRadius = UDim.new(1, 0)
corner1.Parent = joyBg

local thumb = Instance.new("Frame")
thumb.Size = UDim2.new(0, 35, 0, 35)
thumb.Position = UDim2.new(0.5, -17.5, 0.5, -17.5)
thumb.BackgroundColor3 = Color3.fromRGB(0, 200, 255)
thumb.BorderSizePixel = 0
thumb.Parent = joyBg
local corner2 = Instance.new("UICorner")
corner2.CornerRadius = UDim.new(1, 0)
corner2.Parent = thumb

-- Biến kéo
local dragging = false
local centerX = 0.5
local centerY = 0.5
local maxR = 0.4

local function updateMove()
    local dx = thumb.Position.X.Scale - centerX
    local dy = thumb.Position.Y.Scale - centerY
    local dist = math.sqrt(dx*dx + dy*dy)
    if dist > maxR then
        dx = dx / dist * maxR
        dy = dy / dist * maxR
        thumb.Position = UDim2.new(centerX + dx, -17.5, centerY + dy, -17.5)
    end
    -- In ra console để kiểm tra (bỏ comment nếu cần)
    -- print("Move:", dx, dy)
end

-- Sự kiện Input
local UIS = game:GetService("UserInputService")

UIS.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
    end
end)

UIS.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = false
        thumb.Position = UDim2.new(0.5, -17.5, 0.5, -17.5)
        -- Gửi lệnh dừng (nếu có Remote)
    end
end)

UIS.InputChanged:Connect(function(input)
    if not dragging then return end
    if input.UserInputType ~= Enum.UserInputType.MouseMovement then return end
    local absPos = input.Position
    local baseAbs = joyBg.AbsolutePosition
    local baseSize = joyBg.AbsoluteSize
    local relX = (absPos.X - baseAbs.X) / baseSize.X
    local relY = (absPos.Y - baseAbs.Y) / baseSize.Y
    local dx = relX - centerX
    local dy = relY - centerY
    local dist = math.sqrt(dx*dx + dy*dy)
    if dist > maxR then
        dx = dx / dist * maxR
        dy = dy / dist * maxR
    end
    thumb.Position = UDim2.new(centerX + dx, -17.5, centerY + dy, -17.5)
    updateMove()
end)

-- === 5 NÚT CHỨC NĂNG (HIỂN THỊ RÕ) ===
local btnList = {"Q", "E", "R", "+", "-"}
local isToggle = {true, true, false, false, false} -- Q và E toggle, còn lại bấm thường
local btnY = 0.75
local startX = 0.05
local spacing = 0.18

for i, name in ipairs(btnList) do
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0, 50, 0, 40)
    btn.Position = UDim2.new(startX + (i-1)*spacing, 0, btnY, 0)
    btn.BackgroundColor3 = Color3.fromRGB(100, 100, 140)
    btn.TextColor3 = Color3.new(1, 1, 1)
    btn.Text = name
    btn.TextScaled = true
    btn.BorderSizePixel = 2
    btn.BorderColor3 = Color3.new(1, 1, 1)
    btn.Parent = frame
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 6)
    corner.Parent = btn

    if isToggle[i] then
        local toggled = false
        btn.MouseButton1Click:Connect(function()
            toggled = not toggled
            btn.BackgroundColor3 = toggled and Color3.fromRGB(0, 200, 0) or Color3.fromRGB(100, 100, 140)
            btn.Text = name .. (toggled and " [ON]" or " [OFF]")
            print("Toggle " .. name .. " = " .. tostring(toggled))
            -- Gửi lên server nếu có Remote
        end)
    else
        btn.MouseButton1Click:Connect(function()
            print("Pressed " .. name)
            btn.BackgroundColor3 = Color3.fromRGB(200, 200, 50)
            task.wait(0.1)
            btn.BackgroundColor3 = Color3.fromRGB(100, 100, 140)
            -- Gửi lên server nếu có Remote
        end)
    end
end

