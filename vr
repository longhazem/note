-- Biến trạng thái joystick
local isDragging = false
local centerX = 0.5
local centerY = 0.5
local maxRadius = 0.4 -- tỷ lệ so với base (80px / 160)

-- Hàm cập nhật hướng và gửi server
local function sendMoveFromThumb()
    local pos = thumb.Position
    local dx = pos.X.Scale - centerX
    local dy = pos.Y.Scale - centerY
    local dist = math.sqrt(dx*dx + dy*dy)
    if dist > maxRadius then
        dx = dx / dist * maxRadius
        dy = dy / dist * maxRadius
        thumb.Position = UDim2.new(centerX + dx, 0, centerY + dy, 0)
    end
    -- Chuẩn hóa vector (gửi server)
    local normX = dx / maxRadius
    local normY = dy / maxRadius
    -- Chỉ gửi khi khác 0 đáng kể
    if math.abs(normX) > 0.05 or math.abs(normY) > 0.05 then
        Remote:FireServer("move", Vector2.new(normX, -normY)) -- đảo Y vì Roblox Y hướng lên
    else
        Remote:FireServer("move", Vector2.new(0, 0))
    end
end

-- Sự kiện kéo thumb
local function onInputBegan(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        isDragging = true
    end
end

local function onInputEnded(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        isDragging = false
        -- Tự động về trung tâm khi thả
        thumb.Position = UDim2.new(0.5, -20, 0.5, -20)
        Remote:FireServer("move", Vector2.new(0, 0))
    end
end

local function onMouseMove(input)
    if not isDragging then return end
    -- Lấy vị trí chuột so với joystickBase
    local absPos = input.Position
    local baseAbsPos = joystickBase.AbsolutePosition
    local baseSize = joystickBase.AbsoluteSize
    local relX = (absPos.X - baseAbsPos.X) / baseSize.X
    local relY = (absPos.Y - baseAbsPos.Y) / baseSize.Y
    -- Giới hạn trong vòng tròn
    local dx = relX - centerX
    local dy = relY - centerY
    local dist = math.sqrt(dx*dx + dy*dy)
    if dist > maxRadius then
        dx = dx / dist * maxRadius
        dy = dy / dist * maxRadius
    end
    thumb.Position = UDim2.new(centerX + dx, -20, centerY + dy, -20)
    sendMoveFromThumb()
end

-- Gắn sự kiện vào UserInputService
local UIS = game:GetService("UserInputService")
UIS.InputBegan:Connect(onInputBegan)
UIS.InputEnded:Connect(onInputEnded)
UIS.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement then
        onMouseMove(input)
    end
end)

-- === CÁC NÚT BẤM ===
local buttonY = 0.7
local spacing = 0.12

local function taoNut(text, action, isToggle)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0, 50, 0, 40)
    btn.BackgroundColor3 = Color3.fromRGB(70, 70, 90)
    btn.TextColor3 = Color3.new(1,1,1)
    btn.Text = text
    btn.BorderSizePixel = 1
    btn.BorderColor3 = Color3.new(0.6,0.6,0.6)
    btn.Parent = mainFrame
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 8)
    corner.Parent = btn

    if isToggle then
        -- Biến trạng thái toggle
        local toggled = false
        btn.MouseButton1Click:Connect(function()
            toggled = not toggled
            btn.BackgroundColor3 = toggled and Color3.fromRGB(0, 200, 0) or Color3.fromRGB(70, 70, 90)
            btn.Text = text .. (toggled and " [GIỮ]" or " [THẢ]")
            Remote:FireServer("toggle_" .. text, toggled)
        end)
    else
        btn.MouseButton1Click:Connect(function()
            Remote:FireServer("press_" .. text)
            btn.BackgroundColor3 = Color3.fromRGB(150, 150, 200)
            task.wait(0.1)
            btn.BackgroundColor3 = Color3.fromRGB(70, 70, 90)
        end)
    end
    return btn
end

