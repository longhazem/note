-- ============================================
-- AURA KILL SYSTEM V2 - Standalone
-- Rewritten with better network detection
-- ============================================

local AuraKill = {
	Enabled = true,
	Range = 120,
	Interval = 0.15,
	_running = false,
	_connection = nil,
	_lastFire = 0,
	_remote = nil,
	_networkData = nil,
	_scanAttempts = 0,
	Status = "UNINITIALIZED"
}

-- ============================================
-- SERVICES
-- ============================================
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local Camera = workspace.CurrentCamera

-- ============================================
-- NETWORK SCANNING
-- ============================================

local function GetGameCollectables()
	local success, result = pcall(function()
		-- Try filtergc first (faster)
		if filtergc then
			return filtergc("table")
		end
		-- Fallback to getgc
		if getgc then
			return getgc(true)
		end
		return {}
	end)
	return success and result or {}
end

local function ScanNetworkHandler()
	print("[AK] Scanning memory for network handler...")
	
	local collectables = GetGameCollectables()
	local candidates = {}
	
	for _, obj in pairs(collectables) do
		if type(obj) ~= "table" then continue end
		
		local hasKey = rawget(obj, "_key")
		local hasCode = rawget(obj, "_code")
		local hasEvents = rawget(obj, "_events")
		
		-- Primary signature: encryption data + events
		if hasKey and hasCode and hasEvents then
			if type(hasKey) == "table" and 
			   type(hasCode) == "string" and 
			   type(hasEvents) == "table" then
				table.insert(candidates, {
					priority = 10,
					data = obj,
					reason = "Full encryption + events"
				})
			end
		end
		
		-- Secondary signature: just events with action types
		if hasEvents and type(hasEvents) == "table" and not hasKey then
			local events = hasEvents
			if rawget(events, "InventoryAction") or 
			   rawget(events, "Slash") or 
			   rawget(events, "MeleeAction") then
				table.insert(candidates, {
					priority = 7,
					data = obj,
					reason = "Events table with actions"
				})
			end
		end
		
		-- Tertiary signature: just has code
		if hasCode and type(hasCode) == "string" and hasCode:len() > 20 then
			if string.find(hasCode, "-") then -- UUID format
				table.insert(candidates, {
					priority = 5,
					data = obj,
					reason = "UUID code found"
				})
			end
		end
	end
	
	-- Sort by priority
	table.sort(candidates, function(a, b) return a.priority > b.priority end)
	
	if #candidates > 0 then
		print(string.format("[AK] Found %d candidate(s)", #candidates))
		local best = candidates[1]
		print(string.format("[AK] Using: %s (priority: %d)", best.reason, best.priority))
		return best.data
	end
	
	print("[AK] No network handler found")
	return nil
end

local function FindRemoteEvent()
	print("[AK] Scanning for RemoteEvent...")
	
	-- Common paths
	local paths = {
		function() return ReplicatedStorage:FindFirstChild("Events") and 
		                  ReplicatedStorage.Events:FindFirstChild("RemoteEvent") end,
		function() return ReplicatedStorage:FindFirstChild("Network") end,
		function() return ReplicatedStorage:FindFirstChild("_Network") end,
		function() return ReplicatedStorage:FindFirstChild("RemoteEvent") end,
	}
	
	for i, pathFunc in ipairs(paths) do
		local success, result = pcall(pathFunc)
		if success and result and result:IsA("RemoteEvent") then
			print(string.format("[AK] Found RemoteEvent at path %d", i))
			return result
		end
	end
	
	-- Deep scan
	local function deepScan(folder, depth)
		if depth > 4 then return nil end
		
		for _, child in pairs(folder:GetChildren()) do
			if child:IsA("RemoteEvent") then
				local name = child.Name:lower()
				if name:match("remote") or name:match("event") or name:match("action") then
					print(string.format("[AK] Found RemoteEvent: %s", child:GetFullName()))
					return child
				end
			end
			
			if child:IsA("Folder") or child:IsA("Model") then
				local result = deepScan(child, depth + 1)
				if result then return result end
			end
		end
		return nil
	end
	
	return deepScan(ReplicatedStorage, 0)
end

-- ============================================
-- PACKET BUILDING
-- ============================================

local function BuildPacket(networkData)
	if not networkData then return nil end
	
	local code = rawget(networkData, "_code")
	if not code or type(code) ~= "string" then
		print("[AK] Invalid code")
		return nil
	end
	
	-- Standard packet: [CODE, ACTION, TYPE, VALUE]
	local packet = {
		code,           -- Encryption code/ID
		"InventoryAction",  -- Action type
		"Slash",        -- Action subtype
		1              -- Value/count
	}
	
	print(string.format("[AK] Packet built: [%s, %s, %s, %s]", 
		code:sub(1, 8) .. "...",
		packet[2],
		packet[3],
		packet[4]
	))
	
	return packet
end

-- ============================================
-- FIRING
-- ============================================

local function Fire()
	if not AuraKill._remote then
		print("[AK] No remote!")
		return false
	end
	
	if not AuraKill._networkData then
		print("[AK] No network data!")
		return false
	end
	
	local packet = BuildPacket(AuraKill._networkData)
	if not packet then
		print("[AK] Failed to build packet")
		return false
	end
	
	local success, err = pcall(function()
		-- Try direct fire
		AuraKill._remote:FireServer(unpack(packet))
	end)
	
	if not success then
		print(string.format("[AK] Fire failed: %s", tostring(err)))
		return false
	end
	
	print("[AK] ✓ Fired!")
	return true
end

-- ============================================
-- MAIN LOOP
-- ============================================

local function Tick()
	if not AuraKill.Enabled then return end
	
	local now = tick()
	if now - AuraKill._lastFire < AuraKill.Interval then return end
	
	-- Check actor manager
	if not _G.ActorManager or not _G.ActorManager.Initialized then return end
	
	local myActor = _G.ReplicatorService and _G.ReplicatorService.LocalActor
	if not myActor or not myActor.Alive then return end
	
	local myPos = myActor.Position or Camera.CFrame.Position
	
	-- Scan nearby enemies
	local hasTarget = false
	for _, enemy in ipairs(_G.ActorManager.Enemies or {}) do
		if enemy and enemy.Alive and enemy.Character then
			local enemyPos = enemy.Position or 
						   (enemy.Character.PrimaryPart and enemy.Character.PrimaryPart.Position)
			
			if enemyPos then
				local dist = (enemyPos - myPos).Magnitude
				if dist <= AuraKill.Range then
					hasTarget = true
					break
				end
			end
		end
	end
	
	if not hasTarget then return end
	
	-- Fire!
	if Fire() then
		AuraKill._lastFire = now
	end
end

-- ============================================
-- PUBLIC API
-- ============================================

function AuraKill:Initialize()
	print("[AK] Initializing...")
	AuraKill.Status = "SCANNING..."
	
	-- Scan for network
	AuraKill._networkData = ScanNetworkHandler()
	if not AuraKill._networkData then
		AuraKill.Status = "NETWORK NOT FOUND"
		print("[AK] ✗ Network handler not found")
		return false
	end
	
	-- Scan for remote
	AuraKill._remote = FindRemoteEvent()
	if not AuraKill._remote then
		AuraKill.Status = "REMOTE NOT FOUND"
		print("[AK] ✗ RemoteEvent not found")
		return false
	end
	
	AuraKill.Status = "READY"
	print("[AK] ✓ Initialization complete!")
	return true
end

function AuraKill:Start()
	if AuraKill._running then return end
	
	if AuraKill.Status == "UNINITIALIZED" then
		if not self:Initialize() then return end
	end
	
	AuraKill._running = true
	AuraKill._connection = RunService.Heartbeat:Connect(Tick)
	
	if _G.Moon_Connections then
		table.insert(_G.Moon_Connections, AuraKill._connection)
	end
	
	print("[AK] ✓ Started!")
end

function AuraKill:Stop()
	AuraKill._running = false
	
	if AuraKill._connection then
		pcall(function() AuraKill._connection:Disconnect() end)
		AuraKill._connection = nil
	end
	
	print("[AK] ✓ Stopped!")
end

function AuraKill:Rescan()
	print("[AK] Rescanning...")
	AuraKill.Status = "RESCANNING..."
	
	AuraKill._networkData = ScanNetworkHandler()
	AuraKill._remote = FindRemoteEvent()
	
	if AuraKill._networkData and AuraKill._remote then
		AuraKill.Status = "READY"
		print("[AK] ✓ Rescan successful!")
		return true
	else
		AuraKill.Status = "SCAN FAILED"
		print("[AK] ✗ Rescan failed!")
		return false
	end
end

function AuraKill:GetStatus()
	return string.format("Aura Kill - %s (Range: %d, Interval: %.2fs)", 
		AuraKill.Status, 
		AuraKill.Range, 
		AuraKill.Interval)
end

-- ============================================
-- EXPORT
-- ============================================

_G.AuraKill_V2 = AuraKill

print("[AK] ✓ AuraKill V2 loaded - use _G.AuraKill_V2")

return AuraKill
