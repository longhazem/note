local AutoFarm = {
	Enabled = false,
	MeleeAuraEnabled = false,
	TeleportToNPC = false,
	CurrentTarget = nil,
	TargetDistance = 2,
	MeleeRange = 5,
	AttackSpeed = 0.1,
	LastAttack = 0,
	TargetUpdateCooldown = 0.5,
	LastTargetUpdate = 0,
	NPCsKilled = 0,
	SessionStartTime = tick()
}

local function FindNearestNPC()
	if not ReplicatorService or not ReplicatorService.Actors then return nil end
	
	local nearestNPC = nil
	local nearestDistance = math.huge
	local localPos = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
	
	if not localPos then return nil end
	
	for _, actor in pairs(ReplicatorService.Actors) do
		if actor and actor.SimulatedPosition then
			local isNPC = actor.OwnerName and not actor.IsLocalPlayer
			local isAlive = actor.Health and actor.Health > 0
			local notTeammate = not (actor.Team and ReplicatorService.LocalActor and actor.Team == ReplicatorService.LocalActor.Team)
			
			if isNPC and isAlive and notTeammate then
				local distance = (actor.SimulatedPosition - localPos.Position).Magnitude
				
				if distance < nearestDistance and distance < 500 then
					nearestDistance = distance
					nearestNPC = actor
				end
			end
		end
	end
	
	return nearestNPC
end

local function TeleportToNPC(npc)
	if not npc or not npc.SimulatedPosition then return false end
	if not LocalPlayer.Character then return false end
	
	local hrp = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
	if not hrp then return false end
	
	local offset = Vector3_new(1, -AutoFarm.TargetDistance, 0)
	local newPos = npc.SimulatedPosition + offset
	
	if CharacterController and CharacterController.SetCFrame then
		pcall(function()
			CharacterController:SetCFrame(CFrame_new(newPos))
		end)
	else
		pcall(function() hrp.CFrame = CFrame_new(newPos) end)
	end
	
	return true
end

local function ExecuteMeleeAttack(target)
	if not target or target.Health <= 0 then return false end
	
	local now = tick()
	if (now - AutoFarm.LastAttack) < AutoFarm.AttackSpeed then return false end
	
	AutoFarm.LastAttack = now
	
	local playerHRP = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
	if not playerHRP then return false end
	
	if BulletService and BulletService.Discharge then
		pcall(function()
			local muzzlePos = GetMuzzlePosition() or playerHRP.Position
			local targetPos = target.Head or target.SimulatedPosition
			local aimCF = CFrame_new(muzzlePos, targetPos)
			
			BulletService:Discharge(aimCF, nil, nil, true, nil, nil, nil, nil, nil, false)
			
			if target.Health <= 0 then
				AutoFarm.NPCsKilled = AutoFarm.NPCsKilled + 1
			end
		end)
		return true
	end
	
	return false
end

local function AutoFarmTick()
	if not AutoFarm.Enabled or not ReplicatorService or not LocalPlayer.Character then return end
	
	local now = tick()
	if (now - AutoFarm.LastTargetUpdate) >= AutoFarm.TargetUpdateCooldown then
		AutoFarm.CurrentTarget = FindNearestNPC()
		AutoFarm.LastTargetUpdate = now
	end
	
	if not AutoFarm.CurrentTarget then return end
	
	if AutoFarm.TeleportToNPC then
		TeleportToNPC(AutoFarm.CurrentTarget)
	end
	
	if AutoFarm.MeleeAuraEnabled then
		local playerHRP = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
		if playerHRP then
			local distance = (AutoFarm.CurrentTarget.SimulatedPosition - playerHRP.Position).Magnitude
			
			if distance < AutoFarm.MeleeRange then
				ExecuteMeleeAttack(AutoFarm.CurrentTarget)
			end
		end
	end
end

local AutoFarmConnection
