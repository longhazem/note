-- ==========================================
-- AURA KILL V2 – MELEE + RAKNET DESYNC
-- Teleport đến từng enemy, thực hiện Slash + Impact (melee), về vị trí cũ.
-- UI riêng, nút bật/tắt, kéo thả.
-- ==========================================
local AuraKillV2 = {
    Enabled = false,
    FireDelay = 0.04,          -- thời gian đứng tại target để đánh (giây)
    _net = nil,
    _remote = nil,
    _connection = nil,
    _running = false,
}

-- === SAO CHÉP HÀM TỪ AURAKILL V1 (để độc lập) ===
local function AKV2_FindNet()
    if AuraKillV2._net then return AuraKillV2._net end
    if shared and type(shared.import) == "function" then
        local ok, net = pcall(shared.import, "network")
        if ok and net and rawget(net, "_key") and rawget(net, "_code") then
            AuraKillV2._net = net; return net
        end
    end
    local ok, gc = pcall(filtergc, "table")
    if not ok then ok, gc = pcall(getgc, true) end
    if ok and gc then
        for _, v in pairs(gc) do
            if type(v) == "table" and rawget(v, "_key") and rawget(v, "_code") and rawget(v, "_events") then
                AuraKillV2._net = v; return v
            end
        end
    end
    return nil
end

local function AKV2_GetRemote()
    if AuraKillV2._remote and AuraKillV2._remote.Parent then return AuraKillV2._remote end
    local ev = game:GetService("ReplicatedStorage"):FindFirstChild("Events")
    if ev then
        local re = ev:FindFirstChild("RemoteEvent")
        if re then AuraKillV2._remote = re; return re end
    end
    for _, v in ipairs(game:GetService("ReplicatedStorage"):GetDescendants()) do
        if v:IsA("RemoteEvent") then AuraKillV2._remote = v; return v end
    end
    return nil
end

local function AKV2_NetEncode(jsonStr, key)
    local result = ""
    for i = 1, #jsonStr do
        local ki = i % 4
        local kval = key[ki + 1]
        local nb = (string.byte(jsonStr, i) - 32 + kval) % 95 + 32
        result = result .. string.char(nb)
    end
    local firstByte = string.byte(jsonStr, 1)
    for v24 = 1, key[5] do
        local v26 = tostring(v24)
        local v27 = firstByte - string.byte(v26, 1)
        result = result .. string.char(v27)
    end
    return result
end

local function AKV2_Encrypt(data, net)
    local hs = game:GetService("HttpService")
    local ok, raw = pcall(function() return hs:JSONEncode(data) end)
    if not ok or not raw then return nil end
    return AKV2_NetEncode(raw, net._key)
end

local function AKV2_GetUID(actor)
    for _, field in ipairs({"UID","_id","Id","UUID"}) do
        local v = rawget(actor, field)
        if type(v) == "string" and v:match("^%x+%-%x+%-%x+%-%x+%-%x+$") then return v end
    end
    return nil
end

local function AKV2_FireMelee(actor)
    local net = AKV2_FindNet()
    if not net then return false end
    local remote = AKV2_GetRemote()
    if not remote then return false end
    local char = actor.Character
    if not char then return false end
    local part = char:FindFirstChild("Head") or char:FindFirstChild("UpperTorso") or char.PrimaryPart
    if not part then return false end
    local pos = part.Position
    local uid = AKV2_GetUID(actor)
    if not uid then return false end

    local n = math.random(1, 3)
    local encSlash = AKV2_Encrypt({net._code, "InventoryAction", "Slash", n}, net)
    if encSlash then pcall(function() remote:FireServer(encSlash) end) end

    local encImpact = AKV2_Encrypt(
        {net._code, "InventoryAction", "Impact", {pos.X, pos.Y, pos.Z}, uid, part.Name},
        net
    )
    if encImpact then pcall(function() remote:FireServer(encImpact) end) end
    return true
end

-- === TELEPORT QUA RAKNET BITSTREAM ===
local function AKV2_SendCFrame(position, cframe)
    local net = AKV2_FindNet()
    if not net then return false end

    local success, stream = pcall(function()
        local bs = bitstream()
        bs:WriteByte(0x1D)  -- opcode SetCFrame / PhysicsUpdate
        bs:WriteFloat(position.X)
        bs:WriteFloat(position.Y)
        bs:WriteFloat(position.Z)
        local rX, rY, rZ = cframe:ToEulerAnglesXYZ()
        bs:WriteFloat(rX)
        bs:WriteFloat(rY)
        bs:WriteFloat(rZ)
        bs:WriteByte(0)
        bs:ResetWritePointer()
        return bs
    end)

    if not success or not stream then return false end

    if net.Send then
        pcall(net.Send, net, stream)
        return true
    elseif net.Fire then
        pcall(net.Fire, net, stream)
        return true
    end

    -- fallback
    local actor = ReplicatorService and ReplicatorService.LocalActor
    if actor then
        pcall(function()
            actor.SimulatedPosition = position
            actor.CFrame = cframe
        end)
        return true
    end
    return false
end

-- === XỬ LÝ MỘT TARGET ===
local function AKV2_Execute(target)
    local actor = ReplicatorService and ReplicatorService.LocalActor
    if not actor then return false end

    local origPos = actor.Position or Camera.CFrame.Position
    local origCF = actor.CFrame or Camera.CFrame

    local targetPos = target.Position
    if not targetPos and target.Character and target.Character.PrimaryPart then
        targetPos = target.Character.PrimaryPart.Position
    end
    if not targetPos then return false end

    local teleportPos = targetPos + Vector3.new(0, 2, 0)
    local teleportCF = CFrame.new(teleportPos, targetPos)

    -- Teleport đến
    AKV2_SendCFrame(teleportPos, teleportCF)
    pcall(function()
        actor.SimulatedPosition = teleportPos
        actor.CFrame = teleportCF
    end)

    task.wait(AuraKillV2.FireDelay)

    -- Melee kill
    AKV2_FireMelee(target)

    task.wait(0.02)

    -- Về vị trí cũ
    AKV2_SendCFrame(origPos, origCF)
    pcall(function()
        actor.SimulatedPosition = origPos
        actor.CFrame = origCF
    end)

    return true
end

-- === VÒNG LẶP CHÍNH (KHÔNG RANGE) ===
local function AKV2_Tick()
    if not AuraKillV2.Enabled then return end
    local enemies = ActorManager.Enemies
    if not enemies or #enemies == 0 then return end

    for _, enemy in ipairs(enemies) do
        if enemy and enemy.Alive and enemy.Character then
            task.spawn(function()
                AKV2_Execute(enemy)
            end)
            task.wait(0.01)   -- ngăn spam quá mức
        end
    end
end

function AuraKillV2.Start()
    if AuraKillV2._running then return end
    AuraKillV2._running = true
    AKV2_FindNet()
    AKV2_GetRemote()
    AuraKillV2._connection = RunService.Heartbeat:Connect(AKV2_Tick)
    table.insert(getgenv().Moon_Connections, AuraKillV2._connection)
    print("[AuraKillV2] Started (Melee + RakNet)")
end

function AuraKillV2.Stop()
    AuraKillV2._running = false
    if AuraKillV2._connection then
        pcall(AuraKillV2._connection.Disconnect, AuraKillV2._connection)
        AuraKillV2._connection = nil
    end
    print("[AuraKillV2] Stopped")
end

-- === UI RIÊNG ===
local function CreateAuraV2UI()
    local gui = Instance.new("ScreenGui")
    gui.Name = "AuraKillV2_GUI"
    gui.ResetOnSpawn = false

    local container = gethui() or game:GetService("CoreGui")
    gui.Parent = container

    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(0, 140, 0, 60)
    frame.Position = UDim2.new(0.5, -70, 0.5, -30)
    frame.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
    frame.BackgroundTransparency = 0.15
    frame.BorderSizePixel = 0
    frame.Active = true
    frame.Draggable = true
    frame.Parent = gui

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 8)
    corner.Parent = frame

    local toggleBtn = Instance.new("TextButton")
    toggleBtn.Size = UDim2.new(0, 110, 0, 28)
    toggleBtn.Position = UDim2.new(0.5, -55, 0.5, -14)
    toggleBtn.Text = "🔴 OFF"
    toggleBtn.TextColor3 = Color3.new(1, 1, 1)
    toggleBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
    toggleBtn.BorderSizePixel = 0
    toggleBtn.Parent = frame

    local btnCorner = Instance.new("UICorner")
    btnCorner.CornerRadius = UDim.new(0, 4)
    btnCorner.Parent = toggleBtn

    toggleBtn.MouseButton1Click:Connect(function()
        AuraKillV2.Enabled = not AuraKillV2.Enabled
        if AuraKillV2.Enabled then
            AuraKillV2.Start()
            toggleBtn.Text = "🟢 ON"
            toggleBtn.BackgroundColor3 = Color3.fromRGB(0, 150, 0)
        else
            AuraKillV2.Stop()
            toggleBtn.Text = "🔴 OFF"
            toggleBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
        end
    end)

    local closeBtn = Instance.new("TextButton")
    closeBtn.Size = UDim2.new(0, 20, 0, 20)
    closeBtn.Position = UDim2.new(1, -24, 0, 4)
    closeBtn.Text = "✕"
    closeBtn.TextColor3 = Color3.new(1, 1, 1)
    closeBtn.BackgroundColor3 = Color3.fromRGB(80, 80, 80)
    closeBtn.BorderSizePixel = 0
    closeBtn.Parent = frame

    local closeCorner = Instance.new("UICorner")
    closeCorner.CornerRadius = UDim.new(0, 4)
    closeCorner.Parent = closeBtn

    closeBtn.MouseButton1Click:Connect(function()
        if AuraKillV2.Enabled then AuraKillV2.Stop() end
        gui:Destroy()
    end)

    return gui
end

task.spawn(function()
    CreateAuraV2UI()
    print("[AuraKillV2] UI ready – click OFF/ON để dùng melee")
end)

getgenv().AuraKillV2 = AuraKillV2
