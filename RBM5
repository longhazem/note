-- ==========================================
-- AURA KILL V2 – RAKNET DESYNC + UI RIÊNG
-- Không range, teleport đến từng enemy, bắn, về vị trí cũ.
-- UI nhỏ gọn, kéo thả, nút bật/tắt.
-- ==========================================
local AuraKillV2 = {
    Enabled = false,
    FireDelay = 0.05,
    TargetPart = "Head",
    _net = nil,
    _connection = nil,
    _running = false,
}

-- Tìm network table (chứa _key, _code, Send/Fire)
local function AKV2_FindNet()
    if AuraKillV2._net then return AuraKillV2._net end
    if shared and type(shared.import) == "function" then
        local ok, net = pcall(shared.import, "network")
        if ok and net and rawget(net, "_key") and rawget(net, "_code") then
            AuraKillV2._net = net; return net
        end
    end
    local ok, gc = pcall(filtergc, "table")
    if not ok then ok, gc = pcall(getgc, true) end
    if ok and gc then
        for _, v in pairs(gc) do
            if type(v) == "table" and rawget(v, "_key") and rawget(v, "_code") and rawget(v, "_events") then
                AuraKillV2._net = v; return v
            end
        end
    end
    return nil
end

-- Lấy weapon hiện tại
local function AKV2_GetWeapon()
    local inv = InventoryService
    if inv and inv.Equipped then return inv.Equipped.Handler end
    return WeaponManager.Equipped
end

-- Gửi gói tin CFrame qua RakNet (dùng bitstream)
local function AKV2_SendCFrame(position, cframe)
    local net = AKV2_FindNet()
    if not net then return false end

    local success, stream = pcall(function()
        local bs = bitstream()
        bs:WriteByte(0x1D)  -- opcode cho SetCFrame / PhysicsUpdate
        bs:WriteFloat(position.X)
        bs:WriteFloat(position.Y)
        bs:WriteFloat(position.Z)
        local rX, rY, rZ = cframe:ToEulerAnglesXYZ()
        bs:WriteFloat(rX)
        bs:WriteFloat(rY)
        bs:WriteFloat(rZ)
        bs:WriteByte(0)     -- padding
        bs:ResetWritePointer()
        return bs
    end)

    if not success or not stream then return false end

    if net.Send then
        pcall(net.Send, net, stream)
        return true
    elseif net.Fire then
        pcall(net.Fire, net, stream)
        return true
    end

    -- Fallback gán trực tiếp
    local actor = ReplicatorService and ReplicatorService.LocalActor
    if actor then
        pcall(function()
            actor.SimulatedPosition = position
            actor.CFrame = cframe
        end)
        return true
    end
    return false
end

-- Teleport → bắn → về
local function AKV2_Execute(target)
    local weapon = AKV2_GetWeapon()
    if not weapon then return false end

    local actor = ReplicatorService and ReplicatorService.LocalActor
    if not actor then return false end

    local origPos = actor.Position or Camera.CFrame.Position
    local origCF = actor.CFrame or Camera.CFrame

    local targetPos = target.Position
    if not targetPos and target.Character and target.Character.PrimaryPart then
        targetPos = target.Character.PrimaryPart.Position
    end
    if not targetPos then return false end

    local teleportPos = targetPos + Vector3.new(0, 2, 0)
    local teleportCF = CFrame.new(teleportPos, targetPos)

    -- Teleport đến
    AKV2_SendCFrame(teleportPos, teleportCF)
    pcall(function()
        actor.SimulatedPosition = teleportPos
        actor.CFrame = teleportCF
    end)

    task.wait(AuraKillV2.FireDelay)

    -- Bắn
    pcall(function()
        if weapon._discharge then weapon:_discharge(true)
        elseif weapon.Discharge then weapon:Discharge() end
    end)

    task.wait(0.02)

    -- Về vị trí cũ
    AKV2_SendCFrame(origPos, origCF)
    pcall(function()
        actor.SimulatedPosition = origPos
        actor.CFrame = origCF
    end)

    return true
end

-- Vòng lặp chính: lấy tất cả enemy (không giới hạn range)
local function AKV2_Tick()
    if not AuraKillV2.Enabled then return end

    local myActor = ReplicatorService and ReplicatorService.LocalActor
    if not myActor then return end

    -- Lấy danh sách enemy từ ActorManager
    local enemies = ActorManager.Enemies
    if not enemies or #enemies == 0 then return end

    -- Xử lý lần lượt từng enemy
    for _, enemy in ipairs(enemies) do
        if enemy and enemy.Alive and enemy.Character then
            task.spawn(function()
                AKV2_Execute(enemy)
            end)
            task.wait(0.01)  -- chống spam
        end
    end
end

function AuraKillV2.Start()
    if AuraKillV2._running then return end
    AuraKillV2._running = true
    AKV2_FindNet()
    AuraKillV2._connection = RunService.Heartbeat:Connect(AKV2_Tick)
    table.insert(getgenv().Moon_Connections, AuraKillV2._connection)
    print("[AuraKillV2] Started")
end

function AuraKillV2.Stop()
    AuraKillV2._running = false
    if AuraKillV2._connection then
        pcall(AuraKillV2._connection.Disconnect, AuraKillV2._connection)
        AuraKillV2._connection = nil
    end
    print("[AuraKillV2] Stopped")
end

-- ==========================================
-- TẠO UI RIÊNG (không ghép vào UI chính)
-- ==========================================
local function CreateAuraUI()
    local gui = Instance.new("ScreenGui")
    gui.Name = "AuraKillV2_GUI"
    gui.ResetOnSpawn = false

    local container = gethui() or game:GetService("CoreGui")
    gui.Parent = container

    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(0, 150, 0, 60)
    frame.Position = UDim2.new(0.5, -75, 0.5, -30)
    frame.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
    frame.BackgroundTransparency = 0.2
    frame.BorderSizePixel = 0
    frame.Active = true
    frame.Draggable = true
    frame.Parent = gui

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 8)
    corner.Parent = frame

    local toggleBtn = Instance.new("TextButton")
    toggleBtn.Size = UDim2.new(0, 120, 0, 30)
    toggleBtn.Position = UDim2.new(0.5, -60, 0.5, -15)
    toggleBtn.Text = "Aura OFF"
    toggleBtn.TextColor3 = Color3.new(1, 1, 1)
    toggleBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
    toggleBtn.BorderSizePixel = 0
    toggleBtn.Parent = frame

    local btnCorner = Instance.new("UICorner")
    btnCorner.CornerRadius = UDim.new(0, 4)
    btnCorner.Parent = toggleBtn

    toggleBtn.MouseButton1Click:Connect(function()
        AuraKillV2.Enabled = not AuraKillV2.Enabled
        if AuraKillV2.Enabled then
            AuraKillV2.Start()
            toggleBtn.Text = "Aura ON"
            toggleBtn.BackgroundColor3 = Color3.fromRGB(0, 150, 0)
        else
            AuraKillV2.Stop()
            toggleBtn.Text = "Aura OFF"
            toggleBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
        end
    end)

    -- Nút đóng UI (X)
    local closeBtn = Instance.new("TextButton")
    closeBtn.Size = UDim2.new(0, 20, 0, 20)
    closeBtn.Position = UDim2.new(1, -25, 0, 5)
    closeBtn.Text = "X"
    closeBtn.TextColor3 = Color3.new(1, 1, 1)
    closeBtn.BackgroundColor3 = Color3.fromRGB(80, 80, 80)
    closeBtn.BorderSizePixel = 0
    closeBtn.Parent = frame

    local closeCorner = Instance.new("UICorner")
    closeCorner.CornerRadius = UDim.new(0, 4)
    closeCorner.Parent = closeBtn

    closeBtn.MouseButton1Click:Connect(function()
        gui:Destroy()
        if AuraKillV2.Enabled then
            AuraKillV2.Stop()
            AuraKillV2.Enabled = false
        end
    end)

    return gui
end

-- Tạo UI ngay khi script load
task.spawn(function()
    CreateAuraUI()
    print("[AuraKillV2] UI created – click 'Aura OFF' to toggle")
end)

getgenv().AuraKillV2 = AuraKillV2
