-- Usage functions
local function SetupAutoFarmUI()
	if not Window then return end
	
	local FarmTab = Window:AddTab("Auto Farm", "target", "Automated farming system")
	
	local FarmSection = FarmTab:AddLeftGroupbox("Auto Farm Control")
	FarmSection:AddToggle("AutoFarm_Enable", {
		Text = "Enable Auto Farm",
		Default = false,
		Callback = function(val)
			AutoFarm.Enabled = val
			if val then EnableAutoFarm() else DisableAutoFarm() end
		end
	})
	
	FarmSection:AddToggle("AutoFarm_Teleport", {
		Text = "Teleport to NPC",
		Default = true,
		Callback = function(val)
			AutoFarm.TeleportToNPC = val
		end
	})
	
	FarmSection:AddToggle("AutoFarm_Melee", {
		Text = "Melee Aura Kill",
		Default = true,
		Callback = function(val)
			AutoFarm.MeleeAuraEnabled = val
		end
	})
	
	local SettingsSection = FarmTab:AddLeftGroupbox("Farm Settings")
	SettingsSection:AddSlider("AutoFarm_Range", {
		Text = "Melee Range",
		Default = 5,
		Min = 1,
		Max = 20,
		Rounding = 1,
		Suffix = "m",
		Callback = function(val)
			AutoFarm.MeleeRange = val
		end
	})
	
	SettingsSection:AddSlider("AutoFarm_Speed", {
		Text = "Attack Speed",
		Default = 0.1,
		Min = 0.05,
		Max = 0.5,
		Rounding = 2,
		Suffix = "s",
		Callback = function(val)
			AutoFarm.AttackSpeed = val
		end
	})
	
	local StatsSection = FarmTab:AddRightGroupbox("Session Stats")
	StatsSection:AddButton("Reset Stats", function()
		ResetAutoFarmStats()
	end)
	
	local StatusLabel = StatsSection:AddLabel("Status: Idle")
	
	local StatusConn = RunService.Heartbeat:Connect(function()
		if FarmTab then
			local elapsed = math.floor(tick() - AutoFarm.SessionStartTime)
			local status = AutoFarm.Enabled and "FARMING" or "Idle"
			local target = AutoFarm.CurrentTarget and (AutoFarm.CurrentTarget.OwnerName or "Unknown") or "None"
			
			pcall(function()
				StatusLabel:SetText(string.format(
					"Status: %s\nTarget: %s\nKills: %d\nUptime: %ds",
					status, target, AutoFarm.NPCsKilled, elapsed
				))
			end)
		end
	end)
	
	table.insert(getgenv().Moon_Connections, StatusConn)
end

-- Auto setup UI when window is created
task.wait(0.5)
pcall(SetupAutoFarmUI)

