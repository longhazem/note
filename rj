local function clamp(x, a, b)
    if x < a then
        return a
    end
    if x > b then
        return b
    end
    return x
end

local function flat(v)
    return Vector3.new(v.X, 0, v.Z)
end

-- the travel direction: the car's forward, flipped if it points against the road
local function orient(fwd, ref)
    if ref.Magnitude > 0.01 and fwd:Dot(ref) < 0 then
        return -fwd
    end
    return fwd
end

-- the highest speed the road allows from here: corner speed sqrt(LatAccel / curvature), braked into from each sample
local function speedAllowed(sCar, road, rp, cfg, roadEnd)
    local best = math.huge
    for _, d in ipairs(PROFILE_D) do
        local _, _, _, ax, az = rp.pointAt(road, clamp(sCar + d - 10, 0, roadEnd), 0)
        local _, _, _, bx, bz = rp.pointAt(road, clamp(sCar + d + 10, 0, roadEnd), 0)
        local theta = math.acos(clamp(ax * bx + az * bz, -1, 1))
        local kappa = theta / 20
        local vc = kappa > 1e-5 and math.sqrt(cfg.LatAccel * (cfg.CornerScale or 1) / kappa) or math.huge
        local v = math.sqrt(vc * vc + 2 * (cfg.BrakeUse or cfg.BrakeDecel) * math.max(0, d - 4))
        if v < best then
            best = v
        end
    end
    return best
end

-- obstacle: { s = front edge, sEnd = back edge, lat, hw (half width), w (cost), stop (brakes to 0 if blocked) }
-- the car is a rectangle of CarHalf x CarHalfLen. a lane collides with an obstacle when the car's box overlaps it
-- in the road frame, the same as Knockdown.hit does with the car's half sizes.
-- steering feedforward: the wheel angle that follows the road's curvature here, as a share of full lock.
-- the road's right-hand vector is (-fz, fx), so a positive turn means the road bends right.
local function steerFeedforward(road, rp, sCar, cfg)
    local _, _, _, ax, az = rp.pointAt(road, sCar, 0)
    local _, _, _, bx, bz = rp.pointAt(road, sCar + 10, 0)
    local turn = clamp(bx * -az + bz * ax, -1, 1)
    local kappa = math.asin(turn) / 10
    local wheel = math.atan(cfg.Wheelbase * kappa)
    return clamp(wheel / math.rad(34) * cfg.FFGain, -1, 1)
end

-- corner scale: creeps up while the car holds the line with little slip, backs off fast when it starts to slide
local function adaptCornerScale(scale, slipDeg, steerAbs, along, dt, cfg)
    if along < 20 or steerAbs < 0.15 then
        return scale
    end
    if slipDeg > cfg.SlipHi then
        scale = scale - 0.8 * dt
    elseif slipDeg < cfg.SlipLo then
        scale = scale + 0.25 * dt
    end
    return clamp(scale, 0.9, 1.6)
end

local function planDrive(root, dest, road, rp, cfg, finishS, roadEnd, roadHalf, obst, prevLane)
    local pos = root.Position
    local look = flat(root.CFrame.LookVector)
    if look.Magnitude < 0.01 then
        return 0, 0, 0, "no heading", prevLane, nil, 0
    end
    local fwd = look.Unit
    local v = flat(root.AssemblyLinearVelocity)
    local target, vT, lane, gapBest
    local ff = 0

    if dest then
        local toD = flat(dest - pos)
        if toD.Magnitude < cfg.ArriveDist then
            return 0, 1, 0, "arrived", prevLane, nil, 0
        end
        if v.Magnitude > 3 then
            fwd = orient(fwd, v.Unit)
        end
        target = dest
        vT = cfg.TopSpeed
        lane = prevLane
    else
        local sCar, latNow = rp.project(road, pos.X, pos.Z)
        if sCar >= finishS - 2 then
            return 0, 1, 0, "finish", prevLane, nil, 0
        end
        local _, _, _, rdx, rdz = rp.pointAt(road, sCar, 0)
        fwd = orient(fwd, Vector3.new(rdx, 0, rdz))
        local vf = math.max(0, v:Dot(fwd))
        local horizon = clamp(40 + vf * 1.2, 45, 260)
        local maxLat = math.max(0, roadHalf - cfg.CarHalf - cfg.EdgeMargin)
        local base = prevLane or cfg.LaneOffset

        -- only the obstacles that can meet the car within the horizon
        local near, ramps = {}, {}
        for i = 1, #obst do
            local o = obst[i]
            local ds0 = o.s - sCar
            local ds1 = (o.sEnd or o.s) - sCar
            if o.ramp then
                if ds0 > 0 and ds0 < 80 then
                    table.insert(ramps, o)
                end
            elseif ds1 > -cfg.CarHalfLen and ds0 < horizon then
                table.insert(near, o)
            end
        end

        local function evalLane(l)
            local cost = math.abs(l - cfg.LaneOffset) * cfg.CenterW + math.abs(l - base) * cfg.HysteresisW
            local gap, stopGap = nil, nil
            for i = 1, #near do
                local o = near[i]
                local ds0 = o.s - sCar
                if math.abs(l - o.lat) < o.hw + cfg.CarHalf + cfg.Clearance then
                    cost = cost + o.w * (0.4 + (1 - clamp(ds0 / horizon, 0, 1)))
                    local g = math.max(0, ds0 - cfg.CarHalfLen)
                    if gap == nil or g < gap then
                        gap = g
                    end
                    if o.stop and (stopGap == nil or g < stopGap) then
                        stopGap = g
                    end
                end
            end
            return cost, gap, stopGap
        end

        local bestCost, gapA, stopA = evalLane(cfg.LaneOffset)
        lane = cfg.LaneOffset
        gapBest = gapA
        local stopBest = stopA
        for k = -maxLat, maxLat, 0.5 do
            local c, g, sg = evalLane(k)
            if c < bestCost then
                bestCost = c
                lane = k
                gapBest = g
                stopBest = sg
            end
        end

        local aheadS = clamp(sCar + cfg.LookAhead + vf * 0.45, 0, roadEnd)
        local tx, ty, tz = rp.pointAt(road, aheadS, lane)
        target = Vector3.new(tx, ty, tz)

        ff = steerFeedforward(road, rp, sCar, cfg)
        vT = math.min(cfg.TopSpeed, speedAllowed(sCar, road, rp, cfg, roadEnd))
        -- the chosen lane is still blocked: pits stop the car, anything else is taken at crawl speed
        if stopBest then
            vT = math.min(vT, math.sqrt(math.max(0, 2 * (cfg.BrakeUse or cfg.BrakeDecel) * (stopBest - cfg.StopGap))))
        elseif gapBest then
            vT = math.min(vT, math.max(cfg.CrawlSpeed, math.sqrt(math.max(0, 2 * (cfg.BrakeUse or cfg.BrakeDecel) * (gapBest - cfg.StopGap)))))
        end
        -- a lane change takes dl / LatSpeed seconds, so the car must be slow enough to make it before the blocker it leaves
        local dl = math.abs(lane - latNow)
        if dl > 0.5 then
            local _, gapCur = evalLane(latNow)
            if gapCur then
                vT = math.min(vT, math.max(cfg.CrawlSpeed, gapCur * cfg.LatSpeed / dl))
            end
        end
        -- a jump on the lane is taken at speed, so the car leaves the ground
        if not gapBest then
            for _, r in ipairs(ramps) do
                if math.abs(lane - r.lat) < r.hw + cfg.CarHalf then
                    vT = math.max(vT, math.min(cfg.RampSpeed, cfg.TopSpeed))
                end
            end
        end
    end

    local toT = flat(target - pos)
    local dist = toT.Magnitude
    local dir = dist > 0.01 and toT / dist or fwd
    local right = fwd:Cross(Vector3.yAxis)
    local front = dir:Dot(fwd)
    local side = dir:Dot(right)
    local steer = clamp(math.atan2(side, front) * cfg.SteerGain + ff, -1, 1)

    if front < -0.6 then
        vT = math.min(vT, 6)
    end
    if dest then
        vT = math.min(vT, math.max(3, dist * 0.6))
    end

    local speed = v:Dot(fwd)
    local throttle, brake = 0, 0
    if speed < vT - 2 then
        throttle = clamp((vT - speed) / 12, 0.25, 1)
    elseif speed > vT + 1.5 then
        brake = clamp((speed - vT) / 10, 0, 1)
    end
    -- moving backwards against the road: stop that first
    if speed < -1.5 then
        throttle, brake = 0, 1
    end
    return throttle, brake, steer, "drive", lane, gapBest, vT
end

-- RoadKeep.steer replacement: the same zeroing the game does when RoadKeep is not in use
local function keepOffSteer(cfg, keep)
    if keep then
        keep.keepSteer = 0
        keep.keepPush = Vector3.new(0, 0, 0)
        keep.keepExcess = 0
    end
    return 0
end

-- lane keep on manual driving. user = the player's steer, returns the blended steer
local function assistSteerPure(user, lat, headingErr, cfg, gain)
    local latErr = lat - cfg.LaneOffset
    local corr = (-latErr * 0.1 + headingErr) * cfg.AssistGain
    return clamp(user + corr * gain, -1, 1)
end

-- the yaw / pitch the game sends to FlashAim, from a chassis-local direction
local function aimYawPitch(dir)
    local yaw = math.deg(math.atan2(-dir.X, -dir.Z))
    local pitch = math.deg(math.asin(clamp(dir.Y, -1, 1)))
    return math.floor(yaw + 0.5), math.floor(pitch + 0.5)
end

-- speed to put back after a sudden loss without braking
local function impactRestore(prevSpeed, speed, brake, cfg)
    if prevSpeed == nil or brake > 0.2 then
        return 0
    end
    local drop = prevSpeed - speed
    if drop > cfg.ImpactDrop then
        return drop * cfg.ImpactKeep
    end
    return 0
end

-- forward push for pace assist this frame
local function paceAdd(speed, throttle, brake, cfg, dt, steer)
    if throttle < 0.3 or brake > 0.05 or speed >= cfg.PaceTarget or math.abs(steer or 0) > cfg.PaceSteerMax then
        return 0
    end
    return math.min(cfg.PaceBoost * dt, cfg.PaceTarget - speed)
end
-- which set-piece boxes block the car. sSpan along the road, latSpan across it, yTop and yBot above the road, ySpan tall.
-- a fallen mast is narrow along the road and wide across it, so it counts. ramps, decks and road slabs are long and low, so they don't.
local function boxAccept(sSpan, latSpan, yTop, yBot, ySpan)
    if sSpan > 40 or latSpan > 90 then
        return false
    end
    if yBot > 3.4 or yTop < 1.0 or ySpan < 0.8 then
        return false
    end
    if latSpan > 20 and yTop < 3.0 and sSpan > 6 then
        return false
    end
    return true
end

-- door automation for the crawler: answer each quick-time prompt once, and hold the door while it pulls with no prompt
local function doorAction(st, phase, mine, qteOn, qteId, now, delay)
    local out = {}
    local pull = (phase == "Pull") and mine
    if pull and qteOn and qteId ~= 0 and qteId ~= st.lastId and st.pending ~= qteId then
        st.pending = qteId
        st.pendingAt = now + delay
    end
    if st.pending and not pull then
        st.pending = nil
    end
    if st.pending and now >= st.pendingAt then
        out.key = st.pending
        st.lastId = st.pending
        st.pending = nil
    end
    local wantHold = pull and not qteOn
    if wantHold ~= st.held then
        st.held = wantHold
        out.hold = wantHold
    end
    return out
end
-- a jump ramp: as wide as the map's Jumps.Lateral sets it, about as long as Jumps.Length. such a box never blocks
local function isRampBox(sSpan, latC, lateral, length)
    return math.abs(math.abs(latC) - lateral) < 0.8 and sSpan >= length * 0.6 and sSpan <= length * 1.6
end
-- steering command: it may move at most maxRate per second
local function rateLimit(prev, target, maxRate, dt)
    local step = maxRate * dt
    return prev + clamp(target - prev, -step, step)
end

-- braking estimate: the largest deceleration seen while braking straight at speed, decaying slowly
local function brakeSample(estimate, along, alongPrev, brake, throttle, steerAbs, dt)
    if dt <= 0 or alongPrev == nil or along < 8 or brake < 0.9 or throttle > 0.05 or steerAbs > 0.2 then
        return estimate
    end
    local decel = (alongPrev - along) / dt
    if decel <= 0 or decel > 150 then
        return estimate
    end
    return math.max((estimate or 0) * 0.995, decel)
end

-- stall: the car wants to move but has not moved for a while. returns the timer, and whether to wiggle now
local function stallStep(timer, speed, wanting, dt)
    if wanting and math.abs(speed) < 1.0 then
        timer = timer + dt
    else
        timer = 0
    end
    return timer, timer > 2.5
end
