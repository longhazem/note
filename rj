local function scanKnocks()
    knockCache = {}
    local map = workspace:FindFirstChild("Map")
    if not map then
        return
    end
    for _, m in ipairs(map:GetChildren()) do
        if m:IsA("Model") and m:GetAttribute("Knock") and not m:GetAttribute("Knocked") then
            local p = m:GetAttribute("KnockBase")
            if typeof(p) ~= "Vector3" then
                p = m:GetPivot().Position
            end
            local s, lat = RoadPath.project(Road, p.X, p.Z)
            table.insert(knockCache, { s = s, sEnd = s, lat = lat, hw = KNOCK_HW, w = W_KNOCK, stop = false, kind = "knock" })
        end
    end
end

-- the box of a set piece in the road frame: front and back along the road, left and right across it.
-- only solid things count: a box that stays above the car, or a flat road slab, is not an obstacle
local function boxFor(inst)
    local cf, size
    if inst:IsA("Model") then
        cf, size = inst:GetBoundingBox()
    elseif inst:IsA("BasePart") then
        cf, size = inst.CFrame, inst.Size
    else
        return nil
    end
    local sMin, sMax = math.huge, -math.huge
    local latMin, latMax = math.huge, -math.huge
    local yMin, yMax = math.huge, -math.huge
    for i = 0, 7 do
        local ox = ((i % 2 == 0) and -0.5 or 0.5) * size.X
        local oy = ((math.floor(i / 2) % 2 == 0) and -0.5 or 0.5) * size.Y
        local oz = ((math.floor(i / 4) % 2 == 0) and -0.5 or 0.5) * size.Z
        local p = (cf * CFrame.new(ox, oy, oz)).Position
        local s, lat = RoadPath.project(Road, p.X, p.Z)
        if s < sMin then
            sMin = s
        end
        if s > sMax then
            sMax = s
        end
        if lat < latMin then
            latMin = lat
        end
        if lat > latMax then
            latMax = lat
        end
        if p.Y < yMin then
            yMin = p.Y
        end
        if p.Y > yMax then
            yMax = p.Y
        end
    end
    if sMax - sMin > 40 or latMax - latMin > 90 then
        return nil
    end
    if latMax < -(ROAD_HALF + 4) or latMin > ROAD_HALF + 4 then
        return nil
    end
    local jumps = WorldCfg.Jumps
    if jumps and jumps.Lateral and jumps.Length then
        local latC = (latMin + latMax) / 2
        if isRampBox(sMax - sMin, latC, jumps.Lateral, jumps.Length) then
            return { s = sMin, sEnd = sMax, lat = latC, hw = (latMax - latMin) / 2, w = 0, stop = false, kind = "ramp", ramp = true }
        end
    end
    local sMid = clamp((sMin + sMax) / 2, 0, ROAD_END)
    local latMid = clamp((latMin + latMax) / 2, -ROAD_HALF, ROAD_HALF)
    local _, roadY = RoadPath.pointAt(Road, sMid, latMid)
    if not boxAccept(sMax - sMin, latMax - latMin, yMax - roadY, yMin - roadY, yMax - yMin) then
        return nil
    end
    return { s = sMin, sEnd = sMax, lat = (latMin + latMax) / 2, hw = (latMax - latMin) / 2, w = W_BOX, stop = false, kind = inst.Name }
end

local function scanMapBoxes()
    mapBoxes = {}
    boxesAhead = 0
    local map = workspace:FindFirstChild("Map")
    if not map or not carS then
        return
    end
    local function consider(inst)
        if inst:GetAttribute("Knock") then
            return
        end
        local pos
        if inst:IsA("Model") then
            pos = inst:GetPivot().Position
        elseif inst:IsA("BasePart") then
            pos = inst.Position
        else
            return
        end
        local s = RoadPath.project(Road, pos.X, pos.Z)
        if s < carS - 40 or s > carS + MAP_AHEAD then
            return
        end
        local b = boxFor(inst)
        if b then
            table.insert(mapBoxes, b)
            if b.s > carS and b.s < carS + 200 then
                boxesAhead = boxesAhead + 1
            end
        end
    end
    for _, child in ipairs(map:GetChildren()) do
        if child:IsA("Folder") then
            for _, sub in ipairs(child:GetChildren()) do
                consider(sub)
            end
        else
            consider(child)
        end
    end
end

-- every watcher the map will spawn, from the same rule Monsters.lua uses (Scatter.watchers)
local function getWatchPlan()
    if watchPlan then
        return watchPlan
    end
    local ok, list = pcall(Scatter.watchers, WorldCfg, Road)
    watchPlan = (ok and type(list) == "table") and list or {}
    return watchPlan
end

local function refreshWatchObst()
    watchObst = {}
    if not carS then
        return
    end
    for _, w in ipairs(getWatchPlan()) do
        local lateral = w.lateral or 0
        if w.s > carS - 10 and w.s < carS + 300 and math.abs(lateral) < ROAD_HALF + 3 then
            if not (Frost.inTunnel(WorldCfg, w.s, 100) or Frost.inPass(WorldCfg, w.s, 100)) then
                table.insert(watchObst, { s = w.s, sEnd = w.s, lat = lateral, hw = 2.2, w = W_WATCH, stop = false, kind = w.kind or "Watcher" })
            end
        end
    end
end

