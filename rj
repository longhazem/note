                local s, lat = RoadPath.project(Road, p.X, p.Z)
                local vs, vl = 0, 0
                local h = monHist[m]
                if h and now > h.t and now - h.t < 0.6 then
                    local dt = now - h.t
                    vs = smoothVel(h.vs, (s - h.s) / dt, 0.5)
                    vl = smoothVel(h.vl, (lat - h.lat) / dt, 0.5)
                end
                monHist[m] = { s = s, lat = lat, t = now, vs = vs, vl = vl }
                seenNow[m] = true
                table.insert(out, { s = s, sEnd = s, lat = lat, hw = MONSTER_HW[m.Name] or 3.5, w = W_MON, stop = false, vs = vs, vl = vl, kind = m.Name })
            end
        end
    end
    for m in pairs(monHist) do
        if not seenNow[m] then
            monHist[m] = nil
        end
    end
    return out
