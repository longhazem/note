local function getRunClient()
    if RunClientMod then
        return RunClientMod
    end
    local ps = LP:FindFirstChildOfClass("PlayerScripts")
    local client = ps and ps:FindFirstChild("Client")
    local mod = client and client:FindFirstChild("RunClient")
    if mod then
        local ok, t = pcall(require, mod)
        if ok and type(t) == "table" and type(t.get) == "function" then
            RunClientMod = t
        end
    end
    return RunClientMod
end

local function loadCarInput()
    local function try(mod)
        if not mod then
            return nil
        end
        local ok, t = pcall(require, mod)
        if ok and type(t) == "table" and type(t.Read) == "function" then
            return t
        end
        return nil
    end
    local ps = LP:FindFirstChildOfClass("PlayerScripts")
    local client = ps and ps:FindFirstChild("Client")
    local found = try(client and client:FindFirstChild("CarInput"))
    if found then
        return found
    end
    if type(getloadedmodules) == "function" then
        for _, m in ipairs(getloadedmodules()) do
            if m.Name == "CarInput" then
                found = try(m)
                if found then
                    return found
                end
            end
        end
    end
    return nil
end

local function findDrivenCar()
    local hum = humanoid()
    if not hum then
        return nil
    end
    for _, d in ipairs(workspace:GetDescendants()) do
        if (d:IsA("VehicleSeat") or d:IsA("Seat")) and d.Occupant == hum then
            local model = d:FindFirstAncestorOfClass("Model")
            local chassis = model and model:FindFirstChild("Chassis")
            if chassis and chassis:IsA("BasePart") then
                return chassis, model, d
            end
        end
    end
    return nil
end

local function refreshCar(force)
    local hum = humanoid()
    if not force and carSeat and carSeat.Parent and hum and carSeat.Occupant == hum then
        return
    end
    local now = os.clock()
    if not force and now - lastCarScan < 1 then
        return
    end
    lastCarScan = now
    carRoot, carModel, carSeat = findDrivenCar()
end

-- knock cones: models in workspace.Map with the Knock attribute, not yet knocked over
local function scanKnocks()
    knockCache = {}
    local map = workspace:FindFirstChild("Map")
    if not map then
        return
    end
    for _, m in ipairs(map:GetChildren()) do
        if m:IsA("Model") and m:GetAttribute("Knock") and not m:GetAttribute("Knocked") then
            local p = m:GetAttribute("KnockBase")
            if typeof(p) ~= "Vector3" then
                p = m:GetPivot().Position
            end
            local s, lat = RoadPath.project(Road, p.X, p.Z)
            table.insert(knockCache, { s = s, lat = lat, hw = KNOCK_HW, w = W_KNOCK, brake = false, kind = "knock" })
        end
    end
end

-- static obstacles, knock cones and every monster in ClientMonsters, as (s, lat, half width, cost, braking)
local function buildObstacles()
    local out = {}
    for _, o in ipairs(obstStatic) do
        table.insert(out, o)
    end
    for _, o in ipairs(knockCache) do
        table.insert(out, o)
    end
    local folder = monstersFolder()
    if folder then
        for _, m in ipairs(folder:GetChildren()) do
            if m:IsA("Model") then
                local p = m:GetPivot().Position
                local s, lat = RoadPath.project(Road, p.X, p.Z)
                table.insert(out, { s = s, lat = lat, hw = MONSTER_HW[m.Name] or 3.5, w = W_HIT, brake = true, kind = m.Name })
            end
        end
    end
    return out
end

local function setKeepOff(on)
    if not RoadKeepMod then
        local ok, t = pcall(require, Shared.Rules.Rally.RoadKeep)
        if ok and type(t) == "table" then
            RoadKeepMod = t
        end
    end
    if not RoadKeepMod then
        return
    end
    if on then
        if RoadKeepMod.steer ~= keepOffSteer then
            keepSteerOrig = RoadKeepMod.steer
            RoadKeepMod.steer = keepOffSteer
        end
    elseif keepSteerOrig then
        RoadKeepMod.steer = keepSteerOrig
        keepSteerOrig = nil
    end
end

local function uprightCar(model, root)
    local base = root.Position + Vector3.new(0, 4, 0)
    local look = flat(root.CFrame.LookVector)
    if look.Magnitude < 0.01 then
        look = Vector3.new(0, 0, -1)
    end
    model:PivotTo(CFrame.lookAt(base, base + look.Unit))
    root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
    root.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
end

-- move the whole car onto the road centre, facing along the road, keeping its speed along the road
local function snapToRoad(model, root)
    local pos = root.Position
    local s = RoadPath.project(Road, pos.X, pos.Z)
    local cx, cy, cz, dx, dz = RoadPath.pointAt(Road, s, 0)
    local rd = Vector3.new(dx, 0, dz)
    local look = flat(root.CFrame.LookVector)
    local sign = 1
    if look.Magnitude > 0.01 and look.Unit:Dot(rd) < 0 then
        sign = -1
    end
    local h = CarCfg.RideHeight or 2
    local at = Vector3.new(cx, cy + h, cz)
    local rel = root.CFrame:ToObjectSpace(model:GetPivot())
    model:PivotTo(CFrame.lookAt(at, at + rd * sign) * rel)
    local along = math.max(0, root.AssemblyLinearVelocity:Dot(rd * sign))
    root.AssemblyLinearVelocity = rd * sign * along
    root.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
end

-- anti tumble, impact guard, pace, grip, yaw clamp. every heartbeat, on the chassis
local function guards(dt, model, root)
    if CFG.AntiTumble then
        if root.CFrame.UpVector.Y < CFG.TumbleUpY then
            tumbleT = tumbleT + dt
            if tumbleT > CFG.TumbleTime then
                tumbleT = 0
                uprightCar(model, root)
                return
            end
        else
            tumbleT = 0
        end
    end

    local look = flat(root.CFrame.LookVector)
    if look.Magnitude < 0.01 then
        return
    end
    local pos = root.Position
    local s = RoadPath.project(Road, pos.X, pos.Z)
    local _, _, _, dx, dz = RoadPath.pointAt(Road, s, 0)
    local fwd = orient(look.Unit, Vector3.new(dx, 0, dz))

    local vel = root.AssemblyLinearVelocity
    local speed = flat(vel):Dot(fwd)

    if CFG.ImpactGuard then
        local back = impactRestore(prevSpeed, speed, lastBrake, CFG)
        if back > 0 then
            root.AssemblyLinearVelocity = vel + fwd * back
            speed = speed + back
        end
    end
    prevSpeed = speed

    if CFG.PaceAssist then
        local add = paceAdd(speed, lastThrottle, lastBrake, CFG, dt)
        if add > 0 then
            root.AssemblyLinearVelocity = root.AssemblyLinearVelocity + fwd * add
        end
    end

    if CFG.Grip > 0 and math.abs(lastSteer) < 0.25 then
        local v2 = root.AssemblyLinearVelocity
        local right = fwd:Cross(Vector3.yAxis)
        local latV = right * v2:Dot(right)
        local damp = clamp(CFG.Grip * dt * 4, 0, 0.5)
        root.AssemblyLinearVelocity = v2 - latV * damp
    end

    if CFG.YawClamp then
        local w = root.AssemblyAngularVelocity
        if math.abs(w.Y) > CFG.MaxYawRate then
            root.AssemblyAngularVelocity = Vector3.new(w.X, clamp(w.Y, -CFG.MaxYawRate, CFG.MaxYawRate), w.Z)
        end
    end
end

-- the value CarController reads this physics step
local function computeAssist(st)
    if carRoot == nil or carRoot.Parent == nil then
        return nil
    end
    if driving then
        local t, b, steer, reason, lane, hit, vt = planDrive(carRoot, dest, Road, RoadPath, CFG, FINISH_S, ROAD_END, ROAD_HALF, obstNow, prevLane)
        if lane ~= nil then
            prevLane = lane
        end
        lastHit = hit
        lastVT = vt
        if reason ~= "drive" then
            stopReason = reason
        end
        return t, b, steer
    end
    if CFG.SteerAssist then
        local pos = carRoot.Position
        local s, lat = RoadPath.project(Road, pos.X, pos.Z)
        local _, _, _, dx, dz = RoadPath.pointAt(Road, s, 0)
        local rd = Vector3.new(dx, 0, dz)
        local look = flat(carRoot.CFrame.LookVector)
        if look.Magnitude < 0.01 then
            return nil
        end
        local fwd = orient(look.Unit, rd)
        local right = fwd:Cross(Vector3.yAxis)
        local headingErr = math.atan2(rd:Dot(right), rd:Dot(fwd))
        local gain = math.abs(st.Steer) < 0.05 and CFG.ReturnGain or 0.35
        return st.Throttle, st.Brake, assistSteerPure(st.Steer, lat, headingErr, CFG, gain)
    end
    return nil
end

local function hookRead(ci)
    if readHooked then
        return
    end
    readHooked = true
    CarInputMod = ci
    origRead = ci.Read
    ci.Read = function(p86)
        local st = origRead(p86)
        if type(st) ~= "table" then
            return st
        end
        if not p86 then
            local ok, t, b, steer = pcall(computeAssist, st)
            if ok then
                if t ~= nil then
                    st.Throttle = t
                    st.Brake = b
                    st.Steer = steer
                    if driving then
                        st.Handbrake = false
                    end
                end
            else
                warn("[tokaihub] assist: " .. tostring(t))
            end
        end
        lastThrottle, lastBrake, lastSteer = st.Throttle, st.Brake, st.Steer
        return st
    end
end

local function unhookRead()
    if readHooked and CarInputMod and origRead then
        CarInputMod.Read = origRead
    end
    readHooked = false
end

local function setDrive(on)
    if not on then
        driving = false
        setKeepOff(false)
        return true
    end
    refreshCar(true)
    if not carRoot then
        notify("Ngồi vào ghế lái trước.", "Warning", 3)
        return false
    end
    if not CarInputMod then
        CarInputMod = loadCarInput()
    end
    if not CarInputMod then
        notify("Không lấy được CarInput. executor không share module cache.", "Error", 5)
        return false
    end
    hookRead(CarInputMod)
    if CFG.KeepOff then
        setKeepOff(true)
    end
    stopReason = nil
    prevSpeed = nil
    driving = true
    return true
end

-- ESP object for a model: highlight plus box, tracer and arrow (the arrow carries the name).
-- the highlight only draws while ESP.GlobalConfig.Highlighters is on; the box, tracer and arrow are off per object by default.
local function espFor(model, name, color)
    return ESP:Add({
        Model = model,
        Name = name,
        ESPType = "Highlight",
        Color = color,
        FillColor = color,
        OutlineColor = color,
