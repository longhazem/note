    end
end

local function every(key, period, fn)
    local now = os.clock()
    if (nextAt[key] or 0) <= now then
        nextAt[key] = now + period
        local ok, err = pcall(fn)
        if not ok then
            warn("[tokaihub] " .. key .. ": " .. tostring(err))
        end
    end
end

