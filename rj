-- BEGIN TELEPORT
-- the car is moved by a hook on CarInput.Read: the wrapper runs the next job of HK.tpQueue inside the physics step, after the
-- original Read and before the car moves. a job is a placement a few studs past a point, at the car's height above the road,
-- along the road, keeping its forward speed. ImpactDetector ignores a jump longer than Detector.TeleportDistance, so it is not a crash.
-- the finish is not sent by hand: two jumps, just before and past FinishS, make the game's own lineStep send LineCross.
-- the server decides whether the progress counts: if Server mile does not move, the server did not take the jump
HK.tpDelay = 1
HK.tpQueue = {}
HK.tpNext = 0
HK.tpDone = 0
HK.tpHold = nil        -- true while the car waits at a jump's point
HK.tpFreeze = nil      -- the chassis pose the car is held at
HK.tpPlaced = nil      -- the chassis pose the last jump placed the car at
HK.fly = { on = false } -- the flying car: on, s (road position), lift, t (last step time)
HK.flySpeed = 140      -- studs per second along the road
HK.tpReady = function()
    local rc = getRunClient()
    if not rc or rc.state() ~= "Driving" or (rc.riding and rc.riding()) then
        return nil
    end
    return rc
end
HK.teleportCar = function(s, lat, ahead)
    local root, model = carRoot, carModel
    if not (root and model and model.Parent and root.Parent and carS) then
        return false
    end
    local fwd = flat(root.CFrame.LookVector)
    if fwd.Magnitude < 0.01 then
        return false
    end
    fwd = fwd.Unit
    local speed = math.max(0, flat(root.AssemblyLinearVelocity):Dot(fwd))
    local sNow, latNow = RoadPath.project(Road, root.Position.X, root.Position.Z)
    local _, yNow = RoadPath.pointAt(Road, sNow, latNow)
    local lift = root.Position.Y - yNow
    local x, y, z, dx, dz = RoadPath.pointAt(Road, clamp(s + (ahead or 0), 0, ROAD_END), lat or 0)
    local heading = Vector3.new(dx, 0, dz)
    if heading.Magnitude < 0.01 then
        heading = fwd
    end
    heading = heading.Unit
    local at = Vector3.new(x, y + lift, z)
    local goal = CFrame.lookAt(at, at + heading)
    model:PivotTo((goal * root.CFrame:Inverse()) * model:GetPivot())
    root.AssemblyLinearVelocity = heading * speed
    HK.tpPlaced = goal
    return true
end
-- the hold: the car is kept at the pose it was placed at, with no speed, until the hold time is over
HK.holdStep = function()
    local root, model = carRoot, carModel
    if not (root and model and model.Parent and HK.tpFreeze) then
        return
    end
    model:PivotTo((HK.tpFreeze * root.CFrame:Inverse()) * model:GetPivot())
    root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
    root.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
end

-- the height of the flying car at road position s: it bobs up and down while it is within 18 studs of a checkpoint,
-- so the checkpoint is passed at a height where it registers and is not missed
HK.flyLift = function(s, base)
    local lift = base
    for _, cp in ipairs(WorldCfg.Checkpoints or {}) do
        local d = s - cp
        if d > -18 and d < 18 then
            local tIn = (d + 18) / math.max(HK.flySpeed, 1)
            lift = lift + 3.5 * math.sin(2 * math.pi * 1.5 * tIn)
        end
    end
    return lift
end

-- one physics step of the flying car: it moves along the road centre and keeps its heading, with no drop
HK.flyStep = function()
    local f = HK.fly
    local root, model = carRoot, carModel
    if not (root and model and model.Parent and carS) then
        return
    end
    local now = os.clock()
    local dt = math.min(0.05, now - (f.t or now))
    f.t = now
    f.s = math.min(FINISH_S + 10, (f.s or carS) + HK.flySpeed * dt)
    local x, y, z, dx, dz = RoadPath.pointAt(Road, f.s, 0)
    local heading = Vector3.new(dx, 0, dz)
    if heading.Magnitude < 0.01 then
        return
    end
    heading = heading.Unit
    local at = Vector3.new(x, y + HK.flyLift(f.s, f.lift or 6), z)
    local goal = CFrame.lookAt(at, at + heading)
    model:PivotTo((goal * root.CFrame:Inverse()) * model:GetPivot())
    root.AssemblyLinearVelocity = heading * HK.flySpeed
    root.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
    if f.s >= FINISH_S + 8 then
        f.on = false
    end
end

-- called by the hook every physics step: flies, holds, or runs the next job of the queue once its hold is over.
-- if the car is no longer in a run, the queue is dropped
HK.tpStep = function()
    if HK.fly.on then
        HK.flyStep()
        return
    end
    if HK.tpHold then
        if os.clock() < HK.tpNext then
            HK.holdStep()
            return
        end
        HK.tpHold = nil
    end
    local q = HK.tpQueue
    if not q[1] or os.clock() < HK.tpNext then
        return
    end
    local job = q[1]
    if not HK.tpReady() or not HK.teleportCar(job.s, 0, job.ahead) then
        HK.tpQueue = {}
        return
    end
    table.remove(q, 1)
    HK.tpDone = HK.tpDone + 1
    HK.tpNext = os.clock() + (job.hold or 0)
    if (job.hold or 0) > 0 then
        HK.tpHold = true
        HK.tpFreeze = HK.tpPlaced
    end
end

-- the farm. mode 1 jumps to each checkpoint and holds there 5 to 8 seconds, then the finish; mode 2 flies the road.
-- either way the finish is crossed by the game's own lineStep, and a finished or caught run is started again
HK.farm = { on = false, mode = 1, run = nil, counted = nil, endAt = nil, runs = 0 }
HK.farmBegin = function()
    local f = HK.farm
    if f.mode == 2 then
        HK.tpQueue = {}
        HK.tpHold = nil
        HK.fly = { on = true, s = carS or 0, lift = 6, t = nil }
        return
    end
    local q = {}
    for _, cp in ipairs(WorldCfg.Checkpoints or {}) do
        table.insert(q, { s = cp, ahead = 6, hold = 5 + 3 * math.random() })
    end
    table.insert(q, { s = FINISH_S - 40, ahead = 0, hold = 0 })
    table.insert(q, { s = FINISH_S, ahead = 6, hold = 0 })
    HK.fly = { on = false }
    HK.tpHold = nil
    HK.tpQueue = q
    HK.tpNext = 0
end
HK.farmTick = function()
    local f = HK.farm
    if not f.on then
        return
    end
    local rc = getRunClient()
    if not rc then
        return
    end
    local st = rc.state()
    local now = os.clock()
    if st == "Driving" then
        local rid = rc.get("StartedAt")
        if rid ~= f.run then
            f.run = rid
            f.endAt = nil
            HK.farmBegin()
        end
        return
    end
    if st == "Finished" and f.counted ~= f.run then
        f.counted = f.run
        f.runs = f.runs + 1
    end
    if not f.endAt then
        f.endAt = now + (st == "Finished" and 4 or 2)
    end
    if now >= f.endAt then
        f.endAt = nil
        f.run = nil
        rc.requestStart(false)
    end
end
HK.farmSet = function(on)
    local f = HK.farm
    f.on = on and true or false
    f.run = nil
    f.endAt = nil
    if not f.on then
        HK.tpQueue = {}
        HK.tpHold = nil
        HK.fly = { on = false }
    end
end

HK.teleportRun = function()
    if not HK.tpReady() then
        Window:Notify({ Title = "Tokaihub", Content = "not driving, start a run first", Type = "Warning", Duration = 3 })
        return
    end
    local q = {}
    for _, s in ipairs(WorldCfg.Checkpoints or {}) do
        table.insert(q, { s = s, ahead = 6, hold = HK.tpDelay })
    end
    table.insert(q, { s = FINISH_S - 40, ahead = 0, hold = 0 })
    table.insert(q, { s = FINISH_S, ahead = 6, hold = 0 })
    HK.tpQueue = q
    HK.tpNext = 0
end
HK.teleportNext = function()
    if not HK.tpReady() or not carS then
        return
    end
    local target = FINISH_S
    for _, s in ipairs(WorldCfg.Checkpoints or {}) do
        if s > carS + 5 then
            target = s
            break
        end
    end
    HK.tpQueue = { { s = target, ahead = 6, hold = 0 } }
    HK.tpNext = 0
end
