local function snapshotLighting()
    if lightSaved then
        return
    end
    lightSaved = {
        Brightness = Lighting.Brightness,
        Ambient = Lighting.Ambient,
        OutdoorAmbient = Lighting.OutdoorAmbient,
        FogEnd = Lighting.FogEnd,
        FogStart = Lighting.FogStart,
    }
    local atm = Lighting:FindFirstChildOfClass("Atmosphere")
    if atm then
        lightSaved.atm = { Density = atm.Density, Haze = atm.Haze, Glare = atm.Glare }
    end
end

local function restoreLighting()
    if not lightSaved then
        return
    end
    for k, v in pairs(lightSaved) do
        if k ~= "atm" then
            pcall(function()
                Lighting[k] = v
            end)
        end
    end
    local atm = Lighting:FindFirstChildOfClass("Atmosphere")
    if atm and lightSaved.atm then
        atm.Density = lightSaved.atm.Density
        atm.Haze = lightSaved.atm.Haze
        atm.Glare = lightSaved.atm.Glare
    end
    lightSaved = nil
end

local function applyVisuals()
    if CFG.FullBright or CFG.NoFog then
        snapshotLighting()
    end
    if CFG.FullBright then
        Lighting.Brightness = 3
        Lighting.Ambient = Color3.fromRGB(170, 170, 170)
        Lighting.OutdoorAmbient = Color3.fromRGB(170, 170, 170)
    end
    if CFG.NoFog then
        Lighting.FogEnd = 100000
        Lighting.FogStart = 99999
        local atm = Lighting:FindFirstChildOfClass("Atmosphere")
        if atm then
            atm.Density = 0
            atm.Haze = 0
            atm.Glare = 0
        end
    end
end

