-- sideslip of the car in degrees, and its speed along the road
local function slipState()
    local look = flat(carRoot.CFrame.LookVector)
    if look.Magnitude < 0.01 then
        return 0, 0
    end
    local pos = carRoot.Position
    local s = RoadPath.project(Road, pos.X, pos.Z)
    local _, _, _, dx, dz = RoadPath.pointAt(Road, s, 0)
    local fwd = orient(look.Unit, Vector3.new(dx, 0, dz))
    local right = fwd:Cross(Vector3.yAxis)
    local v = flat(carRoot.AssemblyLinearVelocity)
    local along = v:Dot(fwd)
    local lateral = math.abs(v:Dot(right))
    return math.deg(math.atan2(lateral, math.max(math.abs(along), 1))), along
end

-- crawler pit cracks (CrawlerPit parts) and crawler bodies found in workspace. ahead on the road they are obstacles
local function crawlerScan()
    crawlerObst = {}
    crawlerNear = 0
    if not (CFG.CrawlerDodge and carS) then
        return
    end
    for _, inst in ipairs(workspace:GetDescendants()) do
        local pos = nil
        if inst.Name == "CrawlerPit" and inst:IsA("BasePart") then
            pos = inst.Position
        elseif inst.Name == "Crawler" and inst:IsA("Model") then
            pos = inst:GetPivot().Position
        end
        if pos then
            local s, lat = RoadPath.project(Road, pos.X, pos.Z)
            if s > carS - 10 and s < carS + MAP_AHEAD and math.abs(lat) < ROAD_HALF + 6 then
                table.insert(crawlerObst, { s = s, sEnd = s, lat = lat, hw = 4.6, w = W_CRAWL, stop = false, kind = inst.Name })
                if s > carS and s < carS + 200 then
                    crawlerNear = crawlerNear + 1
                end
            end
        end
    end
end

-- a fallen mast (run attributes MastDown or MastBroken, set piece config of this map) blocks the whole road at its S
local function mastCheck()
    mastObst = {}
    local rc = getRunClient()
    local m = SetPiecesCfg[MapCfg.Id]
    if not (CFG.MastAvoid and rc and m and m.Kind == "Mast") then
        return
    end
    local down = rc.get("MastDown")
    local broken = rc.get("MastBroken")
    if (type(down) == "number" and down > 0) or (type(broken) == "number" and broken > 0) then
        table.insert(mastObst, { s = m.S - 4, sEnd = m.S + 4, lat = 0, hw = ROAD_HALF, w = W_MAST, stop = false, kind = "mast" })
    end
end

local function releaseDoor()
    if doorState.held then
        doorState.held = false
        pcall(function()
            Remotes.event("DoorHold"):FireServer(false)
        end)
    end
    doorState.pending = nil
end

local function doorStep()
    local rc = getRunClient()
    if not (CFG.AutoDoor and rc) then
        releaseDoor()
        return
    end
    local phase = rc.get("CrawlerPhase")
    local mine = rc.get("CrawlerHolder") == LP.UserId
    local qteOn = rc.get("CrawlerQteOn") == true
    local qid = rc.get("CrawlerQte")
    if type(qid) ~= "number" then
        qid = 0
    end
    local act = doorAction(doorState, type(phase) == "string" and phase or "", mine, qteOn, qid, os.clock(), 0.15 + 0.25 * math.random())
    if act.key then
        pcall(function()
            Remotes.event("DoorKey"):FireServer(act.key, true)
        end)
    end
    if act.hold ~= nil then
        pcall(function()
            Remotes.event("DoorHold"):FireServer(act.hold)
        end)
    end
end

-- heartbeat: stop handling, guards, timers
table.insert(CONN, RunService.Heartbeat:Connect(function(dt)
    refreshCar(false)
    if driving and not carRoot and not stopReason then
        stopReason = "no car"
    end
    if driving and stopReason then
        local why = stopReason
        stopReason = nil
        driving = false
        setKeepOff(false)
        if why == "arrived" or why == "finish" or why == "no car" then
            dest = nil
        end
        if DriveToggle then
            DriveToggle:Set(false, true)
        end
        notify(STOP_TEXT[why] or why, why == "finish" and "Success" or "Warning", 3)
    end

    if carRoot and carRoot.Parent and carModel and carModel.Parent then
        local pos = carRoot.Position
        carS, carLat = RoadPath.project(Road, pos.X, pos.Z)
        if driving or CFG.SteerAssist then
            obstNow = buildObstacles()
        end
        local ok, err = pcall(guards, dt, carModel, carRoot)
        if not ok then
            warn("[tokaihub] guards: " .. tostring(err))
        end
        if CFG.SnapAuto and driving and math.abs(carLat) > CFG.SnapLat then
            every("snap", 1.5, function()
                snapToRoad(carModel, carRoot)
            end)
        end
    else
        carS, carLat = nil, nil
    end

    if carModel and carModel.Parent then
        CFG.LatAccel = (carModel:GetAttribute("ArcadeHandling") == false) and CFG.LatAccelSim or CFG.LatAccelArcade
    end
    if driving and carRoot and carS and CFG.CornerAdapt then
        local slip, along = slipState()
        CFG.CornerScale = adaptCornerScale(CFG.CornerScale, slip, math.abs(lastSteer), along, dt, CFG)
    end
    if driving and carRoot and carS then
        local _, along = slipState()
        if CFG.StuckFix then
            local timer, stuck = stallStep(HK.stall, along, lastThrottle > 0.2, dt)
            HK.stall = timer
            if stuck and os.clock() >= HK.unstick then
                HK.unstick = os.clock() + 1.2
                HK.stall = 0
            end
        end
        if CFG.BrakeAdapt then
            HK.brake = brakeSample(HK.brake, along, HK.along, lastBrake, lastThrottle, math.abs(lastSteer), dt)
            HK.along = along
            if HK.brake and HK.brake > 10 then
                CFG.BrakeUse = clamp(0.8 * HK.brake, 12, 90)
            end
        end
    else
        HK.along = nil
        HK.stall = 0
    end
    if driving and carRoot and os.clock() - HK.watchT >= 1 then
        if HK.calls == HK.watchN and os.clock() - HK.startT > 2 then
            stopReason = "hook"
        end
        HK.watchN = HK.calls
        HK.watchT = os.clock()
    end
    every("crawler", 0.75, crawlerScan)
    every("mast", 0.25, mastCheck)
    doorStep()
    every("mapscan", 0.25, scanMapBoxes)
    every("knocks", 0.5, function()
        scanKnocks()
        knocksAhead = 0
        if carS then
            for _, o in ipairs(knockCache) do
                local ds = o.s - carS
                if ds > 0 and ds < 150 then
                    knocksAhead = knocksAhead + 1
                end
            end
        end
    end)
    every("watchplan", 0.5, refreshWatchObst)
    every("watchmarks", 0.5, updateWatchMarkers)
    every("cars", 1, updateCarEsp)
    every("monsters", 1, updateMonsterEsp)
    every("ambush", 0.5, ambushCheck)
    every("crank", 0.1, crankStep)
    every("burn", 0.1, burnStep)
    every("vote", 0.5, voteStep)
    every("lobby", 0.5, lobbyStep)
    every("scares", 0.1, clearScares)
    every("ribbon", 0.25, function()
        if CFG.Ribbon and carS then
            ribbonStep(carS)
        end
    end)
end))

