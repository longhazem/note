-- a startup check of the library names this script calls. a UI update that removes one of them shows a notice with
-- the names, instead of a feature that silently does nothing. the check is a function, so it adds no locals to the chunk
;(function()
    local missing = {}
    local function need(obj, label, names)
        if obj == nil then
            table.insert(missing, label .. " (object missing)")
            return
        end
        for _, n in ipairs(names) do
            if type(obj[n]) ~= "function" then
                table.insert(missing, label .. ":" .. n)
            end
        end
    end
    need(HawkTokaiLib, "Library", { "CreateWindow" })
    need(Window, "Window", { "CreateTab", "Notify", "BindToggle", "OnUnload", "LoadAutoload" })
    need(SetTab, "Tab", { "CreateConfigManager", "CreateThemeManager" })
    need(Live, "Groupbox", { "CreateStatus" })
    need(ESP, "ESP", { "Add", "Clear" })
    if #missing > 0 then
        warn("[tokaihub] the UI library lacks: " .. table.concat(missing, ", "))
        if type(Window.Notify) == "function" then
            Window:Notify({ Title = "Tokaihub", Content = "the UI library lacks: " .. table.concat(missing, ", "), Type = "Error", Duration = 12 })
        end
    end
end)()
Window:LoadAutoload()
