local function updateCarEsp()
    if not CFG.CarESP then
        return
    end
    local seen = {}
    for _, d in ipairs(workspace:GetDescendants()) do
        if d:IsA("Model") and d ~= carModel then
            local chassis = d:FindFirstChild("Chassis")
            if chassis and chassis:IsA("BasePart") and d:FindFirstChild("DriverSeat", true) then
                seen[d] = true
                if not carEsp[d] then
                    carEsp[d] = espFor(d, "car " .. tostring(d:GetAttribute("CarId") or d.Name), Color3.fromRGB(255, 170, 60))
                end
            end
        end
    end
    for m, obj in pairs(carEsp) do
        if not seen[m] or not m.Parent then
            obj:Destroy()
            carEsp[m] = nil
        end
    end
end

local function clearMonsterEsp()
    for m, obj in pairs(monsterEsp) do
