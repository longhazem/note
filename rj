-- the box of a set piece in the road frame: front and back along the road, left and right across it.
-- only solid things count: a box that stays above the car, or a flat road slab, is not an obstacle
local function boxFor(inst)
    local cf, size
    if inst:IsA("Model") then
        cf, size = inst:GetBoundingBox()
    elseif inst:IsA("BasePart") then
        cf, size = inst.CFrame, inst.Size
    else
        return nil
    end
    local sMin, sMax = math.huge, -math.huge
    local latMin, latMax = math.huge, -math.huge
    local yMin, yMax = math.huge, -math.huge
    for i = 0, 7 do
        local ox = ((i % 2 == 0) and -0.5 or 0.5) * size.X
        local oy = ((math.floor(i / 2) % 2 == 0) and -0.5 or 0.5) * size.Y
        local oz = ((math.floor(i / 4) % 2 == 0) and -0.5 or 0.5) * size.Z
        local p = (cf * CFrame.new(ox, oy, oz)).Position
        local s, lat = RoadPath.project(Road, p.X, p.Z)
        if s < sMin then
            sMin = s
        end
        if s > sMax then
            sMax = s
        end
        if lat < latMin then
            latMin = lat
        end
        if lat > latMax then
            latMax = lat
        end
        if p.Y < yMin then
            yMin = p.Y
        end
        if p.Y > yMax then
            yMax = p.Y
        end
    end
    if sMax - sMin > 40 or latMax - latMin > 90 then
        return nil
    end
    if latMax < -(ROAD_HALF + 4) or latMin > ROAD_HALF + 4 then
        return nil
    end
    local jumps = WorldCfg.Jumps
    if jumps and jumps.Lateral and jumps.Length then
        local latC = (latMin + latMax) / 2
        if isRampBox(sMax - sMin, latC, jumps.Lateral, jumps.Length) then
            return { s = sMin, sEnd = sMax, lat = latC, hw = (latMax - latMin) / 2, w = 0, stop = false, kind = "ramp", ramp = true }
        end
    end
    local sMid = clamp((sMin + sMax) / 2, 0, ROAD_END)
    local latMid = clamp((latMin + latMax) / 2, -ROAD_HALF, ROAD_HALF)
    local _, roadY = RoadPath.pointAt(Road, sMid, latMid)
    if not boxAccept(sMax - sMin, latMax - latMin, yMax - roadY, yMin - roadY, yMax - yMin) then
        return nil
    end
    local fence = AreasCfg.RoadblockStyles[inst.Name] == true
    local dS, dL = sMax - sMin, latMax - latMin
    local carSized = dS >= 3.5 and dS <= 15 and dL >= 3.5 and dL <= 9
    local w = fence and W_FENCE or (carSized and W_CAR or W_BOX)
    return { s = sMin, sEnd = sMax, lat = (latMin + latMax) / 2, hw = dL / 2, w = w, stop = false, fence = fence, kind = inst.Name, sLen = dS, lLen = dL, top = yMax - roadY }
end

-- every collidable part ahead, found by a sweep of boxes along the road (not by a list of names).
-- parts of one model are one object, and boxFor keeps only the ones the car can hit
local function scanMapBoxes()
    mapBoxes = {}
    boxesAhead = 0
    if not (carS and carModel) then
        return
    end
    local params = OverlapParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude or Enum.RaycastFilterType.Blacklist
    local ex = { carModel }
    if markerFolder then
        table.insert(ex, markerFolder)
    end
    if ribbonFolder then
        table.insert(ex, ribbonFolder)
    end
    params.FilterDescendantsInstances = ex
    local mf = monstersFolder()
    local seen, count = {}, 0
    for k = 0, 3 do
        local sC = clamp(carS - 10 + k * 80 + 45, 0, ROAD_END)
        local cx, cy, cz, dx, dz = RoadPath.pointAt(Road, sC, 0)
        local at = Vector3.new(cx, cy + 6, cz)
        local cf = CFrame.lookAt(at, at + Vector3.new(dx, 0, dz))
        local parts = workspace:GetPartBoundsInBox(cf, Vector3.new(2 * ROAD_HALF + 10, 14, 90), params)
        for _, part in ipairs(parts) do
            local key = part:FindFirstAncestorOfClass("Model") or part
            if not seen[key] and count < 400 then
                seen[key] = true
                count = count + 1
                local skip = (mf ~= nil and key:IsDescendantOf(mf)) or key:GetAttribute("Knocked") or key.Name == "Crawler"
                    or key.Name == "CrawlerPit" or key:FindFirstChild("DriverSeat", true) ~= nil
                if not skip then
                    local b = boxFor(key)
                    if b and key:GetAttribute("Knock") and not (b.ramp or b.fence or ((b.top or 0) >= 2.0 and ((b.sLen or 0) >= 3.0 or (b.lLen or 0) >= 3.0))) then
                        b = nil -- a cone: the knockdown module already treats it as soft
                    end
                    if b then
                        table.insert(mapBoxes, b)
                        if b.s > carS and b.s < carS + 200 then
                            boxesAhead = boxesAhead + 1
                        end
                    end
                end
            end
        end
    end
end

