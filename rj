-- sideslip of the car in degrees, and its speed along the road
local function slipState()
    local look = flat(carRoot.CFrame.LookVector)
    if look.Magnitude < 0.01 then
        return 0, 0
    end
    local pos = carRoot.Position
    local s = RoadPath.project(Road, pos.X, pos.Z)
    local _, _, _, dx, dz = RoadPath.pointAt(Road, s, 0)
    local fwd = orient(look.Unit, Vector3.new(dx, 0, dz))
    local right = fwd:Cross(Vector3.yAxis)
    local v = flat(carRoot.AssemblyLinearVelocity)
    local along = v:Dot(fwd)
    local lateral = math.abs(v:Dot(right))
    return math.deg(math.atan2(lateral, math.max(math.abs(along), 1))), along
end

