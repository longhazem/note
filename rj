local VisBox2 = VisTab:CreateGroupbox({ Name = "Performance and road", Side = "Right" })
toggleOf(VisBox2, "Performance mode", "PerfMode", function(On)
    setPerf(On)
end, "turns 3D rendering off, the window still works")
toggleOf(VisBox2, "Centreline ribbon", "Ribbon", function(On)
    if not On then
        clearRibbon()
    end
end, "draws the road centre line around the car")
sliderOf(VisBox2, "Ribbon span", { 60, 600 }, 10, "RibbonSpan", " st")

local LobTab = Window:CreateTab({ Name = "Lobby", Icon = "map" })
local LobBox = LobTab:CreateGroupbox({ Name = "Lobby", Side = "Left" })
toggleOf(LobBox, "Walk speed", "LobbyWalkOn", nil, "walk speed while in the lobby, off the pads")
sliderOf(LobBox, "Walk speed value", { 16, 60 }, 1, "LobbyWalk")
toggleOf(LobBox, "Anti AFK", "AntiAFK", nil, "answers the idle kick")
LobBox:CreateButton({
    Name = "Start solo run",
    Desc = "the game's own solo start",
    Callback = startSolo,
})
local mapNames = {}
for k in pairs(MapCfg.PlaceIds or {}) do
    if k ~= "Lobby" then
        table.insert(mapNames, k)
    end
end
table.sort(mapNames)
local VoteBox = LobTab:CreateGroupbox({ Name = "Vote and map", Side = "Right" })
toggleOf(VoteBox, "Auto vote", "AutoVote", nil, "votes for the map screen after a run ends")
toggleOf(VoteBox, "Auto pick map", "AutoPick", nil, "picks the map below when the map screen is open")
VoteBox:CreateDropdown({
    Name = "Map",
    Options = mapNames,
    Flag = "TK_MapChoice",
    Callback = function(v)
        if type(v) == "string" then
            CFG.MapChoice = v
        end
    end,
})
VoteBox:CreateInput({
    Name = "Script URL",
    PlaceholderText = "raw link of this file",
    Flag = "TK_ScriptUrl",
    CurrentValue = "",
    Callback = function(text)
        CFG.ScriptUrl = tostring(text or "")
    end,
})
VoteBox:CreateButton({
    Name = "Queue for next teleport",
    Desc = "runs this script again after the next teleport, needs queue_on_teleport",
    Callback = queueNextMap,
})

local GasBox = LobTab:CreateGroupbox({ Name = "Driving aids", Side = "Left" })
toggleOf(GasBox, "Auto gas (game setting)", "AutoGas", function(On)
    setAutoGas(On)
end, "the game's own auto gas, saved on the server")

local ObjTab = Window:CreateTab({ Name = "Objects", Icon = "map-pin" })
local MarkBox = ObjTab:CreateGroupbox({ Name = "Route markers", Side = "Left" })
MarkBox:CreateToggle({
    Name = "Checkpoints",
    Flag = "TK_ESP_Checkpoints",
    CurrentValue = false,
    Callback = function(On)
        showGroup("cp", On)
    end,
})
MarkBox:CreateToggle({
    Name = "Finish line",
    Flag = "TK_ESP_Finish",
    CurrentValue = false,
    Callback = function(On)
        showGroup("fin", On)
    end,
})
MarkBox:CreateToggle({
    Name = "Hazards",
    Desc = "wrecks, barricades, roadblocks from the config",
    Flag = "TK_ESP_Hazards",
    CurrentValue = false,
    Callback = function(On)
        showGroup("haz", On)
    end,
})
local CarBox = ObjTab:CreateGroupbox({ Name = "Vehicles", Side = "Right" })
toggleOf(CarBox, "Other cars", "CarESP", function(On)
    if not On then
        clearCarEsp()
    end
end, "highlight, box, tracer and name for other cars")

local SetTab = Window:CreateTab({ Name = "Settings", Icon = "settings" })
SetTab:CreateConfigManager({ Side = "Left" })
SetTab:CreateThemeManager({ Side = "Right" })

Window:OnUnload(function()
    releaseDoor()
    for _, c in ipairs(CONN) do
        c:Disconnect()
    end
    setDrive(false)
    setKeepOff(false)
    unhookRead()
    setPerf(false)
    restoreLighting()
    clearRibbon()
    clearCarEsp()
    clearMonsterEsp()
    clearWatchMarkers()
    if markerFolder then
        markerFolder:Destroy()
    end
    if crankHeld then
        Remotes.event("Crank"):FireServer(false)
    end
end)

if CFG.ScriptUrl ~= "" then
    queueNextMap()
end

Window:LoadAutoload()
