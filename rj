local PROFILE_D = { 12, 25, 40, 60, 85, 115, 150, 200, 260 }

local function clamp(x, a, b)
    if x < a then
        return a
    end
    if x > b then
        return b
    end
    return x
end

local function flat(v)
    return Vector3.new(v.X, 0, v.Z)
end

-- the travel direction: the car's forward, flipped if it points against the road
local function orient(fwd, ref)
    if ref.Magnitude > 0.01 and fwd:Dot(ref) < 0 then
        return -fwd
    end
    return fwd
end

-- the highest speed the road allows from here: corner speed sqrt(LatAccel / curvature), braked into from each sample
local function speedAllowed(sCar, road, rp, cfg, roadEnd)
    local best = math.huge
    for _, d in ipairs(PROFILE_D) do
        local _, _, _, ax, az = rp.pointAt(road, clamp(sCar + d - 10, 0, roadEnd), 0)
        local _, _, _, bx, bz = rp.pointAt(road, clamp(sCar + d + 10, 0, roadEnd), 0)
        local theta = math.acos(clamp(ax * bx + az * bz, -1, 1))
        local kappa = theta / 20
        local vc = kappa > 1e-5 and math.sqrt(cfg.LatAccel / kappa) or math.huge
        local v = math.sqrt(vc * vc + 2 * cfg.BrakeDecel * math.max(0, d - 4))
        if v < best then
            best = v
        end
    end
    return best
end

-- obstacle: { s = front edge, sEnd = back edge, lat, hw (half width), w (cost), stop (brakes to 0 if blocked) }
-- the car is a rectangle of CarHalf x CarHalfLen. a lane collides with an obstacle when the car's box overlaps it
-- in the road frame, the same as Knockdown.hit does with the car's half sizes.
local function planDrive(root, dest, road, rp, cfg, finishS, roadEnd, roadHalf, obst, prevLane)
    local pos = root.Position
    local look = flat(root.CFrame.LookVector)
    if look.Magnitude < 0.01 then
        return 0, 0, 0, "no heading", prevLane, nil, 0
    end
    local fwd = look.Unit
    local v = flat(root.AssemblyLinearVelocity)
    local target, vT, lane, gapBest

    if dest then
        local toD = flat(dest - pos)
        if toD.Magnitude < cfg.ArriveDist then
            return 0, 1, 0, "arrived", prevLane, nil, 0
        end
        if v.Magnitude > 3 then
            fwd = orient(fwd, v.Unit)
        end
        target = dest
        vT = cfg.TopSpeed
        lane = prevLane
    else
        local sCar = rp.project(road, pos.X, pos.Z)
        if sCar >= finishS - 2 then
            return 0, 1, 0, "finish", prevLane, nil, 0
        end
        local _, _, _, rdx, rdz = rp.pointAt(road, sCar, 0)
        fwd = orient(fwd, Vector3.new(rdx, 0, rdz))
        local vf = math.max(0, v:Dot(fwd))
        local horizon = clamp(40 + vf * 1.2, 45, 260)
        local maxLat = math.max(0, roadHalf - cfg.CarHalf - cfg.EdgeMargin)
        local base = prevLane or cfg.LaneOffset

        -- only the obstacles that can meet the car within the horizon
        local near = {}
        for i = 1, #obst do
            local o = obst[i]
            local ds0 = o.s - sCar
            local ds1 = (o.sEnd or o.s) - sCar
            if ds1 > -cfg.CarHalfLen and ds0 < horizon then
                table.insert(near, o)
            end
        end

        local function evalLane(l)
            local cost = math.abs(l - cfg.LaneOffset) * cfg.CenterW + math.abs(l - base) * cfg.HysteresisW
            local gap, stopGap = nil, nil
            for i = 1, #near do
                local o = near[i]
                local ds0 = o.s - sCar
                if math.abs(l - o.lat) < o.hw + cfg.CarHalf + cfg.Clearance then
                    cost = cost + o.w * (0.4 + (1 - clamp(ds0 / horizon, 0, 1)))
                    local g = math.max(0, ds0 - cfg.CarHalfLen)
                    if gap == nil or g < gap then
                        gap = g
                    end
                    if o.stop and (stopGap == nil or g < stopGap) then
                        stopGap = g
                    end
                end
            end
            return cost, gap, stopGap
        end

        local bestCost, gapA, stopA = evalLane(cfg.LaneOffset)
        lane = cfg.LaneOffset
        gapBest = gapA
        local stopBest = stopA
        for k = -maxLat, maxLat, 0.5 do
            local c, g, sg = evalLane(k)
            if c < bestCost then
                bestCost = c
                lane = k
                gapBest = g
                stopBest = sg
            end
        end

        local aheadS = clamp(sCar + cfg.LookAhead + vf * 0.45, 0, roadEnd)
        local tx, ty, tz = rp.pointAt(road, aheadS, lane)
        target = Vector3.new(tx, ty, tz)

        vT = math.min(cfg.TopSpeed, speedAllowed(sCar, road, rp, cfg, roadEnd))
        -- the chosen lane is still blocked: pits stop the car, anything else is taken at crawl speed
        if stopBest then
            vT = math.min(vT, math.sqrt(math.max(0, 2 * cfg.BrakeDecel * (stopBest - cfg.StopGap))))
        elseif gapBest then
            vT = math.min(vT, math.max(cfg.CrawlSpeed, math.sqrt(math.max(0, 2 * cfg.BrakeDecel * (gapBest - cfg.StopGap)))))
        end
    end

    local toT = flat(target - pos)
    local dist = toT.Magnitude
    local dir = dist > 0.01 and toT / dist or fwd
    local right = fwd:Cross(Vector3.yAxis)
    local front = dir:Dot(fwd)
    local side = dir:Dot(right)
    local steer = clamp(math.atan2(side, front) * cfg.SteerGain, -1, 1)

    if front < 0 then
        vT = math.min(vT, 6)
    end
    if dest then
        vT = math.min(vT, math.max(3, dist * 0.6))
    end

    local speed = v:Dot(fwd)
    local throttle, brake = 0, 0
    if speed < vT - 2 then
        throttle = clamp((vT - speed) / 12, 0.25, 1)
    elseif speed > vT + 1.5 then
        brake = clamp((speed - vT) / 10, 0, 1)
    end
    return throttle, brake, steer, "drive", lane, gapBest, vT
end

-- RoadKeep.steer replacement: the same zeroing the game does when RoadKeep is not in use
local function keepOffSteer(cfg, keep)
    if keep then
        keep.keepSteer = 0
        keep.keepPush = Vector3.new(0, 0, 0)
        keep.keepExcess = 0
    end
    return 0
end

-- lane keep on manual driving. user = the player's steer, returns the blended steer
local function assistSteerPure(user, lat, headingErr, cfg, gain)
    local latErr = lat - cfg.LaneOffset
    local corr = (-latErr * 0.1 + headingErr) * cfg.AssistGain
    return clamp(user + corr * gain, -1, 1)
end

-- the yaw / pitch the game sends to FlashAim, from a chassis-local direction
local function aimYawPitch(dir)
    local yaw = math.deg(math.atan2(-dir.X, -dir.Z))
    local pitch = math.deg(math.asin(clamp(dir.Y, -1, 1)))
    return math.floor(yaw + 0.5), math.floor(pitch + 0.5)
end

-- speed to put back after a sudden loss without braking
local function impactRestore(prevSpeed, speed, brake, cfg)
    if prevSpeed == nil or brake > 0.2 then
        return 0
    end
    local drop = prevSpeed - speed
    if drop > cfg.ImpactDrop then
        return drop * cfg.ImpactKeep
    end
    return 0
end

-- forward push for pace assist this frame
local function paceAdd(speed, throttle, brake, cfg, dt)
    if throttle < 0.3 or brake > 0.05 or speed >= cfg.PaceTarget then
        return 0
    end
    return math.min(cfg.PaceBoost * dt, cfg.PaceTarget - speed)
end
