-- route markers: ESP objects on invisible anchored parts, placed by the same road the car follows.
-- their tags are rewritten by MARK.update, so each one shows its distance and side from the car
local function buildMarkers()
    if markersBuilt then
        return
    end
    markersBuilt = true
    markerFolder = Instance.new("Folder")
    markerFolder.Name = "TokaiMarkers"
    markerFolder.Parent = workspace

    local function mark(group, s, lat, label, color)
        local x, y, z = RoadPath.pointAt(Road, clamp(s, 0, ROAD_END), lat or 0)
        local part = Instance.new("Part")
        part.Name = label
        part.Size = Vector3.new(1, 1, 1)
        part.Transparency = 1
        part.Anchored = true
        part.CanCollide = false
        part.CanTouch = false
        part.CanQuery = false
        part.CFrame = CFrame.new(x, y + 5, z)
        part.Parent = markerFolder
        local obj = ESP:Add({
            Model = part,
            Name = label,
            ESPType = "Text",
            Color = color,
            MaxDistance = 4000,
            Arrow = { Enabled = true, Color = color, CenterOffset = 300, Size = 12 },
        })
        obj:Hide()
        table.insert(MARK[group], obj)
        MARK.items[obj] = { name = label, s = s, pos = part.Position }
    end

    for i, s in ipairs(WorldCfg.Checkpoints or {}) do
        mark("cp", s, 0, "checkpoint " .. i, Color3.fromRGB(90, 200, 255))
    end
    mark("fin", FINISH_S, 0, "finish", Color3.fromRGB(120, 255, 120))
    for _, w in ipairs(WorldCfg.Wrecks or {}) do
        mark("haz", w[1], w[2], "wreck", Color3.fromRGB(255, 90, 90))
    end
    for _, b in ipairs(WorldCfg.Barricades or {}) do
        mark("haz", b[1], b[2], "barricade", Color3.fromRGB(255, 140, 60))
    end
    for _, r in ipairs(WorldCfg.Roadblocks or {}) do
        mark("haz", r[1], 0, "roadblock " .. tostring(r[2]), Color3.fromRGB(255, 90, 90))
    end
    local avSpots = WorldCfg.Avalanches and WorldCfg.Avalanches.Spots or {}
    for _, a in ipairs(avSpots) do
        local side = (a[2] or 1) < 0 and -1 or 1
        mark("av", a[1], side * (ROAD_HALF + 4), "avalanche from " .. (side < 0 and "left" or "right"), Color3.fromRGB(190, 230, 255))
    end
    for _, pad in ipairs(WorldCfg.Pads or {}) do
        if typeof(pad.fromS) == "number" and typeof(pad.toS) == "number" then
            mark("pad", (pad.fromS + pad.toS) / 2, 0, "pad " .. tostring(pad.name or "?"), Color3.fromRGB(255, 230, 120))
        end
    end
end

-- live tags: the label of every marker, monster, car and planned watcher, four times a second.
-- each shows what it is, its distance from the car in studs and its side; a road marker also shows the time to reach it
MARK.update = function()
    if not (carRoot and carRoot.Parent and carS) then
        return
    end
    local cp = carRoot.Position
    local look = carRoot.CFrame.LookVector
    local spd = carRoot.AssemblyLinearVelocity.Magnitude
    local function tag(name, pos, sRoad, extra)
        local dv = pos - cp
        local side
        if sRoad then
            local ds = sRoad - carS
            if math.abs(ds) < 12 then
                side = "here"
            elseif ds > 0 then
                side = "ahead"
            else
                side = "behind"
            end
            if ds > 12 then
                extra = math.floor(ds / math.max(spd, 5) + 0.5) .. " s to it"
            end
        else
            side = dv:Dot(look) >= 0 and "ahead" or "behind"
        end
        local text = name .. "  " .. math.floor(dv.Magnitude + 0.5) .. " st " .. side
        if extra then
            text = text .. "  " .. extra
        end
        return text
    end
    for obj, it in pairs(MARK.items) do
        if not obj.Deleted then
            obj.CurrentSettings.Name = tag(it.name, it.pos, it.s)
        end
    end
    for m, obj in pairs(monsterEsp) do
        if m.Parent and not obj.Deleted then
            local st = m:GetAttribute("State")
            local label = st and (m.Name .. "  " .. tostring(st)) or m.Name
            obj.CurrentSettings.Name = tag(label, m:GetPivot().Position, nil)
        end
    end
    for d, obj in pairs(carEsp) do
        local chassis = d.Parent and d:FindFirstChild("Chassis")
        if chassis and not obj.Deleted then
            local kmh = math.floor(chassis.AssemblyLinearVelocity.Magnitude + 0.5)
            obj.CurrentSettings.Name = tag("car " .. tostring(d:GetAttribute("CarId") or d.Name), chassis.Position, nil, kmh .. " st/s")
        end
    end
    for _, entry in pairs(watchMarkers) do
        if entry.obj and not entry.obj.Deleted then
            entry.obj.CurrentSettings.Name = tag("watcher " .. tostring(entry.kind or "?") .. " (planned)", entry.part.Position, entry.s)
        end
    end
end

-- the next route marker ahead, and the nearest monster, worded the same way as their tags
MARK.next = function()
    if not carS then
        return "<Muted>no car</Muted>"
    end
    local best, bestDs = nil, math.huge
    for obj, it in pairs(MARK.items) do
        local ds = it.s - carS
        if not obj.Deleted and ds > 0 and ds < bestDs then
            best, bestDs = it, ds
        end
    end
    if not best then
        return "<Muted>none ahead</Muted>"
    end
    return string.format("%s  %d st ahead", best.name, math.floor(bestDs + 0.5))
end

MARK.nearest = function()
    if not (carRoot and carRoot.Parent) then
        return "<Muted>no car</Muted>"
    end
    local bestD, bestLabel = math.huge, nil
    for m, obj in pairs(monsterEsp) do
        if m.Parent and not obj.Deleted then
            local d = (m:GetPivot().Position - carRoot.Position).Magnitude
            if d < bestD then
                bestD = d
                bestLabel = obj.CurrentSettings.Name
            end
        end
    end
    if not bestLabel then
        return "<Success>none</Success>"
    end
    return "<Warning>" .. bestLabel .. "</Warning>"
end

