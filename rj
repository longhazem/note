-- BEGIN LOGIC
local function clamp(x, a, b)
    if x < a then
        return a
    end
    if x > b then
        return b
    end
    return x
end

local function flat(v)
    return Vector3.new(v.X, 0, v.Z)
end

-- pick the travel direction: the car's own forward, flipped if it points against the road
local function orient(fwd, ref)
    if ref.Magnitude > 0.01 and fwd:Dot(ref) < 0 then
        return -fwd
    end
    return fwd
end

-- config row {s, lat, width?} -> obstacle. roadblock rows have no lateral, so they take the middle
local function rowObstacle(row, kind)
    local lat = row[2]
    local hw = math.max(2.5, math.abs(row[3] or 6) / 2)
    if kind == "roadblock" then
        lat = 0
        hw = 2.5
    end
    return { s = row[1], lat = lat, hw = hw, kind = kind }
end

-- auto drive on the road. returns throttle, brake, steer, reason, lane, nearest hit ahead in the chosen lane
local function planDrive(root, dest, road, rp, cfg, finishS, roadEnd, roadHalf, obst, prevLane)
    local pos = root.Position
    local look = flat(root.CFrame.LookVector)
    if look.Magnitude < 0.01 then
        return 0, 0, 0, "no heading", prevLane, nil
    end
    local fwd = look.Unit
    local v = flat(root.AssemblyLinearVelocity)
    local target, vT, lane, hit
    local sCar = nil
    local rdx, rdz = 0, 0

    if dest then
        local toD = flat(dest - pos)
        if toD.Magnitude < cfg.ArriveDist then
            return 0, 1, 0, "arrived", prevLane, nil
        end
        if v.Magnitude > 3 then
            fwd = orient(fwd, v.Unit)
        end
        target = dest
        vT = cfg.TopSpeed
        lane = prevLane
    else
        sCar = rp.project(road, pos.X, pos.Z)
        if sCar >= finishS - 2 then
            return 0, 1, 0, "finish", prevLane, nil
        end
        local _, _, _, dx, dz = rp.pointAt(road, sCar, 0)
        rdx, rdz = dx, dz
        fwd = orient(fwd, Vector3.new(rdx, 0, rdz))
        local vf = math.max(0, v:Dot(fwd))
        local horizon = clamp(40 + vf * 1.2, 45, 240)
        local maxLat = math.max(0, roadHalf - cfg.CarHalf - cfg.EdgeMargin)
        local base = prevLane or cfg.LaneOffset

        local function evalLane(l)
            local cost = math.abs(l - cfg.LaneOffset) * cfg.CenterW + math.abs(l - base) * cfg.HysteresisW
            local near = nil
            for i = 1, #obst do
                local o = obst[i]
                local ds = o.s - sCar
                if ds > -cfg.PassBack and ds < horizon then
                    if math.abs(l - o.lat) < o.hw + cfg.CarHalf + cfg.Clearance then
                        cost = cost + cfg.HitW * (0.4 + (1 - clamp(ds / horizon, 0, 1)))
                        if ds > 0 and (near == nil or ds < near) then
                            near = ds
                        end
                    end
                end
            end
            return cost, near
        end

        local bestCost, hitBest = evalLane(cfg.LaneOffset)
        lane = cfg.LaneOffset
        hit = hitBest
        for k = -maxLat, maxLat, 1 do
            local c, h = evalLane(k)
            if c < bestCost then
                bestCost = c
                lane = k
                hit = h
            end
        end

        local aheadS = clamp(sCar + cfg.LookAhead + vf * 0.45, 0, roadEnd)
        local tx, ty, tz = rp.pointAt(road, aheadS, lane)
        target = Vector3.new(tx, ty, tz)

        local _, _, _, bdx, bdz = rp.pointAt(road, clamp(sCar + math.max(20, vf * 2), 0, roadEnd), 0)
        local bend = 1 - (rdx * bdx + rdz * bdz)
        vT = cfg.TopSpeed * clamp(1 - bend * cfg.CornerK, 0.3, 1)
        if hit then
            vT = math.min(vT, math.sqrt(math.max(0, 2 * cfg.BrakeDecel * (hit - cfg.StopGap))))
        end
    end

    local toT = flat(target - pos)
    local dist = toT.Magnitude
    local dir = dist > 0.01 and toT / dist or fwd
    local right = fwd:Cross(Vector3.yAxis)
    local front = dir:Dot(fwd)
    local side = dir:Dot(right)
    local steer = clamp(math.atan2(side, front) * cfg.SteerGain, -1, 1)

    if front < 0 then
        vT = math.min(vT, 6)
    end
    if dest then
        vT = math.min(vT, math.max(3, dist * 0.6))
    end
    vT = vT * clamp(1 - math.abs(steer) * 0.35, 0.5, 1)

    local speed = v:Dot(fwd)
    local throttle, brake = 0, 0
    if speed < vT - 2 then
        throttle = clamp((vT - speed) / 12, 0.25, 1)
    elseif speed > vT + 2 then
        brake = clamp((speed - vT) / 15, 0, 1)
    end
    return throttle, brake, steer, "drive", lane, hit
end

-- lane keep on manual driving. user = the player's steer, returns the blended steer
local function assistSteerPure(user, lat, headingErr, cfg, gain)
    local latErr = lat - cfg.LaneOffset
    local corr = (-latErr * 0.1 + headingErr) * cfg.AssistGain
    return clamp(user + corr * gain, -1, 1)
end

-- the same yaw / pitch the game sends to FlashAim, from a chassis-local direction
local function aimYawPitch(dir)
    local yaw = math.deg(math.atan2(-dir.X, -dir.Z))
    local pitch = math.deg(math.asin(clamp(dir.Y, -1, 1)))
    return math.floor(yaw + 0.5), math.floor(pitch + 0.5)
end

-- velocity to put back after a sudden loss without braking
local function impactRestore(prevSpeed, speed, brake, cfg)
    if prevSpeed == nil or brake > 0.2 then
        return 0
    end
    local drop = prevSpeed - speed
    if drop > cfg.ImpactDrop then
        return drop * cfg.ImpactKeep
    end
    return 0
end

-- forward push for pace assist this frame
local function paceAdd(speed, throttle, brake, cfg, dt)
    if throttle < 0.3 or brake > 0.05 or speed >= cfg.PaceTarget then
        return 0
    end
    return math.min(cfg.PaceBoost * dt, cfg.PaceTarget - speed)
end
