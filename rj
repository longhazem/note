-- heartbeat: stop handling, guards, timers
table.insert(CONN, RunService.Heartbeat:Connect(function(dt)
    refreshCar(false)
    if driving and not carRoot and not stopReason then
        stopReason = "no car"
    end
    if driving and stopReason then
        local why = stopReason
        stopReason = nil
        driving = false
        if why == "arrived" or why == "finish" or why == "no car" then
            dest = nil
        end
        if DriveToggle then
            DriveToggle:Set(false, true)
        end
        notify(STOP_TEXT[why] or why, why == "finish" and "Success" or "Warning", 3)
    end

    if carRoot and carRoot.Parent and carModel and carModel.Parent then
        local pos = carRoot.Position
        carS, carLat = RoadPath.project(Road, pos.X, pos.Z)
        if driving or CFG.SteerAssist then
            obstNow = buildObstacles()
        end
        local ok, err = pcall(guards, dt, carModel, carRoot)
        if not ok then
            warn("[tokaihub] guards: " .. tostring(err))
        end
        if CFG.SnapAuto and driving and math.abs(carLat) > CFG.SnapLat then
            every("snap", 1.5, function()
                snapToRoad(carModel, carRoot)
            end)
        end
    else
        carS, carLat = nil, nil
    end

    every("cars", 1, updateCarEsp)
    every("monsters", 1, updateMonsterEsp)
    every("ambush", 0.5, ambushCheck)
    every("crank", 0.1, crankStep)
    every("burn", 0.1, burnStep)
    every("vote", 0.5, voteStep)
    every("lobby", 0.5, lobbyStep)
    every("scares", 0.1, clearScares)
    every("ribbon", 0.25, function()
        if CFG.Ribbon and carS then
            ribbonStep(carS)
        end
    end)
end))

