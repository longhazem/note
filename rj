toggleOf(LobBox, "Anti AFK", "AntiAFK", nil, "answers the idle kick")
LobBox:CreateButton({
    Name = "Start solo run",
    Desc = "the game's own solo start",
    Callback = startSolo,
})
local mapNames = {}
for k in pairs(MapCfg.PlaceIds or {}) do
    if k ~= "Lobby" then
        table.insert(mapNames, k)
    end
end
table.sort(mapNames)
local VoteBox = LobTab:CreateGroupbox({ Name = "Vote and map", Side = "Right" })
toggleOf(VoteBox, "Auto vote", "AutoVote", nil, "votes for the map screen after a run ends")
toggleOf(VoteBox, "Auto pick map", "AutoPick", nil, "picks the map below when the map screen is open")
VoteBox:CreateDropdown({
    Name = "Map",
    Options = mapNames,
    Flag = "TK_MapChoice",
    Callback = function(v)
        if type(v) == "string" then
            CFG.MapChoice = v
        end
    end,
})
VoteBox:CreateInput({
    Name = "Script URL",
    PlaceholderText = "raw link of this file",
    Flag = "TK_ScriptUrl",
    CurrentValue = "",
    Callback = function(text)
        CFG.ScriptUrl = tostring(text or "")
    end,
})
VoteBox:CreateButton({
    Name = "Queue for next teleport",
    Desc = "runs this script again after the next teleport, needs queue_on_teleport",
    Callback = queueNextMap,
})

local ObjTab = Window:CreateTab({ Name = "Objects", Icon = "map-pin" })
local MarkBox = ObjTab:CreateGroupbox({ Name = "Route markers", Side = "Left" })
MarkBox:CreateToggle({
    Name = "Checkpoints",
    Flag = "TK_ESP_Checkpoints",
    CurrentValue = false,
    Callback = function(On)
        showGroup("cp", On)
    end,
})
MarkBox:CreateToggle({
    Name = "Finish line",
    Flag = "TK_ESP_Finish",
    CurrentValue = false,
    Callback = function(On)
        showGroup("fin", On)
    end,
})
MarkBox:CreateToggle({
    Name = "Hazards",
    Desc = "wrecks, barricades, roadblocks",
    Flag = "TK_ESP_Hazards",
    CurrentValue = false,
    Callback = function(On)
        showGroup("haz", On)
    end,
})
local CarBox = ObjTab:CreateGroupbox({ Name = "Vehicles", Side = "Right" })
toggleOf(CarBox, "Other cars", "CarESP", function(On)
    if not On then
        clearCarEsp()
    end
end, "highlight, box, tracer and name for other cars")

local SetTab = Window:CreateTab({ Name = "Settings", Icon = "settings" })
SetTab:CreateConfigManager({ Side = "Left" })
SetTab:CreateThemeManager({ Side = "Right" })

Window:OnUnload(function()
    for _, c in ipairs(CONN) do
        c:Disconnect()
    end
    setDrive(false)
    setKeepOff(false)
    unhookRead()
    setPerf(false)
    restoreLighting()
    clearRibbon()
    clearCarEsp()
    clearMonsterEsp()
    if markerFolder then
        markerFolder:Destroy()
    end
    if crankHeld then
        Remotes.event("Crank"):FireServer(false)
    end
end)

if CFG.ScriptUrl ~= "" then
    queueNextMap()
end

Window:LoadAutoload()
