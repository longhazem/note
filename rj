    end
    for _, o in ipairs(mapBoxes) do
        table.insert(out, o)
    end
    for _, o in ipairs(crawlerObst) do
        table.insert(out, o)
    end
    for _, o in ipairs(mastObst) do
        table.insert(out, o)
    end
    for _, o in ipairs(watchObst) do
