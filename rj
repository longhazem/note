local function setKeepOff(on)
    if not RoadKeepMod then
        local ok, t = pcall(require, Shared.Rules.Rally.RoadKeep)
        if ok and type(t) == "table" then
            RoadKeepMod = t
        end
    end
    if not RoadKeepMod then
        return
    end
    if on then
        if RoadKeepMod.steer ~= keepOffSteer then
            keepSteerOrig = RoadKeepMod.steer
            RoadKeepMod.steer = keepOffSteer
        end
    elseif keepSteerOrig then
        RoadKeepMod.steer = keepSteerOrig
        keepSteerOrig = nil
    end
end

local function uprightCar(model, root)
    local base = root.Position + Vector3.new(0, 4, 0)
    local look = flat(root.CFrame.LookVector)
    if look.Magnitude < 0.01 then
        look = Vector3.new(0, 0, -1)
    end
    model:PivotTo(CFrame.lookAt(base, base + look.Unit))
    root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
    root.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
end

-- move the whole car onto the road centre, facing along the road, keeping its speed along the road
local function snapToRoad(model, root)
    local pos = root.Position
    local s = RoadPath.project(Road, pos.X, pos.Z)
    local cx, cy, cz, dx, dz = RoadPath.pointAt(Road, s, 0)
    local rd = Vector3.new(dx, 0, dz)
    local look = flat(root.CFrame.LookVector)
    local sign = 1
    if look.Magnitude > 0.01 and look.Unit:Dot(rd) < 0 then
        sign = -1
    end
    local h = CarCfg.RideHeight or 2
    local at = Vector3.new(cx, cy + h, cz)
    local rel = root.CFrame:ToObjectSpace(model:GetPivot())
    model:PivotTo(CFrame.lookAt(at, at + rd * sign) * rel)
    local along = math.max(0, root.AssemblyLinearVelocity:Dot(rd * sign))
    root.AssemblyLinearVelocity = rd * sign * along
    root.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
end

-- anti tumble, impact guard, pace, grip, yaw clamp. every heartbeat, on the chassis
local function guards(dt, model, root)
    if CFG.AntiTumble then
        if root.CFrame.UpVector.Y < CFG.TumbleUpY then
            tumbleT = tumbleT + dt
            if tumbleT > CFG.TumbleTime then
                tumbleT = 0
                uprightCar(model, root)
                return
            end
        else
            tumbleT = 0
        end
    end

    local look = flat(root.CFrame.LookVector)
    if look.Magnitude < 0.01 then
        return
    end
    local pos = root.Position
    local s = RoadPath.project(Road, pos.X, pos.Z)
    local _, _, _, dx, dz = RoadPath.pointAt(Road, s, 0)
    local fwd = orient(look.Unit, Vector3.new(dx, 0, dz))

    local vel = root.AssemblyLinearVelocity
    local speed = flat(vel):Dot(fwd)

    if CFG.ImpactGuard then
        local back = impactRestore(prevSpeed, speed, lastBrake, CFG)
        if back > 0 then
            root.AssemblyLinearVelocity = vel + fwd * back
            speed = speed + back
        end
    end
    prevSpeed = speed

    if CFG.PaceAssist then
        local add = paceAdd(speed, lastThrottle, lastBrake, CFG, dt, lastSteer)
        if add > 0 then
            root.AssemblyLinearVelocity = root.AssemblyLinearVelocity + fwd * add
        end
    end

    if CFG.Grip > 0 and math.abs(lastSteer) < 0.25 then
        local v2 = root.AssemblyLinearVelocity
        local right = fwd:Cross(Vector3.yAxis)
        local latV = right * v2:Dot(right)
        local damp = clamp(CFG.Grip * dt * 4, 0, 0.5)
        root.AssemblyLinearVelocity = v2 - latV * damp
    end

    if CFG.YawClamp then
        local w = root.AssemblyAngularVelocity
        if math.abs(w.Y) > CFG.MaxYawRate then
            root.AssemblyAngularVelocity = Vector3.new(w.X, clamp(w.Y, -CFG.MaxYawRate, CFG.MaxYawRate), w.Z)
        end
    end
end

-- the value CarController reads this physics step
local HK = { calls = 0, lastT = os.clock(), dt = 0.02, steer = 0, unstick = 0, startT = 0, watchT = 0, watchN = 0, brake = nil, along = nil, stall = 0, rateN = 0, rateT = os.clock() }

local function computeAssist(st)
    if carRoot == nil or carRoot.Parent == nil then
        return nil
    end
    if driving then
        local t, b, steer, reason, lane, gap, vt = planDrive(carRoot, dest, Road, RoadPath, CFG, FINISH_S, ROAD_END, ROAD_HALF, obstNow, prevLane)
        if lane ~= nil then
            prevLane = lane
        end
        lastHit = gap
        lastVT = vt
        if reason ~= "drive" then
            stopReason = reason
        end
        if os.clock() < HK.unstick then
            return 0.6, 0, clamp(-steer, -1, 1)
        end
        return t, b, steer
    end
    if CFG.SteerAssist then
        local pos = carRoot.Position
        local s, lat = RoadPath.project(Road, pos.X, pos.Z)
        local _, _, _, dx, dz = RoadPath.pointAt(Road, s, 0)
        local rd = Vector3.new(dx, 0, dz)
        local look = flat(carRoot.CFrame.LookVector)
        if look.Magnitude < 0.01 then
            return nil
        end
        local fwd = orient(look.Unit, rd)
        local right = fwd:Cross(Vector3.yAxis)
        local headingErr = math.atan2(rd:Dot(right), rd:Dot(fwd))
        local gain = math.abs(st.Steer) < 0.05 and CFG.ReturnGain or 0.35
        return st.Throttle, st.Brake, assistSteerPure(st.Steer, lat, headingErr, CFG, gain)
    end
    return nil
end

local function hookRead(ci)
    if readHooked then
        return
    end
    readHooked = true
    CarInputMod = ci
    origRead = ci.Read
    ci.Read = function(p86)
        HK.calls = HK.calls + 1
        local tNow = os.clock()
        HK.dt = clamp(tNow - HK.lastT, 0.002, 0.1)
        HK.lastT = tNow
        local st = origRead(p86)
        if type(st) ~= "table" then
            return st
        end
        if not p86 then
            local ok, t, b, steer = pcall(computeAssist, st)
            if ok then
                if t ~= nil then
                    st.Throttle = t
                    st.Brake = b
                    st.Steer = driving and rateLimit(HK.steer, steer, CFG.SteerRate, HK.dt) or steer
                    HK.steer = st.Steer
                    if driving then
                        st.Handbrake = false
                    end
                end
            else
                warn("[tokaihub] assist: " .. tostring(t))
            end
        end
        lastThrottle, lastBrake, lastSteer = st.Throttle, st.Brake, st.Steer
        return st
    end
end

local function unhookRead()
    if readHooked and CarInputMod and origRead then
        CarInputMod.Read = origRead
    end
    readHooked = false
end

local function setDrive(on)
    if not on then
        driving = false
        setKeepOff(false)
        return true
    end
    refreshCar(true)
    if not carRoot then
        notify("Ngồi vào ghế lái trước.", "Warning", 3)
        return false
    end
    if not CarInputMod then
        CarInputMod = loadCarInput()
    end
    if not CarInputMod then
        notify("Không lấy được CarInput. executor không share module cache.", "Error", 5)
        return false
    end
    hookRead(CarInputMod)
    if CFG.KeepOff then
        setKeepOff(true)
    end
    stopReason = nil
    prevSpeed = nil
    driving = true
    HK.startT = os.clock()
    HK.watchT = os.clock()
    HK.watchN = HK.calls
    return true
end

-- ESP object for a model: highlight plus box, tracer and arrow (the arrow carries the name).
-- the highlight draws only while ESP.GlobalConfig.Highlighters is on; box, tracer and arrow are off per object by default
local function espFor(model, name, color, range)
    return ESP:Add({
        Model = model,
        Name = name,
        ESPType = "Highlight",
        Color = color,
        FillColor = color,
        OutlineColor = color,
        FillTransparency = 0.6,
        OutlineTransparency = 0,
        MaxDistance = range or 6000,
        Box2D = { Enabled = true, Color = color, Thickness = 1, Transparency = 0, Filled = false, Style = "Full" },
        Tracer = { Enabled = true, Color = color, Thickness = 1, Transparency = 0, From = "Bottom", To = "Feet" },
        Arrow = { Enabled = true, Color = color, CenterOffset = 300, Size = 12 },
    })
end

-- route markers: ESP objects on invisible anchored parts, placed by the same road the car follows
local function buildMarkers()
    if markersBuilt then
        return
    end
    markersBuilt = true
    markerFolder = Instance.new("Folder")
    markerFolder.Name = "TokaiMarkers"
    markerFolder.Parent = workspace

    local function mark(group, s, lat, label, color)
        local x, y, z = RoadPath.pointAt(Road, clamp(s, 0, ROAD_END), lat or 0)
        local part = Instance.new("Part")
        part.Name = label
        part.Size = Vector3.new(1, 1, 1)
        part.Transparency = 1
        part.Anchored = true
        part.CanCollide = false
        part.CanTouch = false
        part.CanQuery = false
        part.CFrame = CFrame.new(x, y + 5, z)
        part.Parent = markerFolder
        local obj = ESP:Add({
            Model = part,
            Name = label,
            ESPType = "Text",
            Color = color,
            MaxDistance = 4000,
            Arrow = { Enabled = true, Color = color, CenterOffset = 300, Size = 12 },
        })
        obj:Hide()
        table.insert(MARK[group], obj)
    end

    for i, s in ipairs(WorldCfg.Checkpoints or {}) do
        mark("cp", s, 0, "CP" .. i .. "  s " .. math.floor(s), Color3.fromRGB(90, 200, 255))
    end
    mark("fin", FINISH_S, 0, "FINISH  s " .. math.floor(FINISH_S), Color3.fromRGB(120, 255, 120))
    for _, w in ipairs(WorldCfg.Wrecks or {}) do
        mark("haz", w[1], w[2], "wreck  s " .. math.floor(w[1]), Color3.fromRGB(255, 90, 90))
    end
    for _, b in ipairs(WorldCfg.Barricades or {}) do
        mark("haz", b[1], b[2], "barricade  s " .. math.floor(b[1]), Color3.fromRGB(255, 140, 60))
    end
    for _, r in ipairs(WorldCfg.Roadblocks or {}) do
        mark("haz", r[1], 0, tostring(r[2]) .. "  s " .. math.floor(r[1]), Color3.fromRGB(255, 90, 90))
    end
end

local function showGroup(group, on)
    buildMarkers()
    for _, obj in ipairs(MARK[group]) do
        if on then
            obj:Show()
        else
            obj:Hide()
        end
    end
end

-- watchers planned on the road ahead: a marker per watcher that is still to spawn, placed where it will stand
local function clearWatchMarkers()
    for i, entry in pairs(watchMarkers) do
        entry.obj:Destroy()
        entry.part:Destroy()
        watchMarkers[i] = nil
    end
end

local function updateWatchMarkers()
    if not CFG.WatcherESP or not carS then
        clearWatchMarkers()
        return
    end
    local plan = getWatchPlan()
    for i, w in ipairs(plan) do
        local inRange = w.s > carS - 10 and w.s < carS + CFG.WatcherAhead
        local entry = watchMarkers[i]
        if inRange and not entry then
            local x, y, z = RoadPath.pointAt(Road, clamp(w.s, 0, ROAD_END), w.lateral or 0)
            local part = Instance.new("Part")
            part.Name = "planned " .. tostring(w.kind)
            part.Size = Vector3.new(1, 1, 1)
            part.Transparency = 1
            part.Anchored = true
            part.CanCollide = false
            part.CanTouch = false
            part.CanQuery = false
            part.CFrame = CFrame.new(x, y + 3, z)
            part.Parent = markerFolder or workspace
            local obj = ESP:Add({
                Model = part,
                Name = tostring(w.kind or "Watcher") .. "  " .. math.floor(w.s) .. " s",
                ESPType = "Text",
                Color = Color3.fromRGB(255, 220, 90),
                MaxDistance = CFG.WatcherAhead + 200,
                Arrow = { Enabled = true, Color = Color3.fromRGB(255, 220, 90), CenterOffset = 300, Size = 12 },
            })
            watchMarkers[i] = { part = part, obj = obj }
        elseif entry and not inRange then
            entry.obj:Destroy()
            entry.part:Destroy()
            watchMarkers[i] = nil
        end
    end
end

local function setWatcherEsp(on)
    CFG.WatcherESP = on
    if not on then
        clearWatchMarkers()
    end
end

local function clearCarEsp()
    for m, obj in pairs(carEsp) do
        obj:Destroy()
        carEsp[m] = nil
    end
end

local function updateCarEsp()
    if not CFG.CarESP then
        return
    end
    local seen = {}
    for _, d in ipairs(workspace:GetDescendants()) do
        if d:IsA("Model") and d ~= carModel then
            local chassis = d:FindFirstChild("Chassis")
            if chassis and chassis:IsA("BasePart") and d:FindFirstChild("DriverSeat", true) then
                seen[d] = true
                if not carEsp[d] then
                    carEsp[d] = espFor(d, "car " .. tostring(d:GetAttribute("CarId") or d.Name), Color3.fromRGB(255, 170, 60))
                end
            end
        end
    end
    for m, obj in pairs(carEsp) do
        if not seen[m] or not m.Parent then
            obj:Destroy()
            carEsp[m] = nil
        end
    end
end

local function clearMonsterEsp()
    for m, obj in pairs(monsterEsp) do
        obj:Destroy()
        monsterEsp[m] = nil
    end
end

-- every live monster: any model in ClientMonsters, named by its kind (Runner, Watcher, Hooded, Ambusher, Steeple, ...)
local function updateMonsterEsp()
    if not CFG.MonsterESP then
        return
    end
    local seen = {}
    local folder = monstersFolder()
    if folder then
        for _, m in ipairs(folder:GetChildren()) do
            if m:IsA("Model") then
                seen[m] = true
                if not monsterEsp[m] then
                    monsterEsp[m] = espFor(m, m.Name, Color3.fromRGB(255, 80, 200))
                end
            end
        end
    end
    for m, obj in pairs(monsterEsp) do
        if not seen[m] or not m.Parent then
            obj:Destroy()
            monsterEsp[m] = nil
        end
    end
end

local function ambushCheck()
    ambushDist = nil
    if not (CFG.AmbushAlert and carS) then
        return
    end
    local folder = monstersFolder()
    if not folder then
        return
    end
    local nearest = nil
    for _, m in ipairs(folder:GetChildren()) do
        if m.Name == "Ambusher" and m:IsA("Model") then
            local p = m:GetPivot().Position
            local s = RoadPath.project(Road, p.X, p.Z)
            local ahead = s - carS
            if ahead > -5 and ahead < CFG.AmbushDist and (nearest == nil or ahead < nearest) then
                nearest = ahead
            end
        end
    end
    ambushDist = nearest
    if nearest and os.clock() - ambushWarned > 6 then
        ambushWarned = os.clock()
        notify("Ambusher cách " .. math.floor(nearest) .. " st phía trước.", "Warning", 3)
    end
end

-- flashlight lock: aim at the intruder's stand in chassis space, with the yaw / pitch the game sends
local function burnStep()
    local rc = getRunClient()
    if not (CFG.AutoBurn and rc and carRoot) then
        return
    end
    local idx = rc.get("IntruderSpot")
    if type(idx) ~= "number" then
        return
    end
    local spots = IntruderCfg.Spots
    local k = math.floor(idx)
    if k < 1 then
        k = k + 1
    end
    k = clamp(k, 1, #spots)
    local stand = IntruderCfg.Stand
    local target = Vector3.new(stand[1] + spots[k], stand[2], stand[3])
    local e = CarCfg.DriverEye
    local eye = Vector3.new(e[1], e[2], e[3])
    local yaw, pitch = aimYawPitch((target - eye).Unit)
    if rc.get("FlashlightOn") ~= true then
        Remotes.event("Flashlight"):FireServer(true)
    end
    Remotes.unreliable("FlashAim"):FireServer(yaw, pitch, true)
end

-- hold the crank while the knocker is in Warn or Bang and this player is the cranker
local function crankStep()
    local rc = getRunClient()
    if not (CFG.AutoCrank and rc) then
        if crankHeld then
            crankHeld = false
            Remotes.event("Crank"):FireServer(false)
        end
        return
    end
    local phase = rc.get("KnockerPhase")
    local want = (phase == "Warn" or phase == "Bang") and rc.get("KnockerCranker") == LP.UserId
    if want ~= crankHeld then
        crankHeld = want
        Remotes.event("Crank"):FireServer(want)
    end
end

local function voteStep()
    local rc = getRunClient()
    if not rc then
        return
    end
    local st = rc.state()
    if CFG.AutoVote then
        if st == "Finished" or st == "Caught" then
            if not voteDone then
                voteDone = true
                task.delay(2.5, function()
                    rc.requestVote("map")
                end)
            end
        else
            voteDone = false
        end
    end
    if CFG.AutoPick and rc.get("MapPick") ~= nil and not rc.riding() and os.clock() - pickAt > 2 then
        pickAt = os.clock()
        rc.pickMap(CFG.MapChoice)
    end
end

local function startSolo()
    local rc = getRunClient()
    if not rc then
        notify("không lấy được RunClient.", "Error", 3)
        return
    end
    rc.requestStart(false)
end

