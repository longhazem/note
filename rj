            if okO then
                obstNow = resO
            else
                warn("[tokaihub] obstacles: " .. tostring(resO))
            end
        end
        local ok, err = pcall(guards, dt, carModel, carRoot)
        if not ok then
            warn("[tokaihub] guards: " .. tostring(err))
        end
        if CFG.SnapAuto and driving and math.abs(carLat) > CFG.SnapLat then
            every("snap", 1.5, function()
                snapToRoad(carModel, carRoot)
            end)
        end
    else
        carS, carLat = nil, nil
    end

    if carModel and carModel.Parent then
        CFG.LatAccel = (carModel:GetAttribute("ArcadeHandling") == false) and CFG.LatAccelSim or CFG.LatAccelArcade
    end
    if driving and carRoot and carS and CFG.CornerAdapt then
        local slip, along = slipState()
        CFG.CornerScale = adaptCornerScale(CFG.CornerScale, slip, math.abs(lastSteer), along, dt, CFG)
    end
    if driving and carRoot and carS then
        local _, along = slipState()
        if CFG.StuckFix then
            local timer, stuck = stallStep(HK.stall, along, lastThrottle > 0.2, dt)
            HK.stall = timer
            if stuck and os.clock() >= HK.unstick then
                HK.unstick = os.clock() + 1.2
                HK.stall = 0
            end
        end
        if CFG.BrakeAdapt then
            HK.brake = brakeSample(HK.brake, along, HK.along, lastBrake, lastThrottle, math.abs(lastSteer), dt)
            HK.along = along
            if HK.brake and HK.brake > 10 then
                CFG.BrakeUse = clamp(0.8 * HK.brake, 12, CFG.BrakeDecel)   -- never more than the car's own braking, a bad reading must not plan late braking
            end
        end
    else
        HK.along = nil
        HK.stall = 0
    end
    if driving and carRoot and os.clock() - HK.watchT >= 1 then
        if HK.calls == HK.watchN and os.clock() - HK.startT > 2 then
            stopReason = "hook"
        end
        HK.watchN = HK.calls
        HK.watchT = os.clock()
    end
    every("carsFind", 2, discoverCars)
    every("crawler", 0.75, crawlerScan)
    every("mast", 0.25, mastCheck)
    doorStep()
    every("mapscan", 0.25, scanMapBoxes)
    every("knocks", 0.5, function()
        scanKnocks()
        knocksAhead = 0
        if carS then
            for _, o in ipairs(knockCache) do
                local ds = o.s - carS
                if ds > 0 and ds < 150 then
                    knocksAhead = knocksAhead + 1
                end
            end
        end
    end)
    every("watchplan", 0.5, refreshWatchObst)
    every("watchmarks", 0.5, updateWatchMarkers)
    every("cars", 1, updateCarEsp)
    every("monsters", 1, updateMonsterEsp)
    every("tags", 0.25, MARK.update)
    every("farm", 0.25, function()
        if HK.farmTick then
            HK.farmTick()
        end
    end)
    every("ambush", 0.5, ambushCheck)
    every("crank", 0.1, crankStep)
    every("burn", 0.1, burnStep)
    every("vote", 0.5, voteStep)
    every("lobby", 0.5, lobbyStep)
    every("scares", 0.1, clearScares)
