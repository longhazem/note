-- footprint of a model in the road frame: its extent along the road and across it
local function footprintOf(inst)
    local cf, size = inst:GetBoundingBox()
    local sMin, sMax = math.huge, -math.huge
    local latMin, latMax = math.huge, -math.huge
    for i = 0, 7 do
        local ox = ((i % 2 == 0) and -0.5 or 0.5) * size.X
        local oy = ((math.floor(i / 2) % 2 == 0) and -0.5 or 0.5) * size.Y
        local oz = ((math.floor(i / 4) % 2 == 0) and -0.5 or 0.5) * size.Z
        local p = (cf * CFrame.new(ox, oy, oz)).Position
        local s, lat = RoadPath.project(Road, p.X, p.Z)
        if s < sMin then
            sMin = s
        end
        if s > sMax then
            sMax = s
        end
        if lat < latMin then
            latMin = lat
        end
        if lat > latMax then
            latMax = lat
        end
    end
    return sMin, sMax, latMin, latMax
end

