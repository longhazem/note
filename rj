-- MTC hub. client only, executor.
-- ui + esp: HawkTokaiLib. drive: hooks CarInput.setOverride, the slot CarInput.Read takes throttle/brake/steer from.
-- road: RoadPath.build(Config.World), the same table CarController builds its road from.

local HawkTokaiLib = loadstring(game:HttpGet("https://raw.githubusercontent.com/longtokaiikari-source/HawkTokaiLib/refs/heads/main/Source.luau"))()

local Players = game:GetService("Players")
