-- --- AuraKill.lua ---
-- Source: MeleeInventory.lua decompiled
-- v_u_2 = network, v_u_7 = vector3toTable
-- Slash(random 1-3) → delay → Impact(pos_table, actorUID, part)

local Players          = game:GetService("Players")
local RunService       = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local LocalPlayer  = Players.LocalPlayer
local enabled      = false
local AuraRadius   = 15
local AuraCooldown = 0.6
local lastHit      = {}

-- ============================================
-- TÌM NETWORK OBJECT (v_u_2) VÀ REPLICATOR
-- ============================================

local Network           = nil
local ReplicatorService = nil

local function BulkScan()
    local ok, gc = pcall(function() return filtergc("table") end)
    if not ok then ok, gc = pcall(function() return getgc(true) end) end
    if not ok then warn("[Aura] getgc failed"); return end

    local count = 0
    for _, obj in pairs(gc) do
        count = count + 1
        if count % 8000 == 0 then task.wait() end
        if type(obj) ~= "table" then continue end

        -- Network object: có FireServer và _events (RBM5 signature)
        if not Network and rawget(obj, "FireServer") and rawget(obj, "_events") then
            Network = obj
            print("[Aura] Network found")
        end

        -- ReplicatorService: có Actors và LocalActor
        if not ReplicatorService and rawget(obj, "Actors") and rawget(obj, "LocalActor") then
            ReplicatorService = obj
            print("[Aura] ReplicatorService found")
        end

        if Network and ReplicatorService then break end
    end
end

-- ============================================
-- vector3toTable — y chang v_u_7 trong game
-- ============================================

local function vector3toTable(v)
    return { v.X, v.Y, v.Z }
end

-- ============================================
-- LẤY ACTOR UID CỦA ENEMY
-- ============================================

local function getActorUID(character)
    if not ReplicatorService then return nil end
    for _, actor in pairs(ReplicatorService.Actors or {}) do
        if type(actor) ~= "table" then continue end
        if actor.Character == character or actor.Model == character then
            for k, v in pairs(actor) do
                if type(v) == "string" and #v == 36 and v:find("%-") then
                    return v
                end
            end
        end
    end
    return nil
end

-- ============================================
-- HIT SEQUENCE — copy logic từ _use()
-- Slash(1~3) → task.delay → Impact(pos, uid, part)
-- ============================================

local function doAuraHit(targetChar)
    if not Network then return end

    local targetRoot = targetChar:FindFirstChild("HumanoidRootPart")
    if not targetRoot then return end

    local uid = getActorUID(targetChar)
    if not uid then return end

    local slashNum = math.random(1, 3)

    -- Slash
    pcall(function()
        Network:FireServer("InventoryAction", "Slash", slashNum)
    end)

    -- Delay rồi Impact — y chang task.delay trong _use()
    local hitPos = targetRoot.Position
    task.delay(0.1, function()
        if not targetChar.Parent then return end
        pcall(function()
            Network:FireServer(
                "InventoryAction",
                "Impact",
                vector3toTable(hitPos), -- v_u_7(v15)
                uid,                    -- v16: actor UID
                "Head"                  -- v17: body part
            )
        end)
    end)
end

-- ============================================
-- AURA LOOP
-- ============================================

RunService.Heartbeat:Connect(function()
    if not enabled or not Network then return end

    local myChar = LocalPlayer.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not myRoot then return end

    local now = tick()
    local myPos = myRoot.Position

    for _, player in ipairs(Players:GetPlayers()) do
        if player == LocalPlayer then continue end
        local eChar = player.Character
        if not eChar then continue end
        local eRoot = eChar:FindFirstChild("HumanoidRootPart")
        local hum   = eChar:FindFirstChildOfClass("Humanoid")
        if not eRoot or not hum or hum.Health <= 0 then continue end
        if (myPos - eRoot.Position).Magnitude > AuraRadius then continue end
        if lastHit[player] and (now - lastHit[player]) < AuraCooldown then continue end
        lastHit[player] = now
        task.spawn(doAuraHit, eChar)
    end
end)

-- ============================================
-- TOGGLE + INIT
-- ============================================

UserInputService.InputBegan:Connect(function(input, gpe)
    if gpe then return end
    if input.KeyCode == Enum.KeyCode.E then
        enabled = not enabled
        print("[Aura] " .. (enabled and "ON" or "OFF"))
    end
end)

task.spawn(function()
    task.wait(1.5)
    BulkScan()
    print("[Aura] E = bật/tắt | Radius: " .. AuraRadius)
end)
