-- --- AuraKill.lua ---
-- p179 = weapon item UID (bắt từ hookmetamethod khi swing tay 1 lần)
-- Sau đó replay Slash + Impact liên tục

local Players          = game:GetService("Players")
local RunService       = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local LocalPlayer = Players.LocalPlayer
local enabled     = false
local AuraRadius  = 15
local AuraCooldown = 0.6
local lastHit     = {}

local Network       = nil
local weaponUID     = nil  -- UUID của melee weapon đang cầm
local ReplicatorSvc = nil

-- ============================================
-- BULK SCAN
-- ============================================

local function BulkScan()
    local ok, gc = pcall(function() return filtergc("table") end)
    if not ok then ok, gc = pcall(function() return getgc(true) end) end
    if not ok then return end
    local count = 0
    for _, obj in pairs(gc) do
        count = count + 1
        if count % 8000 == 0 then task.wait() end
        if type(obj) ~= "table" then continue end
        if not Network and rawget(obj, "FireServer") and rawget(obj, "_events") then
            Network = obj
            print("[Aura] Network found")
        end
        if not ReplicatorSvc and rawget(obj, "Actors") and rawget(obj, "LocalActor") then
            ReplicatorSvc = obj
            print("[Aura] ReplicatorService found")
        end
        if Network and ReplicatorSvc then break end
    end
end

-- ============================================
-- HOOK — bắt weaponUID từ swing tay đầu tiên
-- ============================================

local function setupHook()
    if not Network then return end
    local origFireServer = Network.FireServer
    Network.FireServer = function(self, action, subAction, ...)
        -- Bắt: Network:FireServer("InventoryAction", "Slash", slashNum)
        -- arg1 = "InventoryAction", arg2 = "Slash"
        -- NHƯNG theo InventoryService: FireServer(uid, "InventoryAction", action, ...)
        -- Thực ra format: Network:FireServer(uid, action, ...)
        -- uid là arg đầu tiên
        if not weaponUID and action and type(action) == "string"
        and #action == 36 and action:find("%-")
        and subAction == "InventoryAction" then
            weaponUID = action
            print("[Aura] WeaponUID: " .. weaponUID)
        end
        return origFireServer(self, action, subAction, ...)
    end
    print("[Aura] Hook active — swing melee 1 lần để capture weaponUID")
end

-- ============================================
-- vector3toTable
-- ============================================

local function v3t(v) return {v.X, v.Y, v.Z} end

-- ============================================
-- ACTOR UID
-- ============================================

local function getActorUID(character)
    if not ReplicatorSvc then return nil end
    for _, actor in pairs(ReplicatorSvc.Actors or {}) do
        if type(actor) ~= "table" then continue end
        if actor.Character == character or actor.Model == character then
            for _, v in pairs(actor) do
                if type(v) == "string" and #v == 36 and v:find("%-") then
                    return v
                end
            end
        end
    end
    return nil
end

-- ============================================
-- HIT SEQUENCE
-- ============================================

local function doAuraHit(eRoot, eChar)
    if not Network or not weaponUID then return end

    local myChar = LocalPlayer.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not myRoot then return end

    local actorUID = getActorUID(eChar)
    if not actorUID then return end

    local slashNum = math.random(1, 3)

    -- Slash
    pcall(function()
        Network:FireServer(weaponUID, "InventoryAction", "Slash", slashNum)
    end)

    -- Impact sau delay
    task.delay(0.1, function()
        if not eRoot.Parent then return end
        local hitPos = eRoot.Position + Vector3.new(0, 1, 0)

        -- Raycast từ mình đến target
        local origin = myRoot.Position + Vector3.new(0, 1.5, 0)
        local dir = (hitPos - origin)
        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        params.FilterDescendantsInstances = { myChar }
        local result = workspace:Raycast(origin, dir, params)

        local finalPos = result and result.Position or hitPos
        local finalPart = result and result.Instance and result.Instance.Name or "Head"

        pcall(function()
            Network:FireServer(weaponUID, "InventoryAction", "Impact",
                v3t(finalPos),
                actorUID,
                finalPart
            )
        end)
    end)
end

-- ============================================
-- AURA LOOP
-- ============================================

RunService.Heartbeat:Connect(function()
    if not enabled then return end
    if not Network then return end
    if not weaponUID then
        warn("[Aura] Swing melee 1 lần trước")
        return
    end

    local myChar = LocalPlayer.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not myRoot then return end

    local now = tick()
    local myPos = myRoot.Position

    for _, player in ipairs(Players:GetPlayers()) do
        if player == LocalPlayer then continue end
        local eChar = player.Character
        if not eChar then continue end
        local eRoot = eChar:FindFirstChild("HumanoidRootPart")
        local hum   = eChar:FindFirstChildOfClass("Humanoid")
        if not eRoot or not hum or hum.Health <= 0 then continue end
        if (myPos - eRoot.Position).Magnitude > AuraRadius then continue end
        if lastHit[player] and (now - lastHit[player]) < AuraCooldown then continue end
        lastHit[player] = now
        task.spawn(doAuraHit, eRoot, eChar)
    end
end)

-- ============================================
-- TOGGLE + INIT
-- ============================================

UserInputService.InputBegan:Connect(function(input, gpe)
    if gpe then return end
    if input.KeyCode == Enum.KeyCode.E then
        if not weaponUID then
            warn("[Aura] Swing melee 1 lần trước để capture weaponUID")
            return
        end
        enabled = not enabled
        print("[Aura] " .. (enabled and "ON" or "OFF"))
    end
end)

task.spawn(function()
    task.wait(1.5)
    BulkScan()
    task.wait(0.3)
    setupHook()
    print("[Aura] Bước 1: Equip melee → swing 1 lần → weaponUID captured")
    print("[Aura] Bước 2: E = bật/tắt | Radius: " .. AuraRadius)
end)
