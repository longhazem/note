-- --- AuraKill.lua ---

local Players          = game:GetService("Players")
local RunService       = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local LocalPlayer  = Players.LocalPlayer
local enabled      = false
local AuraRadius   = 20
local AuraCooldown = 0.5
local lastHit      = {}

-- ============================================
-- TÌM MeleeInventory — TABLE 3 signature
-- Keys: Slash=function, Impact=function, _weld, _actor, _primary, _belt, Replicator
-- ============================================

local MeleeInventory = nil

local function findMeleeInventory()
    local ok, gc = pcall(function() return getgc(true) end)
    if not ok then warn("[Aura] getgc failed"); return end

    local count = 0
    for _, v in pairs(gc) do
        count = count + 1
        if count % 5000 == 0 then task.wait() end
        if type(v) ~= "table" then continue end

        local ok1, slash  = pcall(function() return v.Slash end)
        local ok2, impact = pcall(function() return v.Impact end)
        local ok3, actor  = pcall(function() return v._actor end)
        local ok4, belt   = pcall(function() return v._belt end)

        if ok1 and ok2 and ok3 and ok4
        and type(slash)  == "function"
        and type(impact) == "function"
        and actor ~= nil
        and belt  ~= nil then
            MeleeInventory = v
            print("[Aura] MeleeInventory found: " .. tostring(v))
            print("[Aura] _actor: " .. tostring(actor))
            break
        end
    end

    if not MeleeInventory then warn("[Aura] Not found") end
end

-- ============================================
-- LẤY ACTOR UID
-- ============================================

local ReplicatorService = nil

local function bulkScan()
    local ok, gc = pcall(function() return filtergc("table") end)
    if not ok then ok, gc = pcall(function() return getgc(true) end) end
    if not ok then return end
    local count = 0
    for _, obj in pairs(gc) do
        count = count + 1
        if count % 8000 == 0 then task.wait() end
        if type(obj) == "table"
        and rawget(obj, "Actors")
        and rawget(obj, "LocalActor") then
            ReplicatorService = obj
            print("[Aura] ReplicatorService found")
            break
        end
    end
end

local function getActorFromChar(character)
    if not ReplicatorService then return nil end
    for _, actor in pairs(ReplicatorService.Actors or {}) do
        if type(actor) ~= "table" then continue end
        if actor.Character == character or actor.Model == character then
            return actor
        end
    end
    return nil
end

-- ============================================
-- HIT SEQUENCE
-- ============================================

local function doAuraHit(targetChar)
    if not MeleeInventory then return end

    local targetRoot = targetChar:FindFirstChild("HumanoidRootPart")
    if not targetRoot then return end

    local targetActor = getActorFromChar(targetChar)
    local pos = targetRoot.Position

    -- Slash 1 → 2 → 3
    pcall(function() MeleeInventory:Slash(1) end)
    task.wait(0.05)
    pcall(function() MeleeInventory:Slash(2) end)
    task.wait(0.05)
    pcall(function() MeleeInventory:Slash(3) end)
    task.wait(0.05)

    -- Impact: thử các cách gọi khác nhau
    pcall(function()
        MeleeInventory:Impact(
            Vector3.new(pos.X, pos.Y, pos.Z),
            targetActor,
            "Head"
        )
    end)
end

-- ============================================
-- AURA LOOP
-- ============================================

RunService.Heartbeat:Connect(function()
    if not enabled or not MeleeInventory then return end

    local myChar = LocalPlayer.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not myRoot then return end

    local now = tick()

    for _, player in ipairs(Players:GetPlayers()) do
        if player == LocalPlayer then continue end
        local eChar = player.Character
        if not eChar then continue end
        local eRoot = eChar:FindFirstChild("HumanoidRootPart")
        local hum   = eChar:FindFirstChildOfClass("Humanoid")
        if not eRoot or not hum or hum.Health <= 0 then continue end
        if (myRoot.Position - eRoot.Position).Magnitude > AuraRadius then continue end
        if lastHit[player] and (now - lastHit[player]) < AuraCooldown then continue end
        lastHit[player] = now
        task.spawn(doAuraHit, eChar)
    end
end)

-- ============================================
-- TOGGLE + INIT
-- ============================================

UserInputService.InputBegan:Connect(function(input, gpe)
    if gpe then return end
    if input.KeyCode == Enum.KeyCode.E then
        enabled = not enabled
        print("[Aura] " .. (enabled and "ON" or "OFF"))
    end
end)

task.spawn(function()
    task.wait(1.5)
    bulkScan()
    findMeleeInventory()
    print("[Aura] E = bật/tắt | Radius: " .. AuraRadius)
end)
