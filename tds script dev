-- Core variables cho minesweeper
local ms_isScanning    = false
local ms_isFastTPing   = false
local ms_isAntiLagOn   = false
local ms_isESPOn       = false
local ms_isFPSOn       = false
local ms_cachedParts   = {}
local ms_neighborMap   = {}
local ms_numberTiles   = {}
local ms_knownMines    = {}
local ms_knownSafe     = {}
local ms_currentBestGuess = nil
local ms_connections   = {}
local ms_pendingReset  = false
local ms_fpsConnection = nil
local ms_espConnections = {}

local PlayerService2 = game:GetService("Players")
local RunService2    = game:GetService("RunService")
local player2        = PlayerService2.LocalPlayer

-- Helper functions (minesweeper)
local function ms_isColorMatch(c1, r, g, b)
    return math.abs(c1.R - r) < 0.05 and math.abs(c1.G - g) < 0.05 and math.abs(c1.B - b) < 0.05
end
local function ms_isExcluded(part)
    return ms_isColorMatch(part.Color, 1.000, 1.000, 0.490)
end
local function ms_isUnrevealed(part)
    if part.Name ~= "Part" or ms_isExcluded(part) then return false end
    local green1 = ms_isColorMatch(part.Color, 0.459, 0.804, 0.392)
    local green2 = ms_isColorMatch(part.Color, 0.404, 0.706, 0.345)
    local red1   = ms_isColorMatch(part.Color, 0.804, 0.392, 0.392)
    local red2   = ms_isColorMatch(part.Color, 0.706, 0.345, 0.345)
    local blue1  = ms_isColorMatch(part.Color, 0.392, 0.741, 0.804)
    local blue2  = ms_isColorMatch(part.Color, 0.345, 0.651, 0.706)
    return green1 or green2 or red1 or red2 or blue1 or blue2
end
local function ms_getNumber(part)
    if part.Name ~= "Part" or ms_isExcluded(part) then return nil end
    for _, desc in ipairs(part:GetDescendants()) do
        if desc:IsA("TextLabel") and desc.Visible then
            local num = tonumber(desc.Text:match("%d+"))
            if num and num >= 1 and num <= 8 then return num end
        end
    end
    return nil
end
-- Folder chứa các Part border, không bị streaming ảnh hưởng
local ms_highlightFolder = Instance.new("Folder")
ms_highlightFolder.Name = "MS_Highlights"
ms_highlightFolder.Parent = workspace

-- Bảng: part → {top, bottom, left, right} border parts
local ms_highlightInstances = {}

local function ms_newBorderPart(color)
    local p = Instance.new("Part")
    p.Anchored       = true
    p.CanCollide     = false
    p.CanQuery       = false
    p.CanTouch       = false
    p.CastShadow     = false
    p.Transparency   = 0
    p.Material       = Enum.Material.Neon
    p.Color          = color
    p.Size           = Vector3.new(1, 1, 1)
    p.Parent         = ms_highlightFolder
    return p
end

local function ms_updateBorderPositions(part, borders)
    local sz  = part.Size
    local th  = 0.08
    local ins = 0.05
    local hx  = sz.X/2 - ins
    local hz  = sz.Z/2 - ins
    local yoff = sz.Y/2 + 0.01
    borders.top.Size    = Vector3.new(sz.X - ins*2, th, th)
    borders.bottom.Size = Vector3.new(sz.X - ins*2, th, th)
    borders.left.Size   = Vector3.new(th, th, sz.Z - ins*2)
    borders.right.Size  = Vector3.new(th, th, sz.Z - ins*2)
    borders.top.CFrame    = part.CFrame * CFrame.new(0,  yoff, -hz)
    borders.bottom.CFrame = part.CFrame * CFrame.new(0,  yoff,  hz)
    borders.left.CFrame   = part.CFrame * CFrame.new(-hx, yoff, 0)
    borders.right.CFrame  = part.CFrame * CFrame.new( hx, yoff, 0)
end

local function ms_clearVisuals(part)
    if not part then return end
    if ms_highlightInstances[part] then
        for _, b in pairs(ms_highlightInstances[part]) do b:Destroy() end
        ms_highlightInstances[part] = nil
    end
end

local function ms_createHighlight(part, color, name)
    if ms_highlightInstances[part] then
        for _, b in pairs(ms_highlightInstances[part]) do b:Destroy() end
        ms_highlightInstances[part] = nil
    end
    if name == "Guess_Highlight" then
        if ms_knownSafe[part] or ms_knownMines[part] then return end
    end
    local borders = {
        top    = ms_newBorderPart(color),
        bottom = ms_newBorderPart(color),
        left   = ms_newBorderPart(color),
        right  = ms_newBorderPart(color),
    }
    ms_updateBorderPositions(part, borders)
    ms_highlightInstances[part] = borders
end
local function ms_cacheNeighbors(centerPart, forceRefresh)
    if not forceRefresh and ms_neighborMap[centerPart] then return end
    local neighbors = {}
    local boxSize = centerPart.Size * 2.5
    local partsInBox = workspace:GetPartBoundsInBox(centerPart.CFrame, boxSize)
    for _, p in ipairs(partsInBox) do
        if p ~= centerPart and p.Name == "Part" then
            if math.abs(p.Position.Y - centerPart.Position.Y) < 1 then
                local dist = (p.Position - centerPart.Position).Magnitude
                if dist < (centerPart.Size.X * 1.8) then
                    table.insert(neighbors, p)
                end
            end
        end
    end
    ms_neighborMap[centerPart] = neighbors
end
local function ms_requestReset()
    if ms_pendingReset then return end
    ms_pendingReset = true
    task.delay(0.2, function()
        ms_pendingReset = false
        if not ms_isScanning then return end
        for p in pairs(ms_knownSafe)  do ms_clearVisuals(p) end
        for p in pairs(ms_knownMines) do ms_clearVisuals(p) end
        if ms_currentBestGuess then ms_clearVisuals(ms_currentBestGuess) end
        ms_knownSafe = {}; ms_knownMines = {}; ms_currentBestGuess = nil
    end)
end
local function ms_solveBoard()
    if ms_pendingReset then return end
    local activeNumbers = {}
    local probabilityMap = {}
    -- PASS 1: Basic Logic
    for centerPart, targetNum in pairs(ms_numberTiles) do
        if not centerPart:IsDescendantOf(workspace) then
            ms_numberTiles[centerPart] = nil; continue
        end
        local neighbors = ms_neighborMap[centerPart]
        if not neighbors then continue end
        local unrevealed = {}; local mineCount = 0
        for _, n in ipairs(neighbors) do
            if ms_knownMines[n] then
                mineCount = mineCount + 1
            elseif ms_isUnrevealed(n) and not ms_knownSafe[n] then
                table.insert(unrevealed, n)
            end
        end
        local remainingMines = targetNum - mineCount
        if remainingMines == #unrevealed and #unrevealed > 0 then
            for _, p in ipairs(unrevealed) do
                if not ms_knownMines[p] then
                    ms_knownMines[p] = true; ms_clearVisuals(p)
                    ms_createHighlight(p, Color3.new(1,0,0), "Mine_Highlight")
                end
            end
        elseif remainingMines == 0 and #unrevealed > 0 then
            for _, p in ipairs(unrevealed) do
                if not ms_knownSafe[p] then
                    ms_knownSafe[p] = true; ms_clearVisuals(p)
                    ms_createHighlight(p, Color3.new(0,1,0), "Safe_Highlight")
                end
            end
        else
            if #unrevealed > 0 then
                local prob = remainingMines / #unrevealed
                for _, p in ipairs(unrevealed) do
                    if not probabilityMap[p] or prob > probabilityMap[p] then
                        probabilityMap[p] = prob
                    end
                end
            end
        end
        if #unrevealed > 0 then
            table.insert(activeNumbers, {part=centerPart, unrevealed=unrevealed, needed=remainingMines})
        end
    end
    -- PASS 2: Advanced Set Difference
    for i = 1, #activeNumbers do
        for j = 1, #activeNumbers do
            if i == j then continue end
            local A = activeNumbers[i]; local B = activeNumbers[j]
            if (A.part.Position - B.part.Position).Magnitude > (A.part.Size.X * 3) then continue end
            local isSubset = true
            for _, uA in ipairs(A.unrevealed) do
                local found = false
                for _, uB in ipairs(B.unrevealed) do if uA == uB then found=true; break end end
                if not found then isSubset=false; break end
            end
            if isSubset then
                local diffMines = B.needed - A.needed; local diffSet = {}
                for _, uB in ipairs(B.unrevealed) do
                    local inA = false
                    for _, uA in ipairs(A.unrevealed) do if uB == uA then inA=true; break end end
                    if not inA then table.insert(diffSet, uB) end
                end
                if #diffSet > 0 then
                    if diffMines == 0 then
                        for _, p in ipairs(diffSet) do
                            if not ms_knownSafe[p] then ms_knownSafe[p]=true; ms_clearVisuals(p); ms_createHighlight(p,Color3.new(0,1,0),"Safe_Highlight") end
                        end
                    elseif diffMines == #diffSet then
                        for _, p in ipairs(diffSet) do
                            if not ms_knownMines[p] then ms_knownMines[p]=true; ms_clearVisuals(p); ms_createHighlight(p,Color3.new(1,0,0),"Mine_Highlight") end
                        end
                    end
                end
            end
        end
    end
    -- PASS 3: Best Guess
    local hasSafeMoves = false
    for _ in pairs(ms_knownSafe) do hasSafeMoves=true; break end
    if ms_currentBestGuess and (not ms_currentBestGuess:IsDescendantOf(workspace) or ms_knownSafe[ms_currentBestGuess] or ms_knownMines[ms_currentBestGuess] or hasSafeMoves) then
        if ms_currentBestGuess:IsDescendantOf(workspace) and ms_currentBestGuess:FindFirstChild("Guess_Highlight") then
            ms_currentBestGuess.Guess_Highlight:Destroy()
        end
        ms_currentBestGuess = nil
    end
    if not hasSafeMoves then
        local bestPart=nil; local lowestProb=1.1
        for part, prob in pairs(probabilityMap) do
            if not ms_knownMines[part] and not ms_knownSafe[part] then
                if prob < lowestProb then lowestProb=prob; bestPart=part end
            end
        end
        if bestPart and bestPart ~= ms_currentBestGuess then
            if ms_currentBestGuess and ms_currentBestGuess:IsDescendantOf(workspace) and ms_currentBestGuess:FindFirstChild("Guess_Highlight") then
                ms_currentBestGuess.Guess_Highlight:Destroy()
            end
            ms_currentBestGuess = bestPart
            ms_createHighlight(bestPart, Color3.fromRGB(255,255,0), "Guess_Highlight")
        end
    end
end
local function ms_startSolverLoop()
    task.spawn(function()
        while ms_isScanning do
            local validParts = {}
            local charPos = nil
            if player2.Character and player2.Character:FindFirstChild("HumanoidRootPart") then
                charPos = player2.Character.HumanoidRootPart.Position
            end
            for _, part in ipairs(ms_cachedParts) do
                if part:IsDescendantOf(workspace) then
                    table.insert(validParts, part)
                    if ms_isAntiLagOn and charPos then
                        local dist = (part.Position - charPos).Magnitude
                        if dist > 60 then
                            ms_clearVisuals(part); ms_numberTiles[part]=nil; ms_knownSafe[part]=nil; ms_knownMines[part]=nil
                            continue
                        end
                    end
                    if not ms_neighborMap[part] then ms_cacheNeighbors(part, false) end
                    if ms_isExcluded(part) then
                        if ms_numberTiles[part] or ms_knownSafe[part] or ms_knownMines[part] then
                            ms_numberTiles[part]=nil; ms_knownSafe[part]=nil; ms_knownMines[part]=nil; ms_clearVisuals(part)
                        end
                    elseif not ms_isUnrevealed(part) then
                        local num = ms_getNumber(part)
                        if num and not ms_numberTiles[part] then
                            ms_numberTiles[part]=num; ms_knownSafe[part]=nil; ms_knownMines[part]=nil; ms_clearVisuals(part)
                        end
                    end
                else
                    ms_neighborMap[part]=nil; ms_numberTiles[part]=nil; ms_knownMines[part]=nil; ms_knownSafe[part]=nil
                end
            end
            ms_cachedParts = validParts
            ms_solveBoard()
            task.wait(0.1)
        end
    end)
end
local function ms_onDescendantAdded(descendant)
    if ms_isScanning and descendant:IsA("BasePart") and descendant.Name == "Part" then
        table.insert(ms_cachedParts, descendant)
        task.delay(0.1, function()
            if descendant:IsDescendantOf(workspace) then
                ms_cacheNeighbors(descendant, true)
                for _, neighbor in ipairs(ms_neighborMap[descendant] or {}) do
                    ms_cacheNeighbors(neighbor, true)
                end
                ms_requestReset()
            end
        end)
    end
end

