local stratTab = win:CreateTab("Strat", "IMG:tabDisplay")
stratTab:AddSection("📋 Ghi Chiến Thuật")

local strat_recording = false
local strat_towers    = {}
local strat_count     = 0
local strat_file      = "Strat.txt"
local strat_actions   = 0

local function strat_record(cmd)
    if not strat_recording then return end
    if appendfile then appendfile(strat_file, cmd .. "\n") end
    strat_actions = strat_actions + 1
end

stratTab:AddButton("▶ Bắt đầu ghi", function()
    if strat_recording then Notify("Đang ghi rồi!", "⚠️") return end

    local mode, map = "Unknown", "Unknown"
    local sf = ReplicatedStorage:FindFirstChild("State")
    if sf then mode = sf.Difficulty.Value; map = sf.Map.Value end

    local t1,t2,t3,t4,t5 = "None","None","None","None","None"
    local mods = ""
    local sr = ReplicatedStorage:FindFirstChild("StateReplicators")
    if sr then
        for _, f in ipairs(sr:GetChildren()) do
            if f.Name == "PlayerReplicator" and f:GetAttribute("UserId") == LocalPlayer.UserId then
                local eq = f:GetAttribute("EquippedTowers")
                if type(eq) == "string" then
                    local ok, tbl = pcall(function() return HttpService:JSONDecode(eq:match("%[.*%]") or "[]") end)
                    if ok and tbl then t1=tbl[1] or "None";t2=tbl[2] or "None";t3=tbl[3] or "None";t4=tbl[4] or "None";t5=tbl[5] or "None" end
                end
            end
            if f.Name == "ModifierReplicator" then
                local raw = f:GetAttribute("Votes")
                if type(raw) == "string" then
                    local ok, mt = pcall(function() return HttpService:JSONDecode(raw:match("{.*}") or "{}") end)
                    if ok and mt then
                        local ml={}; for k in pairs(mt) do table.insert(ml, k.." = true") end
                        mods = table.concat(ml, ", ")
                    end
                end
            end
        end
    end

    strat_recording = true; strat_count = 0; strat_towers = {}; strat_actions = 0

    if writefile then
        writefile(strat_file, string.format(
            'local TDS = loadstring(game:HttpGet("https://raw.githubusercontent.com/DuxiiT/auto-strat/refs/heads/main/Library.lua"))()'
            .."\n\nTDS:Loadout(\"%s\",\"%s\",\"%s\",\"%s\",\"%s\")\nTDS:Mode(\"%s\")\nTDS:GameInfo(\"%s\",{%s})\n\n",
            t1,t2,t3,t4,t5, mode, map, mods
        ))
    end

    Notify("Đang ghi! Map: " .. map, "🔴")

    local tf = workspace:WaitForChild("Towers", 10)
    if not tf then return end

    tf.ChildAdded:Connect(function(tower)
        if not strat_recording then return end
        local rep = tower:WaitForChild("TowerReplicator", 5)
        if not rep or rep:GetAttribute("OwnerId") ~= LocalPlayer.UserId then return end
        strat_count += 1
        local idx = strat_count
        strat_towers[tower] = idx
        local tname = rep:GetAttribute("Name") or tower.Name
        local rp = rep:GetAttribute("Position")
        local px,py,pz
        if typeof(rp) == "Vector3" then px,py,pz=rp.X,rp.Y,rp.Z
        else local p=tower:GetPivot().Position; px,py,pz=p.X,p.Y,p.Z end
        strat_record(string.format('TDS:Place("%s",%.3f,%.3f,%.3f)',tname,px,py,pz))
        rep:GetAttributeChangedSignal("Upgrade"):Connect(function()
            if strat_recording then strat_record(string.format('TDS:Upgrade(%d)',idx)) end
        end)
    end)

    tf.ChildRemoved:Connect(function(tower)
        if not strat_recording then return end
        local idx = strat_towers[tower]
        if idx then strat_record(string.format('TDS:Sell(%d)',idx)); strat_towers[tower]=nil end
    end)
end, "Đang ghi chiến thuật!", "🔴")

