			FOVSettings = Environment.FOVSettings
		}
		local json = game:GetService("HttpService"):JSONEncode(data)
		writefile("Aimbot_Settings.json", json)
	end)
	return success
end

function Environment.Functions:LoadSettings()
	local success, err = pcall(function()
		local json = readfile("Aimbot_Settings.json")
		if json and #json > 0 then
			local data = game:GetService("HttpService"):JSONDecode(json)
			if type(data.Settings) == "table" then
				for k, v in pairs(data.Settings) do
					Environment.Settings[k] = v
				end
			end
			if type(data.FOVSettings) == "table" then
				for k, v in pairs(data.FOVSettings) do
					Environment.FOVSettings[k] = v
				end
			end
		end
	end)
	return success
end

