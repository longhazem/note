print("[Script] Starting Infinite Ammo + Objective ESP")

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local LocalPlayer = Players.LocalPlayer
local Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()

-- ─────────────────────────────────────────────────────────────────────────
-- INFINITE AMMO
-- ─────────────────────────────────────────────────────────────────────────

local function SetInfiniteAmmo(tool)
    if not tool then return end
    
    pcall(function()
        local weaponData = tool:FindFirstChild("WeaponData")
        if not weaponData then return end
        
        local essentials = weaponData:FindFirstChild("Essentials")
        if not essentials then return end
        
        local ammo = essentials:FindFirstChild("Ammo")
        if ammo and ammo:IsA("NumberValue") then
            ammo.Value = 99999
            print("[Ammo] Set to 99999 for: " .. tool.Name)
        end
    end)
end

local function UpdateAllAmmo()
    -- Backpack weapons
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    if backpack then
        for _, tool in ipairs(backpack:GetChildren()) do
            if tool:IsA("Tool") then
                SetInfiniteAmmo(tool)
            end
        end
    end
    
    -- Character weapons
    for _, tool in ipairs(Character:GetChildren()) do
        if tool:IsA("Tool") then
            SetInfiniteAmmo(tool)
        end
    end
end

-- Initial ammo setup
UpdateAllAmmo()

-- Monitor for new tools
LocalPlayer.ChildAdded:Connect(function(child)
    if child:IsA("Tool") then
        task.wait(0.1)
        SetInfiniteAmmo(child)
    end
end)

Character.ChildAdded:Connect(function(child)
    if child:IsA("Tool") then
        task.wait(0.1)
        SetInfiniteAmmo(child)
    end
end)

LocalPlayer.CharacterAdded:Connect(function(newCharacter)
    Character = newCharacter
    task.wait(0.5)
    UpdateAllAmmo()
end)

-- Continuous ammo update
RunService.Heartbeat:Connect(function()
    UpdateAllAmmo()
end)

-- ─────────────────────────────────────────────────────────────────────────
-- OBJECTIVE ESP
-- ─────────────────────────────────────────────────────────────────────────

local function CreateESPBox(object, name)
    local bbox = Instance.new("BillboardGui")
    bbox.Name = "ObjectiveESP_" .. name
    bbox.Size = UDim2.new(4, 0, 4, 0)
    bbox.MaxDistance = 500
    bbox.Adornee = object
    
    local frame = Instance.new("Frame", bbox)
    frame.Size = UDim2.new(1, 0, 1, 0)
    frame.BackgroundTransparency = 1
    frame.BorderSizePixel = 0
    
    local outline = Instance.new("UIStroke", frame)
    outline.Thickness = 2
    outline.Color = Color3.fromRGB(255, 0, 0)
    
    local label = Instance.new("TextLabel", frame)
    label.Size = UDim2.new(1, 0, 0, 20)
    label.BackgroundTransparency = 1
    label.TextColor3 = Color3.fromRGB(255, 0, 0)
    label.TextScaled = true
    label.Font = Enum.Font.GothamBold
    label.Text = name
    
    bbox.Parent = object
    return bbox
end

local espObjects = {}

local function UpdateObjectiveESP()
    local game_workspace = Workspace:FindFirstChild("Game")
    if not game_workspace then return end
    
    local current = game_workspace:FindFirstChild("Current")
    if not current then return end
    
    local spawned = current:FindFirstChild("Spawned")
    if not spawned then return end
    
    local gameObjects = spawned:FindFirstChild("GameObjects")
    if not gameObjects then return end
    
    -- Find mission objectives
    for _, obj in ipairs(gameObjects:GetChildren()) do
        if obj:IsA("Model") and obj.Name:sub(1, 8) == "mission_" then
            if not espObjects[obj] then
                espObjects[obj] = CreateESPBox(obj, obj.Name)
                print("[ESP] Added: " .. obj.Name)
            end
        end
    end
    
    -- Remove ESP for deleted objects
    for obj, esp in pairs(espObjects) do
        if not obj.Parent then
            esp:Destroy()
            espObjects[obj] = nil
            print("[ESP] Removed: " .. obj.Name)
        end
    end
end

-- Initial ESP setup
UpdateObjectiveESP()

-- Monitor for new objectives
Workspace.DescendantAdded:Connect(function(descendant)
    if descendant.Name:sub(1, 8) == "mission_" then
        task.wait(0.1)
        UpdateObjectiveESP()
    end
end)

-- Continuous ESP update
RunService.Heartbeat:Connect(function()
    UpdateObjectiveESP()
end)

