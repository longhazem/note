-- Các hàm helper
local function getAimbotLocalRoot()
   local char = lp.Character
   if not char then return nil end
   return char:FindFirstChild("HumanoidRootPart")
end

local function aimbotPredictPosition(char, mul)
   if not config.aimbotPrediction then return nil end
   local root = char:FindFirstChild("HumanoidRootPart")
   if root and type(mul)=="number" and mul>0 then
      local vel = root.Velocity
      return root.Position + vel * mul
   end
   return nil
end

local function aimbotGetClosestPartPos(char)
   local mousePos = UserInputService:GetMouseLocation()
   local closestDist = math.huge
   local closestPos = nil
   local rootPart = char:FindFirstChild("HumanoidRootPart")
   if not rootPart then return nil end
   local predRoot = aimbotPredictPosition(char, config.aimbotPredictionValue)
   for _, partName in ipairs(bodyParts) do
      local part = char:FindFirstChild(partName)
      if part then
         if config.aimbotWallCheck and #(camera:GetPartsObscuringTarget({part.Position}, char:GetDescendants())) > 0 then continue end
         local pos = part.Position
         if predRoot then
            local offset = pos - rootPart.Position
            pos = predRoot + offset
         end
         local vec, onScreen = camera:WorldToViewportPoint(pos)
         if onScreen then
            local dist = (Vector2.new(mousePos.X, mousePos.Y) - Vector2.new(vec.X, vec.Y)).Magnitude
            if dist < closestDist then
               closestDist = dist
               closestPos = pos
            end
         end
      end
   end
   return closestPos or rootPart.Position
end

local function aimbotGetClosestPlayer()
   if not aimbotLocked then
      local requiredDist = config.aimbotFOV
      local localRoot = getAimbotLocalRoot()
      local localPos = localRoot and localRoot.Position
      for _, v in ipairs(Players:GetPlayers()) do
         if v ~= lp then
            if v.Character and v.Character:FindFirstChildOfClass("Humanoid") then
               if config.aimbotTeamCheck and v.Team == lp.Team then continue end
               if config.aimbotAliveCheck and v.Character:FindFirstChildOfClass("Humanoid").Health <= 0 then continue end
               if localPos then
                  local targetRoot = v.Character:FindFirstChild("HumanoidRootPart")
                  if targetRoot and config.aimbotMaxDistance > 0 then
                     if (targetRoot.Position - localPos).Magnitude > config.aimbotMaxDistance then continue end
                  end
               end
               local aimPos
               if config.aimbotLockPart == "DirectTouch" then
                  aimPos = aimbotGetClosestPartPos(v.Character)
                  if not aimPos then continue end
               else
                  local part = v.Character:FindFirstChild(config.aimbotLockPart)
                  if not part then continue end
                  aimPos = part.Position
                  local root = v.Character:FindFirstChild("HumanoidRootPart")
                  local predRoot = aimbotPredictPosition(v.Character, config.aimbotPredictionValue)
                  if root and predRoot then
                     aimPos = predRoot + (aimPos - root.Position)
                  end
                  if config.aimbotWallCheck and #(camera:GetPartsObscuringTarget({aimPos}, v.Character:GetDescendants())) > 0 then continue end
               end
               local vec, onScreen = camera:WorldToViewportPoint(aimPos)
               local dist = (Vector2.new(UserInputService:GetMouseLocation().X, UserInputService:GetMouseLocation().Y) - Vector2.new(vec.X, vec.Y)).Magnitude
               if dist < requiredDist and onScreen then
                  requiredDist = dist
                  aimbotLocked = v
               end
            end
         end
      end
   else
      -- Kiểm tra duy trì lock
      if not aimbotLocked.Character or not aimbotLocked.Character:FindFirstChildOfClass("Humanoid") then
         aimbotLocked = nil
         return
      end
      if not config.aimbotForceConnect then
         local localRoot = getAimbotLocalRoot()
         local targetRoot = aimbotLocked.Character:FindFirstChild("HumanoidRootPart")
         if localRoot and targetRoot and config.aimbotMaxDistance > 0 then
            if (targetRoot.Position - localRoot.Position).Magnitude > config.aimbotMaxDistance then
               aimbotLocked = nil
               return
            end
         end
      end
      if config.aimbotForceConnect then
         if config.aimbotAliveCheck and aimbotLocked.Character:FindFirstChildOfClass("Humanoid").Health <= 0 then
            aimbotLocked = nil
            return
         end
         return
      end
      -- Nếu không force connect, kiểm tra FOV
      local checkPos
      if config.aimbotLockPart == "DirectTouch" then
         checkPos = aimbotGetClosestPartPos(aimbotLocked.Character)
         if not checkPos then aimbotLocked = nil return end
      else
         local part = aimbotLocked.Character:FindFirstChild(config.aimbotLockPart)
         if not part then aimbotLocked = nil return end
         checkPos = part.Position
         local root = aimbotLocked.Character:FindFirstChild("HumanoidRootPart")
         local predRoot = aimbotPredictPosition(aimbotLocked.Character, config.aimbotPredictionValue)
         if root and predRoot then
            checkPos = predRoot + (checkPos - root.Position)
         end
      end
      local vec, _ = camera:WorldToViewportPoint(checkPos)
      local dist = (Vector2.new(UserInputService:GetMouseLocation().X, UserInputService:GetMouseLocation().Y) - Vector2.new(vec.X, vec.Y)).Magnitude
      if dist > config.aimbotFOV then
         aimbotLocked = nil
      end
   end
end

local function aimbotGetClosestZombie()
   if not aimbotLocked then
      local requiredDist = config.aimbotFOV
      local localRoot = getAimbotLocalRoot()
      local localPos = localRoot and localRoot.Position
      local now = tick()
      if not aimbotCacheNPCFolder or (now - aimbotCacheTime) > 2 then
         local gameFolder = workspace:FindFirstChild("Game")
         aimbotCacheNPCFolder = gameFolder and gameFolder:FindFirstChild("Current") and gameFolder.Current:FindFirstChild("Spawned") and gameFolder.Current.Spawned:FindFirstChild("NPCs")
         aimbotCacheTime = now
      end
      if not aimbotCacheNPCFolder or not aimbotCacheNPCFolder.Parent then
         aimbotCacheNPCFolder = nil
         return
      end
      local mouseLoc = UserInputService:GetMouseLocation()
      for _, folder in ipairs(aimbotCacheNPCFolder:GetChildren()) do
         if folder.Name == "friendlies" then continue end
         for _, zombie in ipairs(folder:GetChildren()) do
            if not zombie:IsA("Model") then continue end
            if not zombie:FindFirstChild("HumanoidRootPart") then continue end
            if not zombie:FindFirstChildOfClass("Humanoid") then continue end
            if config.aimbotAliveCheck and zombie:FindFirstChildOfClass("Humanoid").Health <= 0 then continue end
            local targetRoot = zombie:FindFirstChild("HumanoidRootPart")
            if config.aimbotMaxDistance > 0 and localPos then
               if (targetRoot.Position - localPos).Magnitude > config.aimbotMaxDistance then continue end
            end
            local aimPos
            if config.aimbotLockPart == "DirectTouch" then
               aimPos = aimbotGetClosestPartPos(zombie)
               if not aimPos then continue end
            else
               local part = zombie:FindFirstChild(config.aimbotLockPart)
               if not part then continue end
               aimPos = part.Position
               if config.aimbotPrediction then
                  local root = zombie:FindFirstChild("HumanoidRootPart")
                  local predRoot = aimbotPredictPosition(zombie, config.aimbotPredictionValue)
                  if root and predRoot then
                     aimPos = predRoot + (aimPos - root.Position)
                  end
               end
               if config.aimbotWallCheck and #(camera:GetPartsObscuringTarget({aimPos}, zombie:GetDescendants())) > 0 then continue end
            end
            local vec, onScreen = camera:WorldToViewportPoint(aimPos)
            local dist = (mouseLoc - Vector2.new(vec.X, vec.Y)).Magnitude
            if dist < requiredDist and onScreen then
               requiredDist = dist
               aimbotLocked = zombie
            end
         end
      end
   else
      if not aimbotLocked.Parent or not aimbotLocked:FindFirstChildOfClass("Humanoid") then
         aimbotLocked = nil
         return
      end
      if config.aimbotAliveCheck and aimbotLocked:FindFirstChildOfClass("Humanoid").Health <= 0 then
         aimbotLocked = nil
         return
      end
      if not config.aimbotForceConnect then
         local localRoot = getAimbotLocalRoot()
         local targetRoot = aimbotLocked:FindFirstChild("HumanoidRootPart")
         if localRoot and targetRoot and config.aimbotMaxDistance > 0 then
            if (targetRoot.Position - localRoot.Position).Magnitude > config.aimbotMaxDistance then
               aimbotLocked = nil
               return
            end
         end
      end
      if config.aimbotForceConnect then
         return
      end
      local checkPos
      if config.aimbotLockPart == "DirectTouch" then
         checkPos = aimbotGetClosestPartPos(aimbotLocked)
         if not checkPos then aimbotLocked = nil return end
      else
         local part = aimbotLocked:FindFirstChild(config.aimbotLockPart)
         if not part then aimbotLocked = nil return end
         checkPos = part.Position
         if config.aimbotPrediction then
            local root = aimbotLocked:FindFirstChild("HumanoidRootPart")
            local predRoot = aimbotPredictPosition(aimbotLocked, config.aimbotPredictionValue)
            if root and predRoot then
               checkPos = predRoot + (checkPos - root.Position)
            end
         end
      end
      local vec, _ = camera:WorldToViewportPoint(checkPos)
      local dist = (UserInputService:GetMouseLocation() - Vector2.new(vec.X, vec.Y)).Magnitude
      if dist > config.aimbotFOV then
         aimbotLocked = nil
      end
   end
end

-- Hàm xoay camera
local function aimbotMoveCamera(aimPos)
   if not aimPos then return end
   if config.aimbotThirdPerson then
      local vec = camera:WorldToViewportPoint(aimPos)
      local sens = config.aimbotThirdPersonSens or 3
      mousemoverel((vec.X - UserInputService:GetMouseLocation().X) * sens, (vec.Y - UserInputService:GetMouseLocation().Y) * sens)
   else
      if config.aimbotSmooth and config.aimbotSensitivity > 0 then
         if aimbotAnimation then aimbotAnimation:Cancel() end
         aimbotAnimation = TweenService:Create(camera, TweenInfo.new(config.aimbotSensitivity, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), {
            CFrame = CFrame.new(camera.CFrame.Position, aimPos)
         })
         aimbotAnimation:Play()
      else
         camera.CFrame = CFrame.new(camera.CFrame.Position, aimPos)
      end
   end
end

-- Vòng lặp chính của aimbot
RunService.RenderStepped:Connect(function()
   if not config.aimbotEnabled then
      if aimbotLocked then aimbotLocked = nil end
      if aimbotFOVCircle then aimbotFOVCircle.Visible = false end
      if aimbotHighlight then aimbotHighlight.Enabled = false end
      return
   end

   -- Vẽ FOV circle
   if not aimbotFOVCircle then
      aimbotFOVCircle = Drawing.new("Circle")
      aimbotFOVCircle.Thickness = 1
      aimbotFOVCircle.NumSides = 60
      aimbotFOVCircle.Filled = false
      aimbotFOVCircle.Transparency = 0.5
      aimbotFOVCircle.Color = Color3.fromRGB(255,255,255)
   end
   if config.aimbotFOVVisible then
      aimbotFOVCircle.Radius = config.aimbotFOV
      aimbotFOVCircle.Position = UserInputService:GetMouseLocation()
      aimbotFOVCircle.Visible = true
   else
      aimbotFOVCircle.Visible = false
   end

   -- Xử lý trigger
   local triggerPressed = false
   local key = config.aimbotTriggerKey
   if key == "MouseButton1" and UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then
      triggerPressed = true
   elseif key == "MouseButton2" and UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
      triggerPressed = true
   elseif key == "Q" and UserInputService:IsKeyDown(Enum.KeyCode.Q) then
      triggerPressed = true
   end

   if config.aimbotToggle then
      if triggerPressed and not aimbotRunning then
         aimbotRunning = true
      elseif triggerPressed and aimbotRunning then
         aimbotRunning = false
         aimbotLocked = nil
      end
   else
      aimbotRunning = triggerPressed
      if not aimbotRunning then aimbotLocked = nil end
   end

   if not aimbotRunning then
      if aimbotLocked then aimbotLocked = nil end
      if aimbotHighlight then aimbotHighlight.Enabled = false end
      return
   end

   -- Lấy target
   if config.aimbotTargetMode == "Players" then
      aimbotGetClosestPlayer()
   else
      aimbotGetClosestZombie()
   end

   -- Xử lý highlight
   if config.aimbotHighlight then
      local lockedChar
      if aimbotLocked then
         if config.aimbotTargetMode == "Players" then
            lockedChar = aimbotLocked.Character
         else
            lockedChar = aimbotLocked
         end
      end
      if lockedChar then
         if not aimbotHighlight then
            aimbotHighlight = Instance.new("Highlight")
            aimbotHighlight.Name = "AimbotHighlight"
            aimbotHighlight.FillTransparency = 1
            aimbotHighlight.OutlineTransparency = 0
            aimbotHighlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            aimbotHighlight.Parent = workspace
         end
         aimbotHighlight.Adornee = lockedChar
         aimbotHighlight.OutlineColor = Color3.fromRGB(255,70,70)
         aimbotHighlight.Enabled = true
      else
         if aimbotHighlight then aimbotHighlight.Enabled = false end
      end
   else
      if aimbotHighlight then aimbotHighlight.Enabled = false end
   end

   -- Di chuyển camera đến target
   if aimbotLocked then
      local lockedChar
      if config.aimbotTargetMode == "Players" then
         lockedChar = aimbotLocked.Character
      else
         lockedChar = aimbotLocked
      end
      if lockedChar then
         local aimPos
         if config.aimbotLockPart == "DirectTouch" then
            aimPos = aimbotGetClosestPartPos(lockedChar)
         else
            local part = lockedChar:FindFirstChild(config.aimbotLockPart)
            if part then
               aimPos = part.Position
               if config.aimbotPrediction then
                  local root = lockedChar:FindFirstChild("HumanoidRootPart")
                  local predRoot = aimbotPredictPosition(lockedChar, config.aimbotPredictionValue)
                  if root and predRoot then
                     aimPos = predRoot + (aimPos - root.Position)
                  end
               end
            end
         end
         if aimPos then
            aimbotMoveCamera(aimPos)
         end
      end
   end

   -- Vẽ khoảng cách circle
   if config.aimbotDistanceCircle and config.aimbotMaxDistance > 0 then
      if not aimbotDistancePart then
         aimbotDistancePart = Instance.new("Part")
         aimbotDistancePart.Name = "AimbotDistancePart"
         aimbotDistancePart.Anchored = true
         aimbotDistancePart.CanCollide = false
         aimbotDistancePart.Transparency = 1
         aimbotDistancePart.Size = Vector3.new(1,1,1)
         aimbotDistancePart.Parent = workspace
      end
      if #aimbotDistanceAttachments == 0 then
         for i = 1, 48 do
            local a = Instance.new("Attachment")
            a.Parent = aimbotDistancePart
            aimbotDistanceAttachments[i] = a
         end
         for i = 1, 48 do
            local beam = Instance.new("Beam")
            beam.Attachment0 = aimbotDistanceAttachments[i]
            beam.Attachment1 = aimbotDistanceAttachments[(i % 48) + 1]
            beam.FaceCamera = true
            beam.LightEmission = 1
            beam.LightInfluence = 0
            beam.Width0 = 0.15
            beam.Width1 = 0.15
            beam.Transparency = NumberSequence.new(0.35)
            beam.Color = ColorSequence.new(Color3.fromRGB(60,180,90))
            beam.Enabled = true
            beam.Parent = aimbotDistancePart
            aimbotDistanceBeams[i] = beam
         end
      end
      local root = getAimbotLocalRoot()
      if root then
         local yOff = -3
         local hum = lp.Character and lp.Character:FindFirstChildOfClass("Humanoid")
         if hum then yOff = -(hum.HipHeight + 1) end
         aimbotDistancePart.CFrame = CFrame.new(root.Position + Vector3.new(0, yOff, 0))
         local radius = config.aimbotMaxDistance
         for i = 1, 48 do
            local t = (i / 48) * (math.pi * 2)
            aimbotDistanceAttachments[i].Position = Vector3.new(math.cos(t)*radius, 0, math.sin(t)*radius)
         end
         aimbotDistancePart.Transparency = 0
      else
         aimbotDistancePart.Transparency = 1
      end
   else
      if aimbotDistancePart then aimbotDistancePart.Transparency = 1 end
      for _, b in ipairs(aimbotDistanceBeams) do b.Enabled = false end
   end
end)

