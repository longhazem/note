local function EnsureDistanceRing(segments)
    segments = segments or 48
    if DistancePart and DistanceAttachments and DistanceBeams and #DistanceAttachments == segments and #DistanceBeams == segments then return end
    pcall(function() if DistancePart then DistancePart:Destroy() end end)
    DistancePart = Instance.new("Part")
    DistancePart.Name = "Aimbot_DistancePart"
    DistancePart.Anchored = true
    DistancePart.CanCollide = false
    DistancePart.Transparency = 1
    DistancePart.Size = Vector3.new(1,1,1)
    DistancePart.Parent = Workspace
    DistanceAttachments = {}
    DistanceBeams = {}
    for i = 1, segments do
        local a0 = Instance.new("Attachment")
        a0.Name = "Aimbot_DistanceA"..i
        a0.Parent = DistancePart
        DistanceAttachments[i] = a0
    end
    for i = 1, segments do
        local a0 = DistanceAttachments[i]
        local a1 = DistanceAttachments[(i % segments) + 1]
        local beam = Instance.new("Beam")
        beam.Name = "Aimbot_DistanceBeam"..i
        beam.Attachment0 = a0
        beam.Attachment1 = a1
        beam.FaceCamera = true
        beam.LightEmission = 1
        beam.LightInfluence = 0
        beam.Width0 = 0.15
        beam.Width1 = 0.15
        beam.Transparency = NumberSequence.new(0.35)
        beam.Color = ColorSequence.new(Color3.fromRGB(60,180,90))
        beam.Enabled = false
        beam.Parent = DistancePart
        DistanceBeams[i] = beam
    end
end

local function GetLocalRoot()
    local char = lp.Character
    if not char then return nil end
    return char:FindFirstChild("HumanoidRootPart")
end

local function GetLockedCharacter()
    if Environment.Locked then
        if Environment.Settings.TargetMode == "Zombies" then
            return Environment.Locked
        else
            return Environment.Locked.Character
        end
    end
    return nil
end

local function SetHighlight(char)
    if not Environment.Settings.HighlightVisible then
        if HighlightInstance then HighlightInstance.Enabled = false end
        return
    end
    if not char then
        if HighlightInstance then HighlightInstance.Enabled = false end
        return
    end
    if not HighlightInstance then
        pcall(function()
            HighlightInstance = Instance.new("Highlight")
            HighlightInstance.Name = "Aimbot_Highlight"
            HighlightInstance.FillTransparency = 1
            HighlightInstance.OutlineTransparency = 0
            HighlightInstance.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            HighlightInstance.Parent = Workspace
        end)
    end
    if HighlightInstance then
        HighlightInstance.Adornee = char
        HighlightInstance.OutlineColor = Environment.FOVSettings.LockedColor
        HighlightInstance.Enabled = true
    end
end

local function CancelLock()
    Environment.Locked = nil
    if Animation then Animation:Cancel() end
    Environment.FOVCircle.Color = Environment.FOVSettings.Color
    SetHighlight(nil)
end

local function PredictPosition(char, mul)
    if not Environment.Settings.PredictionEnabled then return nil end
    local root = char:FindFirstChild("HumanoidRootPart")
    if root and type(mul)=="number" and mul>0 then
        local vel = root.Velocity
        return root.Position + vel * mul
    end
    return nil
end

local function GetClosestPartPos(char)
    local mousePos = UserInputService:GetMouseLocation()
    local closestDist = math.huge
    local closestPos = nil
    local rootPart = char:FindFirstChild("HumanoidRootPart")
    if not rootPart then return nil end
    local predRoot = PredictPosition(char, Environment.Settings.Prediction)
    for _, partName in ipairs(bodyParts) do
        local part = char:FindFirstChild(partName)
        if part then
            if Environment.Settings.WallCheck and #(Camera:GetPartsObscuringTarget({part.Position}, char:GetDescendants())) > 0 then continue end
            local pos = part.Position
            if predRoot then
                local offset = pos - rootPart.Position
                pos = predRoot + offset
            end
            local vec, onScreen = Camera:WorldToViewportPoint(pos)
            if onScreen then
                local dist = (Vector2.new(mousePos.X, mousePos.Y) - Vector2.new(vec.X, vec.Y)).Magnitude
                if dist < closestDist then
                    closestDist = dist
                    closestPos = pos
                end
            end
        end
    end
    return closestPos or rootPart.Position
end

local function GetClosestPlayer()
    if not Environment.Locked then
        RequiredDistance = (Environment.FOVSettings.Enabled and Environment.FOVSettings.Amount or 2000)
        local localRoot = GetLocalRoot()
        local localPos = localRoot and localRoot.Position
        for _, v in next, Players:GetPlayers() do
            if v ~= lp and not Environment.IgnoreList[v] then
                if v.Character and v.Character:FindFirstChildOfClass("Humanoid") then
                    if Environment.Settings.TeamCheck and v.Team == lp.Team then continue end
                    if Environment.Settings.AliveCheck and v.Character:FindFirstChildOfClass("Humanoid").Health <= 0 then continue end
                    if localPos then
                        local targetRoot = v.Character:FindFirstChild("HumanoidRootPart")
                        if targetRoot and type(Environment.Settings.MaxDistance) == "number" and Environment.Settings.MaxDistance > 0 then
                            if (targetRoot.Position - localPos).Magnitude > Environment.Settings.MaxDistance then continue end
                        end
                    end
                    local aimPos
                    if Environment.Settings.LockPart == "DirectTouch" then
                        aimPos = GetClosestPartPos(v.Character)
                        if not aimPos then continue end
                    else
                        if not v.Character:FindFirstChild(Environment.Settings.LockPart) then continue end
                        local part = v.Character[Environment.Settings.LockPart]
                        aimPos = part.Position
                        local root = v.Character:FindFirstChild("HumanoidRootPart")
                        local predRoot = PredictPosition(v.Character, Environment.Settings.Prediction)
                        if root and predRoot then
                            local offset = aimPos - root.Position
                            aimPos = predRoot + offset
                        end
                        if Environment.Settings.WallCheck and #(Camera:GetPartsObscuringTarget({aimPos}, v.Character:GetDescendants())) > 0 then continue end
                    end
                    local Vector, OnScreen = Camera:WorldToViewportPoint(aimPos)
                    local Distance = (Vector2.new(UserInputService:GetMouseLocation().X, UserInputService:GetMouseLocation().Y) - Vector2.new(Vector.X, Vector.Y)).Magnitude
                    if Distance < RequiredDistance and OnScreen then
                        RequiredDistance = Distance
                        Environment.Locked = v
                    end
                end
            end
        end
    elseif Environment.Locked then
        if not Environment.Locked.Character or not Environment.Locked.Character:FindFirstChildOfClass("Humanoid") then
            CancelLock()
            return
        end
        if not Environment.Settings.ForceConnect then
            local localRoot = GetLocalRoot()
            local targetRoot = Environment.Locked.Character:FindFirstChild("HumanoidRootPart")
            if localRoot and targetRoot and type(Environment.Settings.MaxDistance) == "number" and Environment.Settings.MaxDistance > 0 then
                if (targetRoot.Position - localRoot.Position).Magnitude > Environment.Settings.MaxDistance then
                    CancelLock()
                    return
                end
            end
        end
        if Environment.Settings.ForceConnect then
            if Environment.Settings.AliveCheck and Environment.Locked.Character:FindFirstChildOfClass("Humanoid").Health <= 0 then
                CancelLock()
                return
            end
            return
        end
        local checkPos
        if Environment.Settings.LockPart == "DirectTouch" then
            checkPos = GetClosestPartPos(Environment.Locked.Character)
            if not checkPos then CancelLock(); return end
        else
            local part = Environment.Locked.Character:FindFirstChild(Environment.Settings.LockPart)
            if not part then CancelLock(); return end
            checkPos = part.Position
            local root = Environment.Locked.Character:FindFirstChild("HumanoidRootPart")
            local predRoot = PredictPosition(Environment.Locked.Character, Environment.Settings.Prediction)
            if root and predRoot then
                local offset = checkPos - root.Position
                checkPos = predRoot + offset
            end
        end
        local Vector, _ = Camera:WorldToViewportPoint(checkPos)
        local Distance = (Vector2.new(UserInputService:GetMouseLocation().X, UserInputService:GetMouseLocation().Y) - Vector2.new(Vector.X, Vector.Y)).Magnitude
        if Distance > RequiredDistance then CancelLock() end
    end
end

local function GetClosestZombie()
    if not Environment.Locked then
        RequiredDistance = (Environment.FOVSettings.Enabled and Environment.FOVSettings.Amount or 2000)
        local localRoot = GetLocalRoot()
        local localPos = localRoot and localRoot.Position
        local now = tick()
        if not cachedNPCFolder or (now - cachedNPCFolderTime) > NPC_FOLDER_CACHE_INTERVAL then
            local gameFolder = Workspace:FindFirstChild("Game")
            cachedNPCFolder = gameFolder and gameFolder:FindFirstChild("Current") and gameFolder.Current:FindFirstChild("Spawned") and gameFolder.Current.Spawned:FindFirstChild("NPCs")
            cachedNPCFolderTime = now
        end
        if not cachedNPCFolder or not cachedNPCFolder.Parent then
            cachedNPCFolder = nil
            return
        end
        local mouseLoc = UserInputService:GetMouseLocation()
        local maxDist = type(Environment.Settings.MaxDistance) == "number" and Environment.Settings.MaxDistance > 0 and Environment.Settings.MaxDistance or nil
        local predEnabled = Environment.Settings.PredictionEnabled
        local predValue = Environment.Settings.Prediction
        local lockPartName = Environment.Settings.LockPart
        local aliveCheck = Environment.Settings.AliveCheck
        local wallCheck = Environment.Settings.WallCheck
        for _, folder in ipairs(cachedNPCFolder:GetChildren()) do
            if folder.Name == "friendlies" then continue end
            for _, zombie in ipairs(folder:GetChildren()) do
                if not zombie:IsA("Model") then continue end
                if not zombie:FindFirstChild("HumanoidRootPart") then continue end
                if not zombie:FindFirstChildOfClass("Humanoid") then continue end
                if Environment.IgnoreList[zombie] then continue end
                if aliveCheck and zombie:FindFirstChildOfClass("Humanoid").Health <= 0 then continue end
                local targetRoot = zombie:FindFirstChild("HumanoidRootPart")
                if maxDist and localPos then
                    if (targetRoot.Position - localPos).Magnitude > maxDist then continue end
                end
                local aimPos
                if lockPartName == "DirectTouch" then
                    aimPos = GetClosestPartPos(zombie)
                    if not aimPos then continue end
                else
                    local part = zombie:FindFirstChild(lockPartName)
                    if not part then continue end
                    aimPos = part.Position
                    if predEnabled then
                        local root = zombie:FindFirstChild("HumanoidRootPart")
                        local predRoot = PredictPosition(zombie, predValue)
                        if root and predRoot then
                            aimPos = predRoot + (aimPos - root.Position)
                        end
                    end
                    if wallCheck and #(Camera:GetPartsObscuringTarget({aimPos}, zombie:GetDescendants())) > 0 then continue end
                end
                local Vector, OnScreen = Camera:WorldToViewportPoint(aimPos)
                local Distance = (mouseLoc - Vector2.new(Vector.X, Vector.Y)).Magnitude
                if Distance < RequiredDistance and OnScreen then
                    RequiredDistance = Distance
                    Environment.Locked = zombie
                end
            end
        end
    elseif Environment.Locked then
        if not Environment.Locked.Parent or not Environment.Locked:FindFirstChildOfClass("Humanoid") then
            CancelLock()
            return
        end
        if Environment.Settings.AliveCheck and Environment.Locked:FindFirstChildOfClass("Humanoid").Health <= 0 then
            CancelLock()
            return
        end
        if not Environment.Settings.ForceConnect then
            local localRoot = GetLocalRoot()
            local targetRoot = Environment.Locked:FindFirstChild("HumanoidRootPart")
            if localRoot and targetRoot and type(Environment.Settings.MaxDistance) == "number" and Environment.Settings.MaxDistance > 0 then
                if (targetRoot.Position - localRoot.Position).Magnitude > Environment.Settings.MaxDistance then
                    CancelLock()
                    return
                end
            end
        end
        if Environment.Settings.ForceConnect then return end
        local checkPos
        if Environment.Settings.LockPart == "DirectTouch" then
            checkPos = GetClosestPartPos(Environment.Locked)
            if not checkPos then CancelLock(); return end
        else
            local part = Environment.Locked:FindFirstChild(Environment.Settings.LockPart)
            if not part then CancelLock(); return end
            checkPos = part.Position
            local root = Environment.Locked:FindFirstChild("HumanoidRootPart")
            local predRoot = PredictPosition(Environment.Locked, Environment.Settings.Prediction)
            if root and predRoot then
                local offset = checkPos - root.Position
                checkPos = predRoot + offset
            end
        end
        local Vector, _ = Camera:WorldToViewportPoint(checkPos)
        local Distance = (UserInputService:GetMouseLocation() - Vector2.new(Vector.X, Vector.Y)).Magnitude
        if Distance > RequiredDistance then CancelLock() end
    end
end

local function setupInvisibleCharacter()
    invisibleChar = lp.Character or lp.CharacterAdded:Wait()
    invisibleHumanoid = invisibleChar:WaitForChild("Humanoid")
    invisibleRootPart = invisibleChar:WaitForChild("HumanoidRootPart")
    invisibleParts = {}
    for _, obj in pairs(invisibleChar:GetDescendants()) do
        if obj:IsA("BasePart") and obj.Transparency == 0 then
            table.insert(invisibleParts, obj)
        end
    end
end

local function startInvisible()
    if invisibleActive then return end
    invisibleActive = true
    pcall(setupInvisibleCharacter)
    for _, part in pairs(invisibleParts) do
        if part and part.Parent then
            part.Transparency = 0.5
        end
    end
    invisibleHBConnection = RunService.Heartbeat:Connect(function()
        if invisibleActive and invisibleRootPart and invisibleRootPart.Parent and invisibleHumanoid and invisibleHumanoid.Parent then
            pcall(function()
                local cf = invisibleRootPart.CFrame
                local camOffset = invisibleHumanoid.CameraOffset
                local offset = Environment.Settings.InvisibleOffsetY or 100
                local hidden = cf * CFrame.new(0, offset, 0)
                invisibleRootPart.CFrame = hidden
                invisibleHumanoid.CameraOffset = hidden:ToObjectSpace(CFrame.new(cf.Position)).Position
                RunService.RenderStepped:Wait()
                invisibleRootPart.CFrame = cf
                invisibleHumanoid.CameraOffset = camOffset
            end)
        end
    end)
    invisibleCharAddedConnection = lp.CharacterAdded:Connect(function()
        task.wait(0.5)
        invisibleActive = false
        pcall(setupInvisibleCharacter)
        invisibleActive = true
    end)
end

local function stopInvisible()
    invisibleActive = false
    if invisibleHBConnection then invisibleHBConnection:Disconnect(); invisibleHBConnection = nil end
    if invisibleCharAddedConnection then invisibleCharAddedConnection:Disconnect(); invisibleCharAddedConnection = nil end
    for _, part in pairs(invisibleParts) do
        if part and part.Parent then
            part.Transparency = 0
        end
    end
    invisibleParts = {}
    pcall(function()
        if invisibleHumanoid and invisibleHumanoid.Parent then
            invisibleHumanoid.CameraOffset = Vector3.new(0,0,0)
        end
    end)
end

local function LoadAimbot()
    ServiceConnections.RenderSteppedConnection = RunService.RenderStepped:Connect(function()
        if Environment.FOVSettings.Enabled and Environment.Settings.Enabled then
            Environment.FOVCircle.Radius = Environment.FOVSettings.Amount
            Environment.FOVCircle.Thickness = Environment.FOVSettings.Thickness
            Environment.FOVCircle.Filled = Environment.FOVSettings.Filled
            Environment.FOVCircle.NumSides = Environment.FOVSettings.Sides
            Environment.FOVCircle.Color = Environment.FOVSettings.Color
            Environment.FOVCircle.Transparency = Environment.FOVSettings.Transparency
            Environment.FOVCircle.Visible = Environment.FOVSettings.Visible
            Environment.FOVCircle.Position = Vector2.new(UserInputService:GetMouseLocation().X, UserInputService:GetMouseLocation().Y)
        else
            Environment.FOVCircle.Visible = false
        end
        if Environment.StatusCircle then
            local cameraView = Camera.ViewportSize
            Environment.StatusCircle.Position = Vector2.new(cameraView.X - 20, cameraView.Y - 20)
            Environment.StatusCircle.Color = Environment.Settings.Enabled and Color3.fromRGB(0,255,0) or Color3.fromRGB(255,0,0)
            if Environment.StatusText then
                Environment.StatusText.Position = Environment.StatusCircle.Position
                if Environment.Locked then
                    local lockedChar = GetLockedCharacter()
                    if lockedChar then
                        local localRoot = GetLocalRoot()
                        local targetRoot = lockedChar:FindFirstChild("HumanoidRootPart")
                        if localRoot and targetRoot then
                            local dist = (targetRoot.Position - localRoot.Position).Magnitude
                            Environment.StatusText.Text = tostring(math.floor(dist))
                        else
                            Environment.StatusText.Text = "-"
                        end
                    else
                        Environment.StatusText.Text = "-"
                    end
                else
                    Environment.StatusText.Text = Environment.Settings.Enabled and "ON" or "OFF"
                end
                Environment.StatusText.Visible = true
            end
        end
        if Running and Environment.Settings.Enabled then
            if Environment.Settings.TargetMode == "Zombies" then
                GetClosestZombie()
            else
                GetClosestPlayer()
            end
            if Environment.Locked then
                local lockedChar = GetLockedCharacter()
                if not lockedChar then
                    SetHighlight(nil)
                else
                    if Environment.Settings.HighlightVisible then
                        SetHighlight(lockedChar)
                    else
                        SetHighlight(nil)
                    end
                    local aimPosition
                    if Environment.Settings.LockPart == "DirectTouch" then
                        aimPosition = GetClosestPartPos(lockedChar)
                    else
                        local part = lockedChar:FindFirstChild(Environment.Settings.LockPart)
                        if not part then CancelLock(); SetHighlight(nil); return end
                        aimPosition = part.Position
                        local root = lockedChar:FindFirstChild("HumanoidRootPart")
                        local predRoot = PredictPosition(lockedChar, Environment.Settings.Prediction)
                        if root and predRoot then
                            local offset = aimPosition - root.Position
                            aimPosition = predRoot + offset
                        end
                    end
                    if not Environment.Settings.SilentAim then
                        if Environment.Settings.ThirdPerson then
                            Environment.Settings.ThirdPersonSensitivity = math.clamp(Environment.Settings.ThirdPersonSensitivity, 0.1, 5)
                            local Vector = Camera:WorldToViewportPoint(aimPosition)
                            local mousemoverel = mousemoverel or (Input and Input.MouseMove)
                            if mousemoverel then
                                mousemoverel((Vector.X - UserInputService:GetMouseLocation().X) * Environment.Settings.ThirdPersonSensitivity, (Vector.Y - UserInputService:GetMouseLocation().Y) * Environment.Settings.ThirdPersonSensitivity)
                            end
                        else
                            if Environment.Settings.Sensitivity > 0 or Environment.Settings.SmoothAim then
                                if Environment.Settings.SmoothAim and Environment.Settings.Sensitivity==0 then
                                    local current = Camera.CFrame
                                    local target = CFrame.new(Camera.CFrame.Position, aimPosition)
                                    Camera.CFrame = current:Lerp(target, 0.15)
                                else
                                    Animation = TweenService:Create(Camera, TweenInfo.new(Environment.Settings.Sensitivity, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), {CFrame = CFrame.new(Camera.CFrame.Position, aimPosition)})
                                    Animation:Play()
                                end
                            else
                                Camera.CFrame = CFrame.new(Camera.CFrame.Position, aimPosition)
                            end
                        end
                    end
                    Environment.FOVCircle.Color = Environment.FOVSettings.LockedColor
                end
            else
                SetHighlight(nil)
            end
        else
            SetHighlight(nil)
        end
        do
            local root = GetLocalRoot()
            local visible = Environment.Settings.DistanceCircleVisible and type(Environment.Settings.MaxDistance) == "number" and Environment.Settings.MaxDistance > 0
            if visible and root then
                EnsureDistanceRing(48)
                local yOffset = -3
                local hum = lp.Character and lp.Character:FindFirstChildOfClass("Humanoid")
                if hum then yOffset = -(hum.HipHeight + 1) end
                local center = root.Position + Vector3.new(0, yOffset, 0)
                DistancePart.CFrame = CFrame.new(center)
                local radius = Environment.Settings.MaxDistance
                local seg = #DistanceAttachments
                for i = 1, seg do
                    local t = (i / seg) * (math.pi * 2)
                    DistanceAttachments[i].Position = Vector3.new(math.cos(t) * radius, 0, math.sin(t) * radius)
                end
                for i = 1, #DistanceBeams do
                    DistanceBeams[i].Enabled = true
                end
            else
                if DistanceBeams then
                    for i = 1, #DistanceBeams do
                        DistanceBeams[i].Enabled = false
                    end
                end
            end
        end
    end)
    ServiceConnections.InputBeganConnection = UserInputService.InputBegan:Connect(function(Input)
        if not Typing then
            pcall(function()
                local key = Environment.Settings.TriggerKey
                if key == "MouseButton1" and Input.UserInputType == Enum.UserInputType.MouseButton1 then
                    Running = Environment.Settings.Toggle and not Running or true
                    if not Running then CancelLock() end
                elseif key == "MouseButton2" and Input.UserInputType == Enum.UserInputType.MouseButton2 then
                    Running = Environment.Settings.Toggle and not Running or true
                    if not Running then CancelLock() end
                elseif key == "Q" and Input.KeyCode == Enum.KeyCode.Q then
                    Running = Environment.Settings.Toggle and not Running or true
                    if not Running then CancelLock() end
                end
            end)
        end
    end)
    ServiceConnections.InputEndedConnection = UserInputService.InputEnded:Connect(function(Input)
        if not Typing then
            if not Environment.Settings.Toggle then
                pcall(function()
                    local key = Environment.Settings.TriggerKey
                    if key == "MouseButton1" and Input.UserInputType == Enum.UserInputType.MouseButton1 then
                        Running = false; CancelLock()
                    elseif key == "MouseButton2" and Input.UserInputType == Enum.UserInputType.MouseButton2 then
                        Running = false; CancelLock()
                    elseif key == "Q" and Input.KeyCode == Enum.KeyCode.Q then
                        Running = false; CancelLock()
                    end
                end)
            end
        end
    end)
    lp.CharacterAdded:Connect(function() CancelLock() end)
end

Environment.Functions = {}
function Environment.Functions:Exit()
    stopInvisible()
    for _, v in next, ServiceConnections do v:Disconnect() end
    if Environment.FOVCircle.Remove then Environment.FOVCircle:Remove() end
    if Environment.StatusCircle.Remove then Environment.StatusCircle:Remove() end
    if Environment.StatusText and Environment.StatusText.Remove then Environment.StatusText:Remove() end
    pcall(function() if DistancePart then DistancePart:Destroy() end end)
    DistancePart, DistanceAttachments, DistanceBeams = nil, nil, nil
    getgenv().Aimbot = nil
end

function Environment.Functions:Restart()
    for _, v in next, ServiceConnections do v:Disconnect() end
    LoadAimbot()
end

function Environment.Functions:SaveSettings()
    local success = pcall(function()
        local data = { Settings = Environment.Settings, FOVSettings = Environment.FOVSettings }
        local json = game:GetService("HttpService"):JSONEncode(data)
        writefile("Aimbot_Settings.json", json)
    end)
    return success
end

function Environment.Functions:LoadSettings()
    pcall(function()
        local json = readfile("Aimbot_Settings.json")
        if json and #json > 0 then
            local data = game:GetService("HttpService"):JSONDecode(json)
            if type(data.Settings) == "table" then
                for k, v in pairs(data.Settings) do Environment.Settings[k] = v end
            end
            if type(data.FOVSettings) == "table" then
                for k, v in pairs(data.FOVSettings) do Environment.FOVSettings[k] = v end
            end
        end
    end)
end

