--// Main loop
local function Load()
	ServiceConnections.RenderSteppedConnection = RunService.RenderStepped:Connect(function()
		if Environment.FOVSettings.Enabled and Environment.Settings.Enabled then
			Environment.FOVCircle.Radius = Environment.FOVSettings.Amount
			Environment.FOVCircle.Thickness = Environment.FOVSettings.Thickness
			Environment.FOVCircle.Filled = Environment.FOVSettings.Filled
			Environment.FOVCircle.NumSides = Environment.FOVSettings.Sides
			Environment.FOVCircle.Color = Environment.FOVSettings.Color
			Environment.FOVCircle.Transparency = Environment.FOVSettings.Transparency
			Environment.FOVCircle.Visible = Environment.FOVSettings.Visible
			Environment.FOVCircle.Position = Vector2(UserInputService:GetMouseLocation().X, UserInputService:GetMouseLocation().Y)
		else
			Environment.FOVCircle.Visible = false
		end

		-- Update status circle position and color
		if Environment.StatusCircle then
			local cameraView = Camera.ViewportSize
			Environment.StatusCircle.Position = Vector2(cameraView.X - 20, cameraView.Y - 20)
			
			if Environment.Settings.Enabled then
				Environment.StatusCircle.Color = Color3.fromRGB(0, 255, 0) -- Green when ON
			else
				Environment.StatusCircle.Color = Color3.fromRGB(255, 0, 0) -- Red when OFF
			end

			-- Status text position + content
			if Environment.StatusText then
				Environment.StatusText.Position = Environment.StatusCircle.Position
				if Environment.Locked then
					local lockedChar = GetLockedCharacter()
					if lockedChar then
						local localRoot = GetLocalRoot()
						local targetRoot = lockedChar:FindFirstChild("HumanoidRootPart")
						if localRoot and targetRoot then
							local dist = (targetRoot.Position - localRoot.Position).Magnitude
							Environment.StatusText.Text = tostring(math.floor(dist))
						else
							Environment.StatusText.Text = "-"
						end
					else
						Environment.StatusText.Text = "-"
					end
				else
					Environment.StatusText.Text = Environment.Settings.Enabled and "ON" or "OFF"
				end
				Environment.StatusText.Visible = true
			end
		end

		if Running and Environment.Settings.Enabled then
			if Environment.Settings.TargetMode == "Zombies" then
				GetClosestZombie()
			else
				GetClosestPlayer()
			end

			if Environment.Locked then
				local lockedChar = GetLockedCharacter()
				if not lockedChar then
					SetHighlight(nil)
				else
					if Environment.Settings.HighlightVisible then
						SetHighlight(lockedChar)
					else
						SetHighlight(nil)
					end

					local aimPosition
					if Environment.Settings.LockPart == "DirectTouch" then
						aimPosition = GetClosestPartPos(lockedChar)
					else
						local part = lockedChar:FindFirstChild(Environment.Settings.LockPart)
						if not part then
							CancelLock()
							SetHighlight(nil)
							return
						end
						aimPosition = part.Position
						local root = lockedChar:FindFirstChild("HumanoidRootPart")
						local predRoot = PredictPosition(lockedChar, Environment.Settings.Prediction)
						if root and predRoot then
							local offset = aimPosition - root.Position
							aimPosition = predRoot + offset
						end
					end

					if Environment.Settings.ThirdPerson then
						Environment.Settings.ThirdPersonSensitivity = mathclamp(Environment.Settings.ThirdPersonSensitivity, 0.1, 5)

						local Vector = Camera:WorldToViewportPoint(aimPosition)
						mousemoverel((Vector.X - UserInputService:GetMouseLocation().X) * Environment.Settings.ThirdPersonSensitivity, (Vector.Y - UserInputService:GetMouseLocation().Y) * Environment.Settings.ThirdPersonSensitivity)
					else
						if Environment.Settings.Sensitivity > 0 or Environment.Settings.SmoothAim then
							if Environment.Settings.SmoothAim and Environment.Settings.Sensitivity==0 then
								local current = Camera.CFrame
								local target = CFrame.new(Camera.CFrame.Position, aimPosition)
								Camera.CFrame = current:Lerp(target, math.clamp(0.15,0,1))
							else
								Animation = TweenService:Create(Camera, TweenInfo.new(Environment.Settings.Sensitivity, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), {CFrame = CFrame.new(Camera.CFrame.Position, aimPosition)})
								Animation:Play()
							end
						else
							Camera.CFrame = CFrame.new(Camera.CFrame.Position, aimPosition)
						end
					end

					Environment.FOVCircle.Color = Environment.FOVSettings.LockedColor
				end
			else
				SetHighlight(nil)
			end
		else
			SetHighlight(nil)
		end

		-- Distance circle / ring
		do
			local root = GetLocalRoot()
			local visible = Environment.Settings.DistanceCircleVisible and type(Environment.Settings.MaxDistance) == "number" and Environment.Settings.MaxDistance > 0
			if visible and root then
				EnsureDistanceRing(48)
				local yOffset = -3
				local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
				if hum then
					yOffset = -(hum.HipHeight + 1)
				end
				local center = root.Position + Vector3.new(0, yOffset, 0)
				DistancePart.CFrame = CFrame.new(center)

				local radius = Environment.Settings.MaxDistance
				local seg = #DistanceAttachments
				for i = 1, seg do
					local t = (i / seg) * (math.pi * 2)
					DistanceAttachments[i].Position = Vector3.new(math.cos(t) * radius, 0, math.sin(t) * radius)
				end
				for i = 1, #DistanceBeams do
					DistanceBeams[i].Enabled = true
				end
			else
				if DistanceBeams then
					for i = 1, #DistanceBeams do
						DistanceBeams[i].Enabled = false
					end
				end
			end
		end
	end)

	ServiceConnections.InputBeganConnection = UserInputService.InputBegan:Connect(function(Input)
		if not Typing then
			pcall(function()
				if Environment.Settings.TriggerKey == "MouseButton1" and Input.UserInputType == Enum.UserInputType.MouseButton1 then
					if Environment.Settings.Toggle then
						Running = not Running
						if not Running then CancelLock() end
					else
						Running = true
					end
				elseif Environment.Settings.TriggerKey == "MouseButton2" and Input.UserInputType == Enum.UserInputType.MouseButton2 then
					if Environment.Settings.Toggle then
						Running = not Running
						if not Running then CancelLock() end
					else
						Running = true
					end
				elseif Environment.Settings.TriggerKey == "Q" and Input.KeyCode == Enum.KeyCode.Q then
					if Environment.Settings.Toggle then
						Running = not Running
						if not Running then CancelLock() end
					else
						Running = true
					end
				end
			end)
		end
	end)

	ServiceConnections.InputEndedConnection = UserInputService.InputEnded:Connect(function(Input)
		if not Typing then
			if not Environment.Settings.Toggle then
				pcall(function()
					if Environment.Settings.TriggerKey == "MouseButton1" and Input.UserInputType == Enum.UserInputType.MouseButton1 then
						Running = false; CancelLock()
					elseif Environment.Settings.TriggerKey == "MouseButton2" and Input.UserInputType == Enum.UserInputType.MouseButton2 then
						Running = false; CancelLock()
					elseif Environment.Settings.TriggerKey == "Q" and Input.KeyCode == Enum.KeyCode.Q then
						Running = false; CancelLock()
					end
				end)
			end
		end
	end)

	-- Add a listener for character reset to clear the locked target
	LocalPlayer.CharacterAdded:Connect(function()
		CancelLock() -- Clear the locked target when the character resets
	end)
end

--// Invisible Mode Functions
local function setupInvisibleCharacter()
	invisibleChar = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
	invisibleHumanoid = invisibleChar:WaitForChild("Humanoid")
	invisibleRootPart = invisibleChar:WaitForChild("HumanoidRootPart")
	invisibleParts = {}
	for _, obj in pairs(invisibleChar:GetDescendants()) do
		if obj:IsA("BasePart") and obj.Transparency == 0 then
			table.insert(invisibleParts, obj)
		end
	end
end

local function startInvisible()
	if invisibleActive then return end
	invisibleActive = true

	pcall(setupInvisibleCharacter)

	-- Make parts semi-transparent
	for _, part in pairs(invisibleParts) do
		if part and part.Parent then
			part.Transparency = 0.5
		end
	end

	-- Heartbeat loop for CFrame invisibility
	invisibleHBConnection = RunService.Heartbeat:Connect(function()
		if invisibleActive and invisibleRootPart and invisibleRootPart.Parent and invisibleHumanoid and invisibleHumanoid.Parent then
			pcall(function()
				local cf = invisibleRootPart.CFrame
				local camOffset = invisibleHumanoid.CameraOffset
				local offset = Environment.Settings.InvisibleOffsetY or 100
				local hidden = cf * CFrame.new(0, offset, 0)
				invisibleRootPart.CFrame = hidden
				invisibleHumanoid.CameraOffset = hidden:ToObjectSpace(CFrame.new(cf.Position)).Position
				RunService.RenderStepped:Wait()
				invisibleRootPart.CFrame = cf
				invisibleHumanoid.CameraOffset = camOffset
			end)
		end
	end)

	-- Respawn setup
	invisibleCharAddedConnection = LocalPlayer.CharacterAdded:Connect(function()
		task.wait(0.5)
		invisibleActive = false
		pcall(setupInvisibleCharacter)
		invisibleActive = true
	end)
end

local function stopInvisible()
	invisibleActive = false

	if invisibleHBConnection then
		invisibleHBConnection:Disconnect()
		invisibleHBConnection = nil
	end
	if invisibleCharAddedConnection then
		invisibleCharAddedConnection:Disconnect()
		invisibleCharAddedConnection = nil
	end

	-- Restore original transparency
	for _, part in pairs(invisibleParts) do
		if part and part.Parent then
			part.Transparency = 0
		end
	end
	invisibleParts = {}

	-- Restore camera offset
	pcall(function()
		if invisibleHumanoid and invisibleHumanoid.Parent then
			invisibleHumanoid.CameraOffset = Vector3.new(0, 0, 0)
		end
	end)
end

