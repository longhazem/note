Environment.StatusCircle.Thickness = 2
Environment.StatusCircle.Filled = true
Environment.StatusCircle.NumSides = 60
Environment.StatusCircle.Transparency = 0.6
Environment.StatusCircle.Visible = true

--// Status Text (inside StatusCircle)
Environment.StatusText = Drawing.new("Text")
Environment.StatusText.Size = 14
Environment.StatusText.Center = true
Environment.StatusText.Outline = false
Environment.StatusText.Color = Color3.fromRGB(0, 0, 0)
Environment.StatusText.Transparency = 0.9
Environment.StatusText.Visible = true

--// Internal helpers
local HighlightInstance
local DistancePart
local DistanceAttachments
local DistanceBeams

local function EnsureDistanceRing(segments)
	segments = segments or 48
	if DistancePart and DistanceAttachments and DistanceBeams and #DistanceAttachments == segments and #DistanceBeams == segments then
		return
	end
	pcall(function()
		if DistancePart then DistancePart:Destroy() end
	end)
	DistancePart = Instance.new("Part")
	DistancePart.Name = "Aimbot_DistancePart"
	DistancePart.Anchored = true
	DistancePart.CanCollide = false
	DistancePart.Transparency = 1
	DistancePart.Size = Vector3.new(1, 1, 1)
	DistancePart.Parent = workspace

	DistanceAttachments = {}
	DistanceBeams = {}

	for i = 1, segments do
		local a0 = Instance.new("Attachment")
		a0.Name = "Aimbot_DistanceA" .. i
		a0.Parent = DistancePart
		DistanceAttachments[i] = a0
	end

	for i = 1, segments do
		local a0 = DistanceAttachments[i]
		local a1 = DistanceAttachments[(i % segments) + 1]
		local beam = Instance.new("Beam")
		beam.Name = "Aimbot_DistanceBeam" .. i
		beam.Attachment0 = a0
		beam.Attachment1 = a1
		beam.FaceCamera = true
		beam.LightEmission = 1
		beam.LightInfluence = 0
		beam.Width0 = 0.15
		beam.Width1 = 0.15
		beam.Transparency = NumberSequence.new(0.35)
		beam.Color = ColorSequence.new(Color3.fromRGB(60, 180, 90))
		beam.Enabled = false
		beam.Parent = DistancePart
		DistanceBeams[i] = beam
	end
end

local function GetLocalRoot()
	local char = LocalPlayer.Character
	if not char then return nil end
	return char:FindFirstChild("HumanoidRootPart")
end

local function GetLockedCharacter()
	if Environment.Locked then
		if Environment.Settings.TargetMode == "Zombies" then
			return Environment.Locked
		else
			return Environment.Locked.Character
		end
	end
	return nil
end

local function SetHighlight(char)
	if not Environment.Settings.HighlightVisible then
		if HighlightInstance then HighlightInstance.Enabled = false end
		return
	end
	if not char then
		if HighlightInstance then HighlightInstance.Enabled = false end
		return
	end
	if not HighlightInstance then
		pcall(function()
			HighlightInstance = Instance.new("Highlight")
			HighlightInstance.Name = "Aimbot_Highlight"
			HighlightInstance.FillTransparency = 1
			HighlightInstance.OutlineTransparency = 0
			HighlightInstance.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
			HighlightInstance.Parent = workspace
		end)
	end
	if HighlightInstance then
		HighlightInstance.Adornee = char
		HighlightInstance.OutlineColor = Environment.FOVSettings.LockedColor
		HighlightInstance.Enabled = true
	end
end

local function CancelLock()
	Environment.Locked = nil
	if Animation then Animation:Cancel() end
	Environment.FOVCircle.Color = Environment.FOVSettings.Color
	SetHighlight(nil)
end

local function PredictPosition(char, mul)
	-- Simple linear velocity prediction if HumanoidRootPart exists
	if not Environment.Settings.PredictionEnabled then
		return nil
	end
	local root = char:FindFirstChild("HumanoidRootPart")
	if root and type(mul)=="number" and mul>0 then
		local vel = root.Velocity
		return root.Position + vel * mul
	end
	return nil
end

local function GetClosestPartPos(char)
	local mousePos = UserInputService:GetMouseLocation()
	local closestDist = math.huge
	local closestPos = nil
	local rootPart = char:FindFirstChild("HumanoidRootPart")
	if not rootPart then return nil end
	local predRoot = PredictPosition(char, Environment.Settings.Prediction)
	for _, partName in ipairs(bodyParts) do
		local part = char:FindFirstChild(partName)
		if part then
			if Environment.Settings.WallCheck and #(Camera:GetPartsObscuringTarget({part.Position}, char:GetDescendants())) > 0 then continue end
			local pos = part.Position
			if predRoot then
				local offset = pos - rootPart.Position
				pos = predRoot + offset
			end
			local vec, onScreen = Camera:WorldToViewportPoint(pos)
			if onScreen then
				local dist = (Vector2(mousePos.X, mousePos.Y) - Vector2(vec.X, vec.Y)).Magnitude
				if dist < closestDist then
					closestDist = dist
					closestPos = pos
				end
			end
		end
	end
	return closestPos or rootPart.Position -- fallback to root
end

local function GetClosestPlayer()
	if not Environment.Locked then
		RequiredDistance = (Environment.FOVSettings.Enabled and Environment.FOVSettings.Amount or 2000)
		local localRoot = GetLocalRoot()
		local localPos = localRoot and localRoot.Position

		for _, v in next, Players:GetPlayers() do
			if v ~= LocalPlayer and not Environment.IgnoreList[v] then
				if v.Character and v.Character:FindFirstChildOfClass("Humanoid") then
					if Environment.Settings.TeamCheck and v.Team == LocalPlayer.Team then continue end
					if Environment.Settings.AliveCheck and v.Character:FindFirstChildOfClass("Humanoid").Health <= 0 then continue end
					if localPos then
						local targetRoot = v.Character:FindFirstChild("HumanoidRootPart")
						if targetRoot and type(Environment.Settings.MaxDistance) == "number" and Environment.Settings.MaxDistance > 0 then
							if (targetRoot.Position - localPos).Magnitude > Environment.Settings.MaxDistance then
								continue
							end
						end
					end

					local aimPos
					if Environment.Settings.LockPart == "DirectTouch" then
						aimPos = GetClosestPartPos(v.Character)
						if not aimPos then continue end
					else
						if not v.Character:FindFirstChild(Environment.Settings.LockPart) then continue end
						local part = v.Character[Environment.Settings.LockPart]
						aimPos = part.Position
						local root = v.Character:FindFirstChild("HumanoidRootPart")
						local predRoot = PredictPosition(v.Character, Environment.Settings.Prediction)
						if root and predRoot then
							local offset = aimPos - root.Position
							aimPos = predRoot + offset
						end
						if Environment.Settings.WallCheck and #(Camera:GetPartsObscuringTarget({aimPos}, v.Character:GetDescendants())) > 0 then continue end
					end

					local Vector, OnScreen = Camera:WorldToViewportPoint(aimPos)
					local Distance = (Vector2(UserInputService:GetMouseLocation().X, UserInputService:GetMouseLocation().Y) - Vector2(Vector.X, Vector.Y)).Magnitude

					if Distance < RequiredDistance and OnScreen then
						RequiredDistance = Distance
						Environment.Locked = v
					end
				end
			end
		end
	elseif Environment.Locked then
		-- Check if target is still valid
		if not Environment.Locked.Character or not Environment.Locked.Character:FindFirstChildOfClass("Humanoid") then
			CancelLock()
			return
		end

		-- Distance check (only disconnect in normal mode)
		if not Environment.Settings.ForceConnect then
			local localRoot = GetLocalRoot()
			local targetRoot = Environment.Locked.Character:FindFirstChild("HumanoidRootPart")
			if localRoot and targetRoot and type(Environment.Settings.MaxDistance) == "number" and Environment.Settings.MaxDistance > 0 then
				if (targetRoot.Position - localRoot.Position).Magnitude > Environment.Settings.MaxDistance then
					CancelLock()
					return
				end
			end
		end
		
		-- If ForceConnect is enabled, keep the target even if they move out of FOV
		if Environment.Settings.ForceConnect then
			-- Only check if target is still alive (if AliveCheck is enabled)
			if Environment.Settings.AliveCheck and Environment.Locked.Character:FindFirstChildOfClass("Humanoid").Health <= 0 then
				CancelLock()
				return
			end
			-- Don't disconnect for FOV, distance, or other reasons when ForceConnect is on
			return
		end
		
		-- Normal behavior when ForceConnect is off
		local checkPos
		if Environment.Settings.LockPart == "DirectTouch" then
			checkPos = GetClosestPartPos(Environment.Locked.Character)
			if not checkPos then 
				CancelLock()
				return
			end
		else
			local part = Environment.Locked.Character:FindFirstChild(Environment.Settings.LockPart)
			if not part then
				CancelLock()
				return
			end
			checkPos = part.Position
			local root = Environment.Locked.Character:FindFirstChild("HumanoidRootPart")
			local predRoot = PredictPosition(Environment.Locked.Character, Environment.Settings.Prediction)
			if root and predRoot then
				local offset = checkPos - root.Position
				checkPos = predRoot + offset
			end
		end
		local Vector, _ = Camera:WorldToViewportPoint(checkPos)
		local Distance = (Vector2(UserInputService:GetMouseLocation().X, UserInputService:GetMouseLocation().Y) - Vector2(Vector.X, Vector.Y)).Magnitude
		if Distance > RequiredDistance then
			CancelLock()
		end
	end
end

local function GetClosestZombie()
	if not Environment.Locked then
		RequiredDistance = (Environment.FOVSettings.Enabled and Environment.FOVSettings.Amount or 2000)
		local localRoot = GetLocalRoot()
		local localPos = localRoot and localRoot.Position

		-- Cache NPC folder reference (refresh every 2s to handle respawns)
		local now = tick()
		if not cachedNPCFolder or (now - cachedNPCFolderTime) > NPC_FOLDER_CACHE_INTERVAL then
			local gameFolder = workspace:FindFirstChild("Game")
			cachedNPCFolder = gameFolder and gameFolder:FindFirstChild("Current") and gameFolder.Current:FindFirstChild("Spawned") and gameFolder.Current.Spawned:FindFirstChild("NPCs")
			cachedNPCFolderTime = now
		end
		if not cachedNPCFolder or not cachedNPCFolder.Parent then
			cachedNPCFolder = nil
			return
		end

		local mouseLoc = UserInputService:GetMouseLocation()
		local maxDist = type(Environment.Settings.MaxDistance) == "number" and Environment.Settings.MaxDistance > 0 and Environment.Settings.MaxDistance or nil
		local predEnabled = Environment.Settings.PredictionEnabled
		local predValue = Environment.Settings.Prediction
		local lockPartName = Environment.Settings.LockPart
		local aliveCheck = Environment.Settings.AliveCheck
		local wallCheck = Environment.Settings.WallCheck

		for _, folder in ipairs(cachedNPCFolder:GetChildren()) do
			if folder.Name == "friendlies" then continue end
			for _, zombie in ipairs(folder:GetChildren()) do
				if not zombie:IsA("Model") then continue end
				if not zombie:FindFirstChild("HumanoidRootPart") then continue end
				if not zombie:FindFirstChildOfClass("Humanoid") then continue end
				if Environment.IgnoreList[zombie] then continue end
				if aliveCheck and zombie:FindFirstChildOfClass("Humanoid").Health <= 0 then continue end

				local targetRoot = zombie:FindFirstChild("HumanoidRootPart")
				if maxDist and localPos then
					if (targetRoot.Position - localPos).Magnitude > maxDist then continue end
				end

				local aimPos
				if lockPartName == "DirectTouch" then
					aimPos = GetClosestPartPos(zombie)
					if not aimPos then continue end
				else
					local part = zombie:FindFirstChild(lockPartName)
					if not part then continue end
					aimPos = part.Position
					if predEnabled then
						local root = zombie:FindFirstChild("HumanoidRootPart")
						local predRoot = PredictPosition(zombie, predValue)
						if root and predRoot then
							aimPos = predRoot + (aimPos - root.Position)
						end
					end
					if wallCheck and #(Camera:GetPartsObscuringTarget({aimPos}, zombie:GetDescendants())) > 0 then continue end
				end

				local Vector, OnScreen = Camera:WorldToViewportPoint(aimPos)
				local Distance = (mouseLoc - Vector2(Vector.X, Vector.Y)).Magnitude

				if Distance < RequiredDistance and OnScreen then
					RequiredDistance = Distance
					Environment.Locked = zombie
				end
			end
		end
	elseif Environment.Locked then
		if not Environment.Locked.Parent or not Environment.Locked:FindFirstChildOfClass("Humanoid") then
			CancelLock()
			return
		end
		if Environment.Settings.AliveCheck and Environment.Locked:FindFirstChildOfClass("Humanoid").Health <= 0 then
			CancelLock()
			return
		end
		if not Environment.Settings.ForceConnect then
			local localRoot = GetLocalRoot()
			local targetRoot = Environment.Locked:FindFirstChild("HumanoidRootPart")
			if localRoot and targetRoot and type(Environment.Settings.MaxDistance) == "number" and Environment.Settings.MaxDistance > 0 then
				if (targetRoot.Position - localRoot.Position).Magnitude > Environment.Settings.MaxDistance then
					CancelLock()
					return
				end
			end
		end
		if Environment.Settings.ForceConnect then
			return
		end
		local checkPos
		if Environment.Settings.LockPart == "DirectTouch" then
			checkPos = GetClosestPartPos(Environment.Locked)
			if not checkPos then
				CancelLock()
				return
			end
		else
			local part = Environment.Locked:FindFirstChild(Environment.Settings.LockPart)
			if not part then
				CancelLock()
				return
			end
			checkPos = part.Position
			local root = Environment.Locked:FindFirstChild("HumanoidRootPart")
			local predRoot = PredictPosition(Environment.Locked, Environment.Settings.Prediction)
			if root and predRoot then
				local offset = checkPos - root.Position
				checkPos = predRoot + offset
			end
		end
		local Vector, _ = Camera:WorldToViewportPoint(checkPos)
		local Distance = (UserInputService:GetMouseLocation() - Vector2(Vector.X, Vector.Y)).Magnitude
		if Distance > RequiredDistance then
			CancelLock()
		end
	end
end

