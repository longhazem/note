--// Global Keybinds: Alt toggles aimbot, F8 toggles UI, Ctrl+` ignore target
local AltDown = false
UserInputService.InputBegan:Connect(function(input, gpe)
	if gpe then return end
	-- Alt toggle for aimbot
	if input.KeyCode == Enum.KeyCode.LeftAlt or input.KeyCode == Enum.KeyCode.RightAlt then
		if not AltDown then
			AltDown = true
			Environment.Settings.Enabled = not Environment.Settings.Enabled
			-- Optionally, update UI toggle button text if needed
		end
	end
	-- F8 toggle for UI
	-- Ctrl+` to ignore currently locked player
	if input.KeyCode == Enum.KeyCode.Backquote and (UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) or UserInputService:IsKeyDown(Enum.KeyCode.RightControl)) then
		if Environment.Locked then
			Environment.IgnoreList[Environment.Locked] = true
			CancelLock()
			-- refresh player list if UI is present
			if _G.AimbotRefreshPlayers then
				pcall(_G.AimbotRefreshPlayers)
			end
		end
	end

	if input.KeyCode == Enum.KeyCode.F8 then
		if UIRef and UIRef.Parent then
			UIRef.Enabled = not UIRef.Enabled
		elseif not UIRef then
			pcall(CreateUI)
		end
	end
end)
UserInputService.InputEnded:Connect(function(input, gpe)
	if gpe then return end
	if input.KeyCode == Enum.KeyCode.LeftAlt or input.KeyCode == Enum.KeyCode.RightAlt then
		AltDown = false
	end
end)

-- Return environment for external control
return Environment

