-- ─── HIGHLIGHT ────────────────────────────────────────────────────────────────
local function AddHighlight(obj, color, transparency)
    if not obj or not obj.Parent then return end
    pcall(function()
        if obj:FindFirstChild("TokaiHighlight") then
            obj:FindFirstChild("TokaiHighlight"):Destroy()
        end
        local h = Instance.new("Highlight")
        h.Name                = "TokaiHighlight"
        h.FillColor           = color
        h.OutlineColor        = color
        h.FillTransparency    = transparency or 0.3
        h.OutlineTransparency = 0
        h.Parent              = obj
        highlightObjects[obj] = true
    end)
end

local function RemoveHighlight(obj)
    pcall(function()
        local h = obj:FindFirstChild("TokaiHighlight")
        if h then h:Destroy(); highlightObjects[obj] = nil end
    end)
end

-- ─── ESP ──────────────────────────────────────────────────────────────────────
local function UpdateObjectiveESP()
    for obj, _ in pairs(highlightObjects) do
        if obj and obj.Parent then
            local name = obj.Name
            if (name:sub(1,8) == "mission_" or name == "scenery_phone_ringing") and not config.objectiveESP then RemoveHighlight(obj) end
            if name == "pickup_ammo"   and not config.ammoESP   then RemoveHighlight(obj) end
            if name == "pickup_armor"  and not config.armorESP  then RemoveHighlight(obj) end
            if name == "pickup_medkit" and not config.medkitESP then RemoveHighlight(obj) end
        end
    end

    local gw = workspace:FindFirstChild("Game"); if not gw then return end
    local current = gw:FindFirstChild("Current"); if not current then return end
    local spawned = current:FindFirstChild("Spawned"); if not spawned then return end
    local gameObjects = spawned:FindFirstChild("GameObjects"); if not gameObjects then return end

    for _, obj in ipairs(gameObjects:GetChildren()) do
        local name      = obj.Name
        local isMission = name:sub(1,8) == "mission_"
        local isPhone   = name == "scenery_phone_ringing"
        local isAmmo    = name == "pickup_ammo"
        local isArmor   = name == "pickup_armor"
        local isMedkit  = name == "pickup_medkit"

        if isMission or isPhone or isAmmo or isArmor or isMedkit then
            local shouldHL, color = false, nil
            if (isMission or isPhone) and config.objectiveESP then
                shouldHL = true
                color    = isMission and Color3.fromRGB(0,255,0) or Color3.fromRGB(255,255,255)
            elseif isAmmo   and config.ammoESP   then shouldHL = true; color = Color3.fromRGB(255,255,0)
            elseif isArmor  and config.armorESP  then shouldHL = true; color = Color3.fromRGB(0,0,255)
            elseif isMedkit and config.medkitESP then shouldHL = true; color = Color3.fromRGB(255,0,0)
            end
            if shouldHL and not obj:FindFirstChild("TokaiHighlight") then
                AddHighlight(obj, color, 0.3)
            end
        end
    end
end

local function UpdateESP()
    for obj, _ in pairs(highlightObjects) do
        if obj and obj.Parent and obj:FindFirstChild("Humanoid") then
            local isPlayer = Players:GetPlayerFromCharacter(obj) ~= nil
            if isPlayer     and not config.playerESP then RemoveHighlight(obj) end
            if not isPlayer and not config.zombieESP  then RemoveHighlight(obj) end
        end
    end

    if config.playerESP then
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= lp and player.Character and player.Character:FindFirstChild("Humanoid") then
                if not player.Character:FindFirstChild("TokaiHighlight") then
                    AddHighlight(player.Character, Color3.fromRGB(0,255,255), 0.3)
                end
            end
        end
    end

    if config.zombieESP then
        local npcContainer = workspace.Game and workspace.Game.Current
            and workspace.Game.Current.Spawned
            and workspace.Game.Current.Spawned.NPCs
        if npcContainer and npcContainer:FindFirstChild("enemies") then
            for _, zombie in ipairs(npcContainer.enemies:GetChildren()) do
                if zombie:IsA("Model") and zombie:FindFirstChild("Humanoid") then
                    if not zombie:FindFirstChild("TokaiHighlight") then
                        AddHighlight(zombie, Color3.fromRGB(255,0,0), 0.3)
                    end
                end
            end
        end
    end
end

-- ─── HITBOX EXPANDER ──────────────────────────────────────────────────────────
local function isPlayerCharacter(model)
    if not model or not model:IsA("Model") then return false end
    return Players:GetPlayerFromCharacter(model) ~= nil
end

local function isHumanoidModel(model)
    if not model or not model:IsA("Model") then return false end
    return model:FindFirstChildWhichIsA("Humanoid") ~= nil
end

local function applyHitboxExpander(part)
    if not part or not part:IsA("BasePart") then return end
    if not config.hitboxExpander or part.Name ~= "Head" then return end
    local model = part.Parent
    if isHumanoidModel(model) and not isPlayerCharacter(model) then
        pcall(function()
            if not expandedHitboxes[part] then
                part.Size         = Vector3.new(config.hitboxSize, config.hitboxSize, config.hitboxSize)
                part.CanCollide   = false
                part.Transparency = 0.7
                expandedHitboxes[part] = true
            else
                part.Size         = Vector3.new(config.hitboxSize, config.hitboxSize, config.hitboxSize)
                part.Transparency = 0.7
            end
        end)
    end
end

local function UpdateHitboxExpander()
    if config.hitboxExpander then
        for _, desc in ipairs(Workspace:GetDescendants()) do applyHitboxExpander(desc) end
    else
        for part, _ in pairs(expandedHitboxes) do
            if part and part.Parent then
                pcall(function() part.Size = Vector3.new(1,1,1); part.Transparency = 0 end)
            end
            expandedHitboxes[part] = nil
        end
        expandedHitboxes = {}
    end
end

Workspace.DescendantAdded:Connect(function(desc)
    if config.hitboxExpander and desc:IsA("BasePart") then
        task.wait(0.05); applyHitboxExpander(desc)
    end
end)

-- ─── SILENT AIM ───────────────────────────────────────────────────────────────
local function getEnemyContainer()
    local container = workspace.Game and workspace.Game.Current
        and workspace.Game.Current.Spawned
        and workspace.Game.Current.Spawned.NPCs
    if container then return container:FindFirstChild("enemies") end
    return nil
end

local function getClosestHead()
    local container = getEnemyContainer()
    if not container then return nil end
    local referencePos = isMobile
        and (function() local vp = camera.ViewportSize; return Vector2.new(vp.X/2, vp.Y/2) end)()
        or UserInputService:GetMouseLocation()
    local bestHeadPos, bestDist = nil, math.huge
    for _, enemy in ipairs(container:GetChildren()) do
        local head = enemy:FindFirstChild("Head") or enemy:FindFirstChild("HumanoidRootPart")
        if head then
            pcall(function()
                local sp, onScreen = camera:WorldToScreenPoint(head.Position)
                if onScreen then
                    local dist = (Vector2.new(sp.X, sp.Y) - referencePos).Magnitude
                    if dist < bestDist then bestDist = dist; bestHeadPos = head.Position end
                end
            end)
        end
    end
    return bestHeadPos
end

RunService.Heartbeat:Connect(function()
    target.position = (config.raycasting and target.enabled) and getClosestHead() or nil
end)

if supportsHook then
    local oldNamecall
    oldNamecall = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
        local ok, method = pcall(getnamecallmethod)
        if not ok then return oldNamecall(self, ...) end
        if config.raycasting and target.position and method:lower() == "raycast" and self == Workspace then
            local args = {...}
            if #args >= 2 and typeof(args[1]) == "Vector3" and typeof(args[2]) == "Vector3" then
                local rp = args[3]
                if rp and rp.CollisionGroup == "raycast_npc_neutral" then
                    local dir = target.position - args[1]
                    if dir.Magnitude > 0.001 then args[2] = dir.Unit * args[2].Magnitude end
                end
            end
            return oldNamecall(self, unpack(args))
        end
        return oldNamecall(self, ...)
    end))
end

-- ─── AUTO HIT ─────────────────────────────────────────────────────────────────
local function findRegisterHitEvent()
    local v3 = lp.Character
    if not v3 then return nil end
    for _, v4 in ipairs(v3:GetChildren()) do
        local v9 = v4:FindFirstChild("ServerEvents")
        if v9 then
            local v8 = v9:FindFirstChild("RegisterHit")
            if v8 and v8:IsA("RemoteEvent") then return v8 end
        end
    end
end

local function getTargets()
    local v11 = {}
    for _, v7 in ipairs(Workspace:GetDescendants()) do
        if v7:IsA("Model") and v7:FindFirstChild("Humanoid") and v7 ~= lp.Character then
            local v12 = v7:FindFirstChild("Torso") or v7:FindFirstChild("HumanoidRootPart")
            if v12 then table.insert(v11, {model = v7, part = v12}) end
        end
    end
    if #v11 == 0 and typeof(getnilinstances) == "function" then
        for _, v7 in ipairs(getnilinstances()) do
            if v7:IsA("Model") then
                local v12 = v7:FindFirstChild("Torso") or v7:FindFirstChild("HumanoidRootPart")
                if v12 then table.insert(v11, {model = v7, part = v12}) end
            end
        end
    end
    return v11
end

task.spawn(function()
    while task.wait(0.2) do
        if config.autoHit then
            pcall(function()
                local v5 = findRegisterHitEvent()
                if v5 then
                    local v11 = getTargets()
                    if #v11 > 0 then
                        local v6 = {}
                        for _, v10 in ipairs(v11) do
                            table.insert(v6, {amount = 1, target = v10.model, is_friendly = false, part = v10.part})
                        end
                        v5:FireServer(v6, {})
                    end
                end
            end)
        end
    end
end)

-- ─── AUTO RELOAD ──────────────────────────────────────────────────────────────
local function findReloadEvent()
    local char = lp.Character
    if not char then return nil end
    for _, child in ipairs(char:GetChildren()) do
        local se = child:FindFirstChild("ServerEvents")
        if se then
            local re = se:FindFirstChild("ReloadAmmo")
            if re and re:IsA("RemoteEvent") then return re end
        end
    end
    return nil
end

task.spawn(function()
    while task.wait(config.autoReloadInterval) do
        if config.autoReload then
            pcall(function()
                local re = findReloadEvent()
                if re then re:FireServer(false) end
            end)
        end
    end
end)

-- ─── INFINITE AMMO / STAMINA ──────────────────────────────────────────────────
task.spawn(function()
    while task.wait(0.1) do
        pcall(function()
            local Character = lp.Character
            if not Character then return end

            local Humanoid = Character:FindFirstChild("Humanoid")
            if Humanoid then
                local Values = Humanoid:FindFirstChild("Values")
                if Values then
                    local Stamina = Values:FindFirstChild("Stamina")
                    if Stamina and Stamina:IsA("NumberValue") then
                        if config.infiniteStamina then
                            if not originalStaminaValue then originalStaminaValue = Stamina.Value end
                            Stamina.Value = 99999
                        else
                            if originalStaminaValue and Stamina.Value == 99999 then
                                Stamina.Value = originalStaminaValue; originalStaminaValue = nil
                            end
                        end
                    end
                end
            end

            local Backpack = lp:FindFirstChild("Backpack")
            local items = {}
            for _, v in ipairs(Character:GetChildren()) do table.insert(items, v) end
            if Backpack then for _, v in ipairs(Backpack:GetChildren()) do table.insert(items, v) end end

            for _, item in ipairs(items) do
                if item:IsA("Tool") then
                    local wd   = item:FindFirstChild("WeaponData")
                    local ess  = wd and wd:FindFirstChild("Essentials")
                    local ammo = ess and ess:FindFirstChild("Ammo")
                    if ammo and ammo:IsA("NumberValue") then
                        if config.infiniteAmmo then
                            if originalAmmoValues[item] == nil then originalAmmoValues[item] = ammo.Value end
                            ammo.Value = 9999
                        else
                            if originalAmmoValues[item] ~= nil then
                                if ammo.Value == 9999 then ammo.Value = originalAmmoValues[item] end
                                originalAmmoValues[item] = nil
                            end
                        end
                    end
                end
            end
        end)
    end
end)

