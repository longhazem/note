-- ===== HELPER FUNCTIONS =====
local function EnsureDistanceRing(segments)
    segments = segments or 48
    if DistancePart and DistanceAttachments and DistanceBeams and #DistanceAttachments == segments and #DistanceBeams == segments then return end
    pcall(function() if DistancePart then DistancePart:Destroy() end end)
    DistancePart = Instance.new("Part")
    DistancePart.Name = "Aimbot_DistancePart"
    DistancePart.Anchored = true
    DistancePart.CanCollide = false
    DistancePart.Transparency = 1
    DistancePart.Size = Vector3.new(1,1,1)
    DistancePart.Parent = Workspace
    DistanceAttachments = {}
    DistanceBeams = {}
    for i = 1, segments do
        local a0 = Instance.new("Attachment")
        a0.Name = "Aimbot_DistanceA"..i
        a0.Parent = DistancePart
        DistanceAttachments[i] = a0
    end
    for i = 1, segments do
        local a0 = DistanceAttachments[i]
        local a1 = DistanceAttachments[(i % segments) + 1]
        local beam = Instance.new("Beam")
        beam.Name = "Aimbot_DistanceBeam"..i
        beam.Attachment0 = a0
        beam.Attachment1 = a1
        beam.FaceCamera = true
        beam.LightEmission = 1
        beam.LightInfluence = 0
        beam.Width0 = 0.15
        beam.Width1 = 0.15
        beam.Transparency = NumberSequence.new(0.35)
        beam.Color = ColorSequence.new(Color3.fromRGB(60,180,90))
        beam.Enabled = false
        beam.Parent = DistancePart
        DistanceBeams[i] = beam
    end
end

local function GetLocalRoot()
    local char = lp.Character
    if not char then return nil end
    return char:FindFirstChild("HumanoidRootPart")
end

local function GetLockedCharacter()
    if LockedTarget then
        if config.targetMode == "Zombies" then
            return LockedTarget
        else
            return LockedTarget.Character
        end
    end
    return nil
end

local function SetHighlight(char)
    if not config.highlightVisible then
        if HighlightInstance then HighlightInstance.Enabled = false end
        return
    end
    if not char then
        if HighlightInstance then HighlightInstance.Enabled = false end
        return
    end
    if not HighlightInstance then
        pcall(function()
            HighlightInstance = Instance.new("Highlight")
            HighlightInstance.Name = "Aimbot_Highlight"
            HighlightInstance.FillTransparency = 1
            HighlightInstance.OutlineTransparency = 0
            HighlightInstance.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            HighlightInstance.Parent = Workspace
        end)
    end
    if HighlightInstance then
        HighlightInstance.Adornee = char
        HighlightInstance.OutlineColor = Color3.fromRGB(255,70,70)
        HighlightInstance.Enabled = true
    end
end

local function CancelLock()
    LockedTarget = nil
    if Animation then Animation:Cancel() end
    FOVCircle.Color = Color3.fromRGB(255,255,255)
    SetHighlight(nil)
end

local function PredictPosition(char, mul)
    if not config.predictionEnabled then return nil end
    local root = char:FindFirstChild("HumanoidRootPart")
    if root and type(mul)=="number" and mul>0 then
        local vel = root.Velocity
        return root.Position + vel * mul
    end
    return nil
end

local function GetClosestPartPos(char)
    local mousePos = UserInputService:GetMouseLocation()
    local closestDist = math.huge
    local closestPos = nil
    local rootPart = char:FindFirstChild("HumanoidRootPart")
    if not rootPart then return nil end
    local predRoot = PredictPosition(char, config.prediction)
    for _, partName in ipairs(bodyParts) do
        local part = char:FindFirstChild(partName)
        if part then
            if config.wallCheck and #(Camera:GetPartsObscuringTarget({part.Position}, char:GetDescendants())) > 0 then continue end
            local pos = part.Position
            if predRoot then
                local offset = pos - rootPart.Position
                pos = predRoot + offset
            end
            local vec, onScreen = Camera:WorldToViewportPoint(pos)
            if onScreen then
                local dist = (Vector2.new(mousePos.X, mousePos.Y) - Vector2.new(vec.X, vec.Y)).Magnitude
                if dist < closestDist then
                    closestDist = dist
                    closestPos = pos
                end
            end
        end
    end
    return closestPos or rootPart.Position
end

local function GetClosestPlayer()
    if not LockedTarget then
        RequiredDistance = (config.fovAmount or 2000)
        local localRoot = GetLocalRoot()
        local localPos = localRoot and localRoot.Position
        for _, v in next, Players:GetPlayers() do
            if v ~= lp then
                if v.Character and v.Character:FindFirstChildOfClass("Humanoid") then
                    if config.teamCheck and v.Team == lp.Team then continue end
                    if v.Character:FindFirstChildOfClass("Humanoid").Health <= 0 then continue end
                    if localPos then
                        local targetRoot = v.Character:FindFirstChild("HumanoidRootPart")
                        if targetRoot and config.maxDistance > 0 then
                            if (targetRoot.Position - localPos).Magnitude > config.maxDistance then continue end
                        end
                    end
                    local aimPos
                    if config.lockPart == "DirectTouch" then
                        aimPos = GetClosestPartPos(v.Character)
                        if not aimPos then continue end
                    else
                        if not v.Character:FindFirstChild(config.lockPart) then continue end
                        local part = v.Character[config.lockPart]
                        aimPos = part.Position
                        local root = v.Character:FindFirstChild("HumanoidRootPart")
                        local predRoot = PredictPosition(v.Character, config.prediction)
                        if root and predRoot then
                            local offset = aimPos - root.Position
                            aimPos = predRoot + offset
                        end
                        if config.wallCheck and #(Camera:GetPartsObscuringTarget({aimPos}, v.Character:GetDescendants())) > 0 then continue end
                    end
                    local Vector, OnScreen = Camera:WorldToViewportPoint(aimPos)
                    local Distance = (Vector2.new(UserInputService:GetMouseLocation().X, UserInputService:GetMouseLocation().Y) - Vector2.new(Vector.X, Vector.Y)).Magnitude
                    if Distance < RequiredDistance and OnScreen then
                        RequiredDistance = Distance
                        LockedTarget = v
                    end
                end
            end
        end
    elseif LockedTarget then
        if not LockedTarget.Character or not LockedTarget.Character:FindFirstChildOfClass("Humanoid") then
            CancelLock()
            return
        end
        if not config.forceConnect then
            local localRoot = GetLocalRoot()
            local targetRoot = LockedTarget.Character:FindFirstChild("HumanoidRootPart")
            if localRoot and targetRoot and config.maxDistance > 0 then
                if (targetRoot.Position - localRoot.Position).Magnitude > config.maxDistance then
                    CancelLock()
                    return
                end
            end
        end
        if config.forceConnect then
            if LockedTarget.Character:FindFirstChildOfClass("Humanoid").Health <= 0 then
                CancelLock()
                return
            end
            return
        end
        local checkPos
        if config.lockPart == "DirectTouch" then
            checkPos = GetClosestPartPos(LockedTarget.Character)
            if not checkPos then CancelLock(); return end
        else
            local part = LockedTarget.Character:FindFirstChild(config.lockPart)
            if not part then CancelLock(); return end
            checkPos = part.Position
            local root = LockedTarget.Character:FindFirstChild("HumanoidRootPart")
            local predRoot = PredictPosition(LockedTarget.Character, config.prediction)
            if root and predRoot then
                local offset = checkPos - root.Position
                checkPos = predRoot + offset
            end
        end
        local Vector, _ = Camera:WorldToViewportPoint(checkPos)
        local Distance = (Vector2.new(UserInputService:GetMouseLocation().X, UserInputService:GetMouseLocation().Y) - Vector2.new(Vector.X, Vector.Y)).Magnitude
        if Distance > RequiredDistance then CancelLock() end
    end
end

local function GetClosestZombie()
    if not LockedTarget then
        RequiredDistance = (config.fovAmount or 2000)
        local localRoot = GetLocalRoot()
        local localPos = localRoot and localRoot.Position
        local now = tick()
        if not cachedNPCFolder or (now - cachedNPCFolderTime) > NPC_FOLDER_CACHE_INTERVAL then
            local gameFolder = Workspace:FindFirstChild("Game")
            cachedNPCFolder = gameFolder and gameFolder:FindFirstChild("Current") and gameFolder.Current:FindFirstChild("Spawned") and gameFolder.Current.Spawned:FindFirstChild("NPCs")
            cachedNPCFolderTime = now
        end
        if not cachedNPCFolder or not cachedNPCFolder.Parent then
            cachedNPCFolder = nil
            return
        end
        local mouseLoc = UserInputService:GetMouseLocation()
        local maxDist = config.maxDistance > 0 and config.maxDistance or nil
        for _, folder in ipairs(cachedNPCFolder:GetChildren()) do
            if folder.Name == "friendlies" then continue end
            for _, zombie in ipairs(folder:GetChildren()) do
                if not zombie:IsA("Model") then continue end
                if not zombie:FindFirstChild("HumanoidRootPart") then continue end
                if not zombie:FindFirstChildOfClass("Humanoid") then continue end
                if zombie:FindFirstChildOfClass("Humanoid").Health <= 0 then continue end
                local targetRoot = zombie:FindFirstChild("HumanoidRootPart")
                if maxDist and localPos then
                    if (targetRoot.Position - localPos).Magnitude > maxDist then continue end
                end
                local aimPos
                if config.lockPart == "DirectTouch" then
                    aimPos = GetClosestPartPos(zombie)
                    if not aimPos then continue end
                else
                    local part = zombie:FindFirstChild(config.lockPart)
                    if not part then continue end
                    aimPos = part.Position
                    if config.predictionEnabled then
                        local root = zombie:FindFirstChild("HumanoidRootPart")
                        local predRoot = PredictPosition(zombie, config.prediction)
                        if root and predRoot then
                            aimPos = predRoot + (aimPos - root.Position)
                        end
                    end
                    if config.wallCheck and #(Camera:GetPartsObscuringTarget({aimPos}, zombie:GetDescendants())) > 0 then continue end
                end
                local Vector, OnScreen = Camera:WorldToViewportPoint(aimPos)
                local Distance = (mouseLoc - Vector2.new(Vector.X, Vector.Y)).Magnitude
                if Distance < RequiredDistance and OnScreen then
                    RequiredDistance = Distance
                    LockedTarget = zombie
                end
            end
        end
    elseif LockedTarget then
        if not LockedTarget.Parent or not LockedTarget:FindFirstChildOfClass("Humanoid") then
            CancelLock()
            return
        end
        if LockedTarget:FindFirstChildOfClass("Humanoid").Health <= 0 then
            CancelLock()
            return
        end
        if not config.forceConnect then
            local localRoot = GetLocalRoot()
            local targetRoot = LockedTarget:FindFirstChild("HumanoidRootPart")
            if localRoot and targetRoot and config.maxDistance > 0 then
                if (targetRoot.Position - localRoot.Position).Magnitude > config.maxDistance then
                    CancelLock()
                    return
                end
            end
        end
        if config.forceConnect then return end
        local checkPos
        if config.lockPart == "DirectTouch" then
            checkPos = GetClosestPartPos(LockedTarget)
            if not checkPos then CancelLock(); return end
        else
            local part = LockedTarget:FindFirstChild(config.lockPart)
            if not part then CancelLock(); return end
            checkPos = part.Position
            local root = LockedTarget:FindFirstChild("HumanoidRootPart")
            local predRoot = PredictPosition(LockedTarget, config.prediction)
            if root and predRoot then
                local offset = checkPos - root.Position
                checkPos = predRoot + offset
            end
        end
        local Vector, _ = Camera:WorldToViewportPoint(checkPos)
        local Distance = (UserInputService:GetMouseLocation() - Vector2.new(Vector.X, Vector.Y)).Magnitude
        if Distance > RequiredDistance then CancelLock() end
    end
end

-- ===== INVISIBLE FUNCTIONS =====
local function setupInvisibleCharacter()
    invisibleChar = lp.Character or lp.CharacterAdded:Wait()
    invisibleHumanoid = invisibleChar:WaitForChild("Humanoid")
    invisibleRootPart = invisibleChar:WaitForChild("HumanoidRootPart")
    invisibleParts = {}
    for _, obj in pairs(invisibleChar:GetDescendants()) do
        if obj:IsA("BasePart") and obj.Transparency == 0 then
            table.insert(invisibleParts, obj)
        end
    end
end

local function startInvisible()
    if invisibleActive then return end
    invisibleActive = true
    pcall(setupInvisibleCharacter)
    for _, part in pairs(invisibleParts) do
        if part and part.Parent then
            part.Transparency = 0.5
        end
    end
    invisibleHBConnection = RunService.Heartbeat:Connect(function()
        if invisibleActive and invisibleRootPart and invisibleRootPart.Parent and invisibleHumanoid and invisibleHumanoid.Parent then
            pcall(function()
                local cf = invisibleRootPart.CFrame
                local camOffset = invisibleHumanoid.CameraOffset
                local offset = config.invisibleOffsetY or 100
                local hidden = cf * CFrame.new(0, offset, 0)
                invisibleRootPart.CFrame = hidden
                invisibleHumanoid.CameraOffset = hidden:ToObjectSpace(CFrame.new(cf.Position)).Position
                RunService.RenderStepped:Wait()
                invisibleRootPart.CFrame = cf
                invisibleHumanoid.CameraOffset = camOffset
            end)
        end
    end)
    invisibleCharAddedConnection = lp.CharacterAdded:Connect(function()
        task.wait(0.5)
        invisibleActive = false
        pcall(setupInvisibleCharacter)
        invisibleActive = true
    end)
end

local function stopInvisible()
    invisibleActive = false
    if invisibleHBConnection then invisibleHBConnection:Disconnect(); invisibleHBConnection = nil end
    if invisibleCharAddedConnection then invisibleCharAddedConnection:Disconnect(); invisibleCharAddedConnection = nil end
    for _, part in pairs(invisibleParts) do
        if part and part.Parent then
            part.Transparency = 0
        end
    end
    invisibleParts = {}
    pcall(function()
        if invisibleHumanoid and invisibleHumanoid.Parent then
            invisibleHumanoid.CameraOffset = Vector3.new(0,0,0)
        end
    end)
end

-- ===== LOAD AIMBOT LOOP =====
local function LoadAimbot()
    ServiceConnections.RenderSteppedConnection = RunService.RenderStepped:Connect(function()
        if config.aimbotEnabled then
            FOVCircle.Radius = config.fovAmount
            FOVCircle.Thickness = 1
            FOVCircle.Filled = false
            FOVCircle.NumSides = 60
            FOVCircle.Color = config.fovVisible and Color3.fromRGB(255,255,255) or Color3.fromRGB(255,255,255,0)
            FOVCircle.Transparency = 0.5
            FOVCircle.Visible = config.fovVisible
            FOVCircle.Position = Vector2.new(UserInputService:GetMouseLocation().X, UserInputService:GetMouseLocation().Y)
        else
            FOVCircle.Visible = false
        end
        if StatusCircle then
            local cameraView = Camera.ViewportSize
            StatusCircle.Position = Vector2.new(cameraView.X - 20, cameraView.Y - 20)
            StatusCircle.Color = config.aimbotEnabled and Color3.fromRGB(0,255,0) or Color3.fromRGB(255,0,0)
            if StatusText then
                StatusText.Position = StatusCircle.Position
                if LockedTarget then
                    local lockedChar = GetLockedCharacter()
                    if lockedChar then
                        local localRoot = GetLocalRoot()
                        local targetRoot = lockedChar:FindFirstChild("HumanoidRootPart")
                        if localRoot and targetRoot then
                            local dist = (targetRoot.Position - localRoot.Position).Magnitude
                            StatusText.Text = tostring(math.floor(dist))
                        else
                            StatusText.Text = "-"
                        end
                    else
                        StatusText.Text = "-"
                    end
                else
                    StatusText.Text = config.aimbotEnabled and "ON" or "OFF"
                end
                StatusText.Visible = true
            end
        end
        if Running and config.aimbotEnabled then
            if config.targetMode == "Zombies" then
                GetClosestZombie()
            else
                GetClosestPlayer()
            end
            if LockedTarget then
                local lockedChar = GetLockedCharacter()
                if not lockedChar then
                    SetHighlight(nil)
                else
                    if config.highlightVisible then
                        SetHighlight(lockedChar)
                    else
                        SetHighlight(nil)
                    end
                    local aimPosition
                    if config.lockPart == "DirectTouch" then
                        aimPosition = GetClosestPartPos(lockedChar)
                    else
                        local part = lockedChar:FindFirstChild(config.lockPart)
                        if not part then CancelLock(); SetHighlight(nil); return end
                        aimPosition = part.Position
                        local root = lockedChar:FindFirstChild("HumanoidRootPart")
                        local predRoot = PredictPosition(lockedChar, config.prediction)
                        if root and predRoot then
                            local offset = aimPosition - root.Position
                            aimPosition = predRoot + offset
                        end
                    end
                    if not config.silentAim then
                        if config.thirdPerson then
                            config.thirdPersonSensitivity = math.clamp(config.thirdPersonSensitivity, 0.1, 5)
                            local Vector = Camera:WorldToViewportPoint(aimPosition)
                            local mousemoverel = mousemoverel or (Input and Input.MouseMove)
                            if mousemoverel then
                                mousemoverel((Vector.X - UserInputService:GetMouseLocation().X) * config.thirdPersonSensitivity, (Vector.Y - UserInputService:GetMouseLocation().Y) * config.thirdPersonSensitivity)
                            end
                        else
                            if config.sensitivity > 0 or config.smoothAim then
                                if config.smoothAim and config.sensitivity==0 then
                                    local current = Camera.CFrame
                                    local target = CFrame.new(Camera.CFrame.Position, aimPosition)
                                    Camera.CFrame = current:Lerp(target, 0.15)
                                else
                                    Animation = TweenService:Create(Camera, TweenInfo.new(config.sensitivity, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), {CFrame = CFrame.new(Camera.CFrame.Position, aimPosition)})
                                    Animation:Play()
                                end
                            else
                                Camera.CFrame = CFrame.new(Camera.CFrame.Position, aimPosition)
                            end
                        end
                    end
                    FOVCircle.Color = Color3.fromRGB(255,70,70)
                end
            else
                SetHighlight(nil)
            end
        else
            SetHighlight(nil)
        end
        do
            local root = GetLocalRoot()
            local visible = config.distanceCircleVisible and config.maxDistance > 0
            if visible and root then
                EnsureDistanceRing(48)
                local yOffset = -3
                local hum = lp.Character and lp.Character:FindFirstChildOfClass("Humanoid")
                if hum then yOffset = -(hum.HipHeight + 1) end
                local center = root.Position + Vector3.new(0, yOffset, 0)
                DistancePart.CFrame = CFrame.new(center)
                local radius = config.maxDistance
                local seg = #DistanceAttachments
                for i = 1, seg do
                    local t = (i / seg) * (math.pi * 2)
                    DistanceAttachments[i].Position = Vector3.new(math.cos(t) * radius, 0, math.sin(t) * radius)
                end
                for i = 1, #DistanceBeams do
                    DistanceBeams[i].Enabled = true
                end
            else
                if DistanceBeams then
                    for i = 1, #DistanceBeams do
                        DistanceBeams[i].Enabled = false
                    end
                end
            end
        end
    end)
    ServiceConnections.InputBeganConnection = UserInputService.InputBegan:Connect(function(Input)
        if not Typing then
            pcall(function()
                local key = config.triggerKey
                if key == "MouseButton1" and Input.UserInputType == Enum.UserInputType.MouseButton1 then
                    Running = config.toggleMode and not Running or true
                    if not Running then CancelLock() end
                elseif key == "MouseButton2" and Input.UserInputType == Enum.UserInputType.MouseButton2 then
                    Running = config.toggleMode and not Running or true
                    if not Running then CancelLock() end
                elseif key == "Q" and Input.KeyCode == Enum.KeyCode.Q then
                    Running = config.toggleMode and not Running or true
                    if not Running then CancelLock() end
                end
            end)
        end
    end)
    ServiceConnections.InputEndedConnection = UserInputService.InputEnded:Connect(function(Input)
        if not Typing then
            if not config.toggleMode then
                pcall(function()
                    local key = config.triggerKey
                    if key == "MouseButton1" and Input.UserInputType == Enum.UserInputType.MouseButton1 then
                        Running = false; CancelLock()
                    elseif key == "MouseButton2" and Input.UserInputType == Enum.UserInputType.MouseButton2 then
                        Running = false; CancelLock()
                    elseif key == "Q" and Input.KeyCode == Enum.KeyCode.Q then
                        Running = false; CancelLock()
                    end
                end)
            end
        end
    end)
    lp.CharacterAdded:Connect(function() CancelLock() end)
end

LoadAimbot()

