	if Environment.FOVCircle.Remove then Environment.FOVCircle:Remove() end
	if Environment.StatusCircle.Remove then Environment.StatusCircle:Remove() end
	if Environment.StatusText and Environment.StatusText.Remove then Environment.StatusText:Remove() end
