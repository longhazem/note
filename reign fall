-- ─── HIGHLIGHT / ESP STATE ────────────────────────────────────────────────────
local highlightObjects     = {}
local expandedHitboxes     = {}
local originalAmmoValues   = {}
local originalStaminaValue = nil

local function AddHighlight(obj, color, transparency)
    if not obj or not obj.Parent then return end
    pcall(function()
        if obj:FindFirstChild("TokaiHighlight") then obj:FindFirstChild("TokaiHighlight"):Destroy() end
        local h = Instance.new("Highlight")
        h.Name = "TokaiHighlight"
        h.FillColor = color; h.OutlineColor = color
        h.FillTransparency = transparency or 0.3
        h.OutlineTransparency = 0
        h.Parent = obj
        highlightObjects[obj] = true
    end)
end

local function RemoveHighlight(obj)
    pcall(function()
        local h = obj:FindFirstChild("TokaiHighlight")
        if h then h:Destroy(); highlightObjects[obj] = nil end
    end)
end

-- ─── NPC FOLDER ───────────────────────────────────────────────────────────────
local function getNPCFolder()
    local now = tick()
    if cachedNPCFolder and cachedNPCFolder.Parent and (now - cachedNPCTime) < NPC_CACHE_TTL then
        return cachedNPCFolder
    end
    local g = workspace:FindFirstChild("Game")
    cachedNPCFolder = g
        and g:FindFirstChild("Current")
        and g.Current:FindFirstChild("Spawned")
        and g.Current.Spawned:FindFirstChild("NPCs")
    cachedNPCTime = now
    return cachedNPCFolder
end

-- ─── WALL CHECK ───────────────────────────────────────────────────────────────
local function isVisible(pos, ignoreList)
    local origin = camera.CFrame.Position
    local dir = pos - origin
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = ignoreList or {}
    local result = workspace:Raycast(origin, dir, params)
    -- visible if ray hits nothing or travels nearly full distance
    if not result then return true end
    local hitDist = (result.Position - origin).Magnitude
    local targetDist = dir.Magnitude
    return hitDist >= targetDist - 0.5
end

-- ─── AIMBOT CORE ──────────────────────────────────────────────────────────────
local function cancelAimLock()
    aimLocked = nil
    if aimAnimation then aimAnimation:Cancel() end
    fovCircle.Color = Color3.fromRGB(255, 255, 255)
end

local function getZombieAimPos(zombie)
    local part = zombie:FindFirstChild(config.zombieAimPart)
        or zombie:FindFirstChild("HumanoidRootPart")
    return part and part.Position or nil
end

local function getClosestZombie()
    local npcs = getNPCFolder()
    if not npcs then return nil end

    local mouseLoc = UserInputService:GetMouseLocation()
    local bestDist, bestZombie = config.zombieAimFOV, nil

    for _, folder in ipairs(npcs:GetChildren()) do
        if folder.Name == "friendlies" then continue end
        for _, zombie in ipairs(folder:GetChildren()) do
            if not zombie:IsA("Model") then continue end
            local hum = zombie:FindFirstChildOfClass("Humanoid")
            if not hum or hum.Health <= 0 then continue end

            local aimPos = getZombieAimPos(zombie)
            if not aimPos then continue end

            -- wall check
            if config.zombieAimWallCheck then
                local ignoreList = {lp.Character}
                for _, p in ipairs(Players:GetPlayers()) do
                    if p.Character then table.insert(ignoreList, p.Character) end
                end
                -- also ignore the zombie itself so ray isn't blocked by its own parts
                table.insert(ignoreList, zombie)
                if not isVisible(aimPos, ignoreList) then continue end
            end

            local vec, onScreen = camera:WorldToViewportPoint(aimPos)
            if not onScreen then continue end

            local dist = (Vector2.new(mouseLoc.X, mouseLoc.Y) - Vector2.new(vec.X, vec.Y)).Magnitude
            if dist < bestDist then
                bestDist = dist
                bestZombie = zombie
            end
        end
    end
    return bestZombie
end

local function validateLocked()
    if not aimLocked then return false end
    if not aimLocked.Parent then cancelAimLock(); return false end
    local hum = aimLocked:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then cancelAimLock(); return false end
    return true
end

local function tickAimbot()
    if config.zombieAim then
        local ml = UserInputService:GetMouseLocation()
        fovCircle.Position = Vector2.new(ml.X, ml.Y)
        fovCircle.Radius   = config.zombieAimFOV
        fovCircle.Visible  = true
    else
        fovCircle.Visible = false
        cancelAimLock()
        return
    end

    if not config.zombieAimRunning then cancelAimLock(); return end

    if not validateLocked() then
        aimLocked = getClosestZombie()
        if not aimLocked then return end
    end

    local aimPos = getZombieAimPos(aimLocked)
    if not aimPos then cancelAimLock(); return end

    fovCircle.Color = Color3.fromRGB(255, 70, 70)

    if config.zombieAimSmooth > 0 then
        if aimAnimation then aimAnimation:Cancel() end
        aimAnimation = TweenService:Create(
            camera,
            TweenInfo.new(config.zombieAimSmooth, Enum.EasingStyle.Sine, Enum.EasingDirection.Out),
            { CFrame = CFrame.new(camera.CFrame.Position, aimPos) }
        )
        aimAnimation:Play()
    else
        camera.CFrame = CFrame.new(camera.CFrame.Position, aimPos)
    end
end

-- ─── INPUT ────────────────────────────────────────────────────────────────────
local function keyMatchesInput(input)
    local k = config.zombieAimKey
    if k == "MouseButton1" and input.UserInputType == Enum.UserInputType.MouseButton1 then return true end
    if k == "MouseButton2" and input.UserInputType == Enum.UserInputType.MouseButton2 then return true end
    if input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode.Name == k then return true end
    return false
end

UserInputService.InputBegan:Connect(function(input, gpe)
    if gpe then return end
    if not config.zombieAim then return end
    if keyMatchesInput(input) then
        if config.zombieAimToggle then
            config.zombieAimRunning = not config.zombieAimRunning
            if not config.zombieAimRunning then cancelAimLock() end
        else
            config.zombieAimRunning = true
        end
    end
end)

UserInputService.InputEnded:Connect(function(input, gpe)
    if gpe then return end
    if not config.zombieAimToggle and keyMatchesInput(input) then
        config.zombieAimRunning = false
        cancelAimLock()
    end
end)

-- ─── AUTO RELOAD ──────────────────────────────────────────────────────────────
local autoReloadThread = nil

local function findReloadEvent()
    local char = lp.Character
    if not char then return nil end
    for _, child in ipairs(char:GetChildren()) do
        local se = child:FindFirstChild("ServerEvents")
        if se then
            local ev = se:FindFirstChild("ReloadAmmo")
            if ev then return ev end
        end
    end
    return nil
end

local function startAutoReload()
    if autoReloadThread then pcall(function() task.cancel(autoReloadThread) end) end
    autoReloadThread = task.spawn(function()
        while config.autoReload do
            task.wait(config.autoReloadInterval)
            local ev = findReloadEvent()
            if ev then pcall(function() ev:FireServer(false) end) end
        end
    end)
end

local function stopAutoReload()
    if autoReloadThread then
        pcall(function() task.cancel(autoReloadThread) end)
        autoReloadThread = nil
    end
end

-- ─── ESP UPDATES ──────────────────────────────────────────────────────────────
local function UpdateObjectiveESP()
    for obj in pairs(highlightObjects) do
        if obj and obj.Parent then
            local n = obj.Name
            if (n:sub(1,8) == "mission_" or n == "scenery_phone_ringing") and not config.objectiveESP then RemoveHighlight(obj) end
            if n == "pickup_ammo"   and not config.ammoESP   then RemoveHighlight(obj) end
            if n == "pickup_armor"  and not config.armorESP  then RemoveHighlight(obj) end
            if n == "pickup_medkit" and not config.medkitESP then RemoveHighlight(obj) end
        end
    end
    local spawned = workspace.Game and workspace.Game.Current and workspace.Game.Current.Spawned
    local gObjects = spawned and spawned:FindFirstChild("GameObjects")
    if not gObjects then return end
    for _, obj in ipairs(gObjects:GetChildren()) do
        local n = obj.Name
        local shouldHL, color = false, nil
        if (n:sub(1,8) == "mission_" or n == "scenery_phone_ringing") and config.objectiveESP then
            shouldHL = true
            color = n == "scenery_phone_ringing" and Color3.fromRGB(255,255,255) or Color3.fromRGB(0,255,0)
        elseif n == "pickup_ammo"   and config.ammoESP   then shouldHL = true; color = Color3.fromRGB(255,255,0)
        elseif n == "pickup_armor"  and config.armorESP  then shouldHL = true; color = Color3.fromRGB(0,0,255)
        elseif n == "pickup_medkit" and config.medkitESP then shouldHL = true; color = Color3.fromRGB(255,0,0)
        end
        if shouldHL and not obj:FindFirstChild("TokaiHighlight") then AddHighlight(obj, color, 0.3) end
    end
end

local function UpdateESP()
    for obj in pairs(highlightObjects) do
        if obj and obj.Parent and obj:FindFirstChild("Humanoid") then
            local isPlayer = Players:GetPlayerFromCharacter(obj) ~= nil
            if isPlayer     and not config.playerESP then RemoveHighlight(obj) end
            if not isPlayer and not config.zombieESP  then RemoveHighlight(obj) end
        end
    end
    if config.playerESP then
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= lp and p.Character and p.Character:FindFirstChild("Humanoid") then
                if not p.Character:FindFirstChild("TokaiHighlight") then
                    AddHighlight(p.Character, Color3.fromRGB(0,255,255), 0.3)
                end
            end
        end
    end
    if config.zombieESP then
        local npcs = getNPCFolder()
        if npcs then
            for _, folder in ipairs(npcs:GetChildren()) do
                for _, zombie in ipairs(folder:GetChildren()) do
                    if zombie:IsA("Model") and zombie:FindFirstChild("Humanoid") then
                        if not zombie:FindFirstChild("TokaiHighlight") then
                            AddHighlight(zombie, Color3.fromRGB(255,0,0), 0.3)
                        end
                    end
                end
            end
        end
    end
end

-- ─── HITBOX EXPANDER ──────────────────────────────────────────────────────────
local function isPlayerCharacter(model)
    return model and model:IsA("Model") and Players:GetPlayerFromCharacter(model) ~= nil
end

local function applyHitboxExpander(part)
    if not part or not part:IsA("BasePart") then return end
    if not config.hitboxExpander or part.Name ~= "Head" then return end
    local model = part.Parent
    if model and model:FindFirstChildWhichIsA("Humanoid") and not isPlayerCharacter(model) then
        pcall(function()
            part.Size = Vector3.new(config.hitboxSize, config.hitboxSize, config.hitboxSize)
            part.CanCollide = false
            part.Transparency = 0.7
            expandedHitboxes[part] = true
        end)
    end
end

local function UpdateHitboxExpander()
    if config.hitboxExpander then
        for _, desc in ipairs(Workspace:GetDescendants()) do applyHitboxExpander(desc) end
    else
        for part in pairs(expandedHitboxes) do
            if part and part.Parent then part.Size = Vector3.new(1,1,1); part.Transparency = 0 end
            expandedHitboxes[part] = nil
        end
        expandedHitboxes = {}
    end
end

Workspace.DescendantAdded:Connect(function(desc)
    if config.hitboxExpander and desc:IsA("BasePart") then
        task.wait(0.05); applyHitboxExpander(desc)
    end
end)

-- ─── AUTO HIT ─────────────────────────────────────────────────────────────────
local function findRegisterHitEvent()
    local char = lp.Character
    if not char then return nil end
    for _, v in ipairs(char:GetChildren()) do
        local se = v:FindFirstChild("ServerEvents")
        if se then
            local rh = se:FindFirstChild("RegisterHit")
            if rh and rh:IsA("RemoteEvent") then return rh end
        end
    end
end

local function getTargets()
    local out = {}
    for _, v in ipairs(Workspace:GetDescendants()) do
        if v:IsA("Model") and v:FindFirstChild("Humanoid") and v ~= lp.Character then
            local root = v:FindFirstChild("Torso") or v:FindFirstChild("HumanoidRootPart")
            if root then table.insert(out, {model = v, part = root}) end
        end
    end
    return out
end

task.spawn(function()
    while task.wait(0.2) do
        if config.autoHit then
            local ev = findRegisterHitEvent()
            if ev then
                local targets = getTargets()
                if #targets > 0 then
                    local payload = {}
                    for _, t in ipairs(targets) do
                        table.insert(payload, {amount = 1, target = t.model, is_friendly = false, part = t.part})
                    end
                    ev:FireServer(payload, {})
                end
            end
        end
    end
end)

-- ─── INFINITE AMMO / STAMINA ──────────────────────────────────────────────────
task.spawn(function()
    while task.wait(0.1) do
        local char = lp.Character
        if char then
            local hum = char:FindFirstChild("Humanoid")
            if hum then
                local vals = hum:FindFirstChild("Values")
                if vals then
                    local stam = vals:FindFirstChild("Stamina")
                    if stam and stam:IsA("NumberValue") then
                        if config.infiniteStamina then
                            originalStaminaValue = originalStaminaValue or stam.Value
                            stam.Value = 99999
                        else
                            if originalStaminaValue and stam.Value == 99999 then
                                stam.Value = originalStaminaValue; originalStaminaValue = nil
                            end
                        end
                    end
                end
            end
            local items = {}
            for _, v in ipairs(char:GetChildren()) do table.insert(items, v) end
            local bp = lp:FindFirstChild("Backpack")
            if bp then for _, v in ipairs(bp:GetChildren()) do table.insert(items, v) end end
            for _, item in ipairs(items) do
                if item:IsA("Tool") then
                    local wd = item:FindFirstChild("WeaponData")
                    local ess = wd and wd:FindFirstChild("Essentials")
                    local ammo = ess and ess:FindFirstChild("Ammo")
                    if ammo and ammo:IsA("NumberValue") then
                        if config.infiniteAmmo then
                            if originalAmmoValues[item] == nil then originalAmmoValues[item] = ammo.Value end
                            ammo.Value = 9999
                        else
                            if originalAmmoValues[item] ~= nil then
                                if ammo.Value == 9999 then ammo.Value = originalAmmoValues[item] end
                                originalAmmoValues[item] = nil
                            end
                        end
                    end
                end
            end
        end
    end
end)

-- ─── SILENT AIM RAYCAST HOOK ─────────────────────────────────────────────────
local function getClosestHead()
    local npcs = getNPCFolder()
    if not npcs then return nil end
    local ref = isMobile and (function()
        local vp = camera.ViewportSize; return Vector2.new(vp.X/2, vp.Y/2)
    end)() or UserInputService:GetMouseLocation()
    local best, bestDist = nil, math.huge
    for _, folder in ipairs(npcs:GetChildren()) do
        for _, zombie in ipairs(folder:GetChildren()) do
            local head = zombie:FindFirstChild("Head") or zombie:FindFirstChild("HumanoidRootPart")
            if head then
                local sp, onScreen = camera:WorldToScreenPoint(head.Position)
                if onScreen then
                    local d = (Vector2.new(sp.X, sp.Y) - ref).Magnitude
                    if d < bestDist then bestDist = d; best = head.Position end
                end
            end
        end
    end
    return best
end

local silentAimTarget = nil
RunService.Heartbeat:Connect(function()
    silentAimTarget = config.raycasting and getClosestHead() or nil
end)

local oldNamecall
oldNamecall = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
    local method = getnamecallmethod()
    if config.raycasting and silentAimTarget and method:lower() == "raycast" and self == Workspace then
        local args = {...}
        if #args >= 2 and typeof(args[1]) == "Vector3" and typeof(args[2]) == "Vector3" then
            local rp = args[3]
            if rp and rp.CollisionGroup == "raycast_npc_neutral" then
                local dir = silentAimTarget - args[1]
                if dir.Magnitude > 0.001 then args[2] = dir.Unit * args[2].Magnitude end
            end
        end
        return oldNamecall(self, unpack(args))
    end
    return oldNamecall(self, ...)
end))

