        pcall(function()
            appendfile(file_name, line .. "\n")
        end)
    end
end

-- [[ Lấy môi trường Game và giải mã Replicators ]]
local function fetchGameEnvironment()
    local detected_mode = "Molten"
    local detected_map = "Unknown Map"

    -- Lấy thông tin bản đồ và chế độ từ hệ thống ReplicatedStorage
    local state_folder = ReplicatedStorage:FindFirstChild("State")
    if state_folder then
        if state_folder:FindFirstChild("Difficulty") then
            detected_mode = state_folder.Difficulty.Value
        elseif state_folder:FindFirstChild("Mode") then
            detected_mode = state_folder.Mode.Value
        end
        
        if state_folder:FindFirstChild("Map") then
            detected_map = state_folder.Map.Value
        end
    end

    -- Lấy danh sách 5 tháp trong túi đồ thực tế bằng JSON Parser
    local t1, t2, t3, t4, t5 = "Scout", "None", "None", "None", "None"
    local state_replicators = ReplicatedStorage:FindFirstChild("StateReplicators")
    if state_replicators then
        for _, folder in ipairs(state_replicators:GetChildren()) do
            if folder.Name == "PlayerReplicator" and folder:GetAttribute("UserId") == LocalPlayer.UserId then
                local equipped = folder:GetAttribute("EquippedTowers")
                if type(equipped) == "string" then
                    local cleaned_json = equipped:match("%[.*%]")
                    local success, tower_table = pcall(function()
                        return HttpService:JSONDecode(cleaned_json)
                    end)
                    if success and type(tower_table) == "table" then
                        t1 = tower_table[1] or "None"
                        t2 = tower_table[2] or "None"
                        t3 = tower_table[3] or "None"
                        t4 = tower_table[4] or "None"
                        t5 = tower_table[5] or "None"
                    end
                end
            end
        end
    end

    -- Lấy Modifiers bình chọn
    local current_modifiers = ""
    if state_replicators then
        local mod_replicator = state_replicators:FindFirstChild("ModifierReplicator")
        if mod_replicator then
            local raw_votes = mod_replicator:GetAttribute("Votes")
            if type(raw_votes) == "string" then
                local cleaned_json = raw_votes:match("{.*}")
                local success, mod_table = pcall(function()
                    return HttpService:JSONDecode(cleaned_json)
                end)
                if success and type(mod_table) == "table" then
                    local mods = {}
                    for mod_name, _ in pairs(mod_table) do
                        table.insert(mods, mod_name .. " = true")
                    end
                    current_modifiers = table.concat(mods, ", ")
                end
            end
        end
    end

    return t1, t2, t3, t4, t5, detected_mode, detected_map, current_modifiers
end

-- [[ Khởi dựng văn bản code hoàn chỉnh ]]
local function getFullScriptText()
    local t1, t2, t3, t4, t5, detected_mode, detected_map, current_modifiers = fetchGameEnvironment()

    -- Ưu tiên chế độ được chọn thủ công trên UI nếu người chơi bấm đổi
    local finalMode = selectedMode or detected_mode

    local header = "--[[ CHIẾN THUẬT TỰ ĐỘNG ĐƯỢC TẠO BỞI RECORDER V5 ]]\n"
    header = header .. "_G.AutoStrat = true\n"
    header = header .. "_G.AutoSkip = true\n"
    header = header .. "_G.AutoPickups = true\n\n"
    header = header .. "local TDS = loadstring(game:HttpGet(\"https://raw.githubusercontent.com/DuxiiT/auto-strat/refs/heads/main/Library.lua\"))()\n\n"
    header = header .. string.format('TDS:Loadout("%s", "%s", "%s", "%s", "%s")\n', t1, t2, t3, t4, t5)
    header = header .. string.format('TDS:Mode("%s")\n', finalMode)
    header = header .. string.format('TDS:GameInfo("%s", {%s})\n\n', detected_map, current_modifiers)
    header = header .. "TDS:UnlockTimeScale()\n"
    header = header .. "TDS:TimeScale(2)\n\n"

    return header .. table.concat(recordedLines, "\n")
end

-- [[ Lắng nghe thư mục Workspace.Towers ]]
local towers_folder = workspace:WaitForChild("Towers", 15)

if towers_folder then
    -- Theo dõi khi tháp được ĐẶT xuống
    towers_folder.ChildAdded:Connect(function(tower)
        if not _G.record_strat then return end

        local replicator = tower:WaitForChild("TowerReplicator", 6)
        if not replicator then return end
        
        -- Xác thực quyền sở hữu tháp (Chỉ ghi tháp của bạn)
        local owner_id = replicator:GetAttribute("OwnerId")
        if owner_id and owner_id ~= LocalPlayer.UserId then return end
        
        tower_count = tower_count + 1
        local my_index = tower_count
        spawned_towers[tower] = my_index
        
        local tower_name = replicator:GetAttribute("Name") or tower.Name
        local raw_pos = replicator:GetAttribute("Position")
        
        local pos_x, pos_y, pos_z
        if typeof(raw_pos) == "Vector3" then
            pos_x, pos_y, pos_z = raw_pos.X, raw_pos.Y, raw_pos.Z
        else
            local pivot_pos = tower:GetPivot().Position
            pos_x, pos_y, pos_z = pivot_pos.X, pivot_pos.Y, pivot_pos.Z
        end
        
        local command = string.format('TDS:Place("%s", %.3f, %.3f, %.3f) -- %d', tower_name, pos_x, pos_y, pos_z, my_index)
        logAction(command)
        
        -- Theo dõi nâng cấp (Upgrade) của tháp này thông qua thay đổi Thuộc tính
        replicator:GetAttributeChangedSignal("Upgrade"):Connect(function()
            if not _G.record_strat then return end
            -- Lấy cấp nâng cấp mới nhất
            local upgrade_level = replicator:GetAttribute("Upgrade") or 1
            local command_up = string.format('TDS:Upgrade(%d) -- Lvl %s', my_index, tostring(upgrade_level))
            logAction(command_up)
        end)
    end)

    -- Theo dõi khi tháp bị BÁN (bị xóa khỏi workspace)
    towers_folder.ChildRemoved:Connect(function(tower)
        if not _G.record_strat then return end
        
        local my_index = spawned_towers[tower]
        if my_index then
            local command = string.format('TDS:Sell(%d)', my_index)
            logAction(command)
            spawned_towers[tower] = nil
        end
    end)
else
    addLogUI("⚠️ Cảnh báo: Không tìm thấy thư mục Towers trong Workspace!", false)
end

-- [[ Hook an toàn hỗ trợ các kỹ năng (Abilities) ]]
local ReplicatedStorageRF = ReplicatedStorage:WaitForChild("RF", 5)
if ReplicatedStorageRF then
    local oldInvokeServer
    oldInvokeServer = hookfunction(Instance.new("RemoteFunction").InvokeServer, function(self, ...)
        local args = { ... }
        if self == ReplicatedStorageRF and _G.record_strat then
            local action = args[1]
            if action == "Ability" then
                local towerInstance = args[2]
                local abilityName = args[3]
                local my_id = spawned_towers[towerInstance]
                if my_id then
                    local line = string.format('TDS:Ability(%d, "%s")', my_id, abilityName)
                    logAction(line)
                end
            end
        end
        return oldInvokeServer(self, unpack(args))
    end)
end

